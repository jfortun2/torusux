              "children": [],
              "expression": "// Two variable definitions\nconst conc1Index = OLI.random(0, 4);\nconst conc1array = [0.125, 0.325, 0.525, 0.725, 0.925];\nconst initialConc = conc1array[conc1Index] .toFixed(3);\nconst conc2Index = OLI.random(0,3);\nconst conc2array = [0.0150, 0.0450, 0.0750, 0.0950];\nconst finalConc = conc2array[conc2Index] .toFixed(4);\n\nconst time = OLI.random(71,79,0);\nconst timeMin = (time*60);\nconst invInitialConc = (1/initialConc);\nconst invFinalConc = (1/finalConc);\nconst step1 = ((0.000582*timeMin)+invInitialConc);\nconst step1Rnd = (step1) .toPrecision(5);\nconst correct1 = (1/step1);\nconst cor1Rnd = (correct1) .toPrecision(3);\nconst cor1Low = cor1Rnd*0.98;\nconst cor1High = cor1Rnd*1.02;\nconst subtractInvs = (invFinalConc-invInitialConc);\nconst cor2Min = (1718.213*subtractInvs) .toPrecision(5);\nconst correct2 = (cor2Min/60) .toPrecision(3);\nconst cor2Low = correct2*0.98;\nconst cor2High = correct2*1.02\n\n\n// Expose variables to OLI\nmodule.exports = {\n \n  initialConc,\n  finalConc,\n  time,\n  timeMin,\n  invInitialConc,\n  invFinalConc,\n  step1,\n  step1Rnd,\n  correct1,\n  cor1Rnd,\n  cor1Low,\n  cor1High,\n  subtractInvs,\n  cor2Min,\n  correct2,\n  cor2Low,\n  cor2High\n  \n};\n",
              "id": "de9fa498366749b6902836d1535c27f2",
              "name": "module",
              "type": "variable",
              "variable": "module"
            }
