            "type": "activity-reference"
          }
        ],
        "id": "2595125815",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "text": "When the rate-determining step is not the first step of a mechanism, we use the same principles—start with the rate-determining step and derive the rate law for each step from its molecularity—but the rate law for the mechanism requires a bit more work."
              }
            ],
            "id": "174q3gzll75dcg9",
            "type": "p"
          }
        ],
        "id": "1297224802",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
              0
            ]
          },
          "focus": {
            "offset": 0,
            "path": [
              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Consider the following reaction:"
                  }
                ],
                "id": "1olx8d9dno98ohn",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "5o57haio5mzaacx",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "lj02mcuyw0b6a4d",
                "legacyBlockRendered": "true",
                "src": "2\\;\\mathrm{NO}\\;+\\;{\\mathrm H}_2\\;\\;\\rightarrow\\;\\;{\\mathrm N}_2\\mathrm O\\;+\\;{\\mathrm H}_2\\mathrm O",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "and the proposed mechanism:"
                  }
                ],
                "id": "nuslcngdp9t534m",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "w92m2qxkcs0bo0k",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "q63cc1fbmfx3jd2",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{Step}\\;1:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;2\\;\\mathrm{NO}\\;\\;\\overset{k_1}{\\underset{k_{-1}}\\rightleftharpoons} \\;\\;{\\mathrm N}_2{\\mathrm O}_2\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;(\\mathrm{fast},\\;\\mathrm{reversible})\\\\\\mathrm{Step}\\;2:\\;\\;\\;\\;\\; {\\mathrm N}_2{\\mathrm O}_2\\;+\\;{\\mathrm H}_2\\;\\;\\xrightarrow{k_2}\\;\\;{\\mathrm N}_2\\mathrm O\\;+\\;{\\mathrm H}_2\\mathrm O\\;\\;\\;\\;\\;\\;\\;\\; (\\mathrm{slow})\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Determine whether this is a possible mechanism for the reaction."
                  }
                ],
                "id": "dtg1auxyoc2whaz",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "This is a possible mechanism if its steps sum up to the overall reaction "
                  },
                  {
                    "em": true,
                    "text": "and"
                  },
                  {
                    "text": " it gives the known rate law. The first requirement is readily confirmed. To determine whether the second requirement is met, we start with step 2, the rate-determining step. This is an elementary reaction, so we can derive its rate law from its molecularity:"
                  }
                ],
                "id": "6b1tcian7y8mz2j",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "mquogsgdv1hhntc",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "nqet2guwbldzs56",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Rate}\\;=\\;{\\mathrm{Rate}}_2\\;=\\;k_2\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\lbrack{\\mathrm H}_2\\rbrack",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "N"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " is an intermediate, so it cannot be included in the overall rate law. We use step 1 to determine [N"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "] in terms of other concentrations."
                  }
                ],
                "id": "5ias8qgzyemedcu",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Step 1 is reversible, so the rate of the forward reaction is equal to the rate of the reverse reaction:"
                  }
                ],
                "id": "0iq8x4xhg3mhmon",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "ckhxck2c7izsjmi",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "6egseas9ghho65u",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{c}{\\mathrm{Rate}}_1\\;=\\;\\;{\\mathrm{Rate}}_{-1}\\\\{\\mathrm{Rate}}_1\\;=\\;k_1{\\lbrack\\mathrm{NO}\\rbrack}^2\\;\\;\\;\\;\\;\\; \\mathrm{and}\\;\\;\\;\\;\\;{\\mathrm{Rate}}_{-1}\\;=\\;k_{-1}\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\\\\\mathit\\Rightarrow\\mathit\\;\\mathit\\; \\mathit\\;\\mathit\\;k_1{\\lbrack\\mathrm{NO}\\rbrack}^2\\;=\\;k_{-1}\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Solving for [N"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "]:"
                  }
                ],
                "id": "1evt8virfd613ct",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "axdeuhwfyk09bkk",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "kkz93klrg6mupfn",
                "legacyBlockRendered": "true",
                "src": "\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\;=\\;\\frac{k_1}{k_{-1}}{\\lbrack\\mathrm{NO}\\rbrack}^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Substituting [N"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "] into the rate law for the rate-determining step:"
                  }
                ],
                "id": "95n1x3vi217ahmd",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "8anbyxlg3f9ug7a",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "n7br74cderouwmu",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Rate}\\;=\\;k_2\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\lbrack{\\mathrm H}_2{\\rbrack\\;=\\;\\;k_2\\frac{k_1}{k_{-1}} {\\lbrack\\mathrm{NO}\\rbrack}^2\\lbrack{\\mathrm H}_2\\rbrack}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Combining the rate constants for the steps into a single rate constant gives the rate law for the mechanism:"
                  }
                ],
                "id": "tfxnfvliqzevo1a",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "9hvi7i5yqckpt48",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "aqulx1krlep438r",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Rate}\\;=\\;k\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\lbrack{\\mathrm H}_2\\rbrack",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "1163730006",
                "type": "p"
              }
            ],
