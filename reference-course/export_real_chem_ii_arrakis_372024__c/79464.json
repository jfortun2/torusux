                "src": "\\mathrm{Take}\\;\\ln\\;\\mathrm{of}\\;\\mathrm{both}\\;\\mathrm{sides}:\\;\\;\\;\\ln\\left(\\frac kA\\right)\\; =\\;\\ln\\left(e^\\frac{-E_\\mathrm{a}}{RT}\\right)\\;=\\;\\frac{-E_\\mathrm{a}}{RT}",
