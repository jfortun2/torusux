                "src": "k\\;=\\;Ae^\\frac{-E_\\mathrm{a}}{RT}\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;\\frac kA\\;=\\;e^\\frac{-E_\\mathrm{a}}{RT}",
