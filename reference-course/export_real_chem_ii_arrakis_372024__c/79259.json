          "children": [],
          "data": [
            {
              "children": [],
              "expression": "// Two variable definitions\nconst daysIndex = OLI.random(0,5);\nconst daysArray = [15,28,35,43,51,62];\nconst days = daysArray[daysIndex];\nconst expPart = (-1*0.03710*days) .toPrecision(5);\nconst ePart = Math.exp(expPart);\nconst massAtTime = (100*ePart) .toPrecision(3);\nconst perLow = massAtTime*0.98;\nconst perHigh = massAtTime*1.02;\nconst perIndex = OLI.random(0,5);\nconst perArray = [0.355,2.25,7.15,15.5,23.5,31.5];\nconst percent = perArray[perIndex];\nconst perDivHundred = (percent/100);\nconst logPercent = Math.log(perDivHundred);\nconst daysAnswer = (-26.954*logPercent) .toPrecision(3);\nconst daysLow = daysAnswer*0.98;\nconst daysHigh = daysAnswer*1.02;\n\n\n\n\n// Expose variables to OLI\nmodule.exports = {\n daysIndex,\n daysArray,\n days,\n expPart,\n ePart,\n massAtTime,\n perLow,\n perHigh,\n perIndex,\n perArray,\n percent,\n perDivHundred,\n logPercent,\n daysAnswer,\n daysLow,\n daysHigh,\n};\n",
