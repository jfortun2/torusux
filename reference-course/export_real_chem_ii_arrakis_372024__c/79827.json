              "children": [],
              "expression": "// Two variable definitions\nconst mm = 602.69;\nconst m = OLI.random(2.5,6.5,2);\n\nconst v = [100.0, 150.0, 200.0, 250.0, 300.0];\nconst c = OLI.random(0,4,0);\nconst vol = v[c];\nconst volL = (vol/1000) .toPrecision(3);\n\n\nconst mol = m/mm;\nconst molSol = (mol/volL) .toPrecision(3);\nconst mol_gd = 2*mol;\nconst molSolGd = (2*molSol) .toPrecision(3);\nconst mol_so4 = 3*mol;\nconst molSolSo4 = (3*molSol) .toPrecision(3);\n\nconst conc_gd = mol_gd/(vol/1000);\nconst conc_so4 = mol_so4/(vol/1000);\nconst ksp = (conc_gd**2*conc_so4**3) .toPrecision(3);\n\nconst ksp_low = 0.97*ksp;\nconst ksp_high = 1.03*ksp;\n\n// Expose variables to OLI\nmodule.exports = {\n  m, vol, volL, mol, molSol, mol_gd, molSolGd, conc_gd, mol_so4, molSolSo4, conc_so4, ksp, ksp_low, ksp_high\n};\n",
