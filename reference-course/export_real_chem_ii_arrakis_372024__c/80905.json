              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "64. Δ"
                      },
                      {
                        "em": true,
                        "text": "G"
                      },
                      {
                        "text": " is negative as the process is spontaneous. Δ"
                      },
                      {
                        "em": true,
                        "text": "H"
                      },
                      {
                        "text": " is positive as with the solution becoming cold, the dissolving must be endothermic. Δ"
                      },
                      {
                        "em": true,
                        "text": "S"
                      },
                      {
                        "text": " must be positive as this drives the process, and it is expected for the dissolution of any soluble ionic compound."
                      }
