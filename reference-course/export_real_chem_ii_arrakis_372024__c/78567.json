                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O]: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\lbrack{\\mathrm{NO}}_3\\rbrack\\;=\\frac{k_{1\\rightarrow}}{k_{1\\leftarrow}}\\lbrack\\mathrm{NO}\\rbrack\\lbrack{\\mathrm O}_2\\rbrack",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Substituting into the rate law for the rate-limiting step: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{rate}\\;=\\;k_2\\left(\\frac{k_{1\\rightarrow}}{k_{1\\leftarrow}}\\;\\lbrack\\mathrm{NO}\\rbrack\\lbrack{\\mathrm O}_2\\rbrack\\right)\\;\\lbrack\\mathrm{NO}\\rbrack\\;",
                    "subtype": "latex",
