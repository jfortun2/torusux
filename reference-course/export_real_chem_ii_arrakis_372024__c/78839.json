                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{c}\\mathrm{Average}\\;\\mathrm{rate}\\;\\mathrm{of}\\;\\mathrm{change}\\;\\mathrm{of}\\;\\lbrack\\mathrm X\\rbrack\\;=\\;\\frac{\\triangle\\lbrack \\mathrm X\\rbrack}{\\triangle t}\\;=\\;\\frac{{\\lbrack\\mathrm X\\rbrack}_{\\mathrm f}\\;-\\;{\\lbrack\\mathrm X\\rbrack}_{\\mathrm i}\\;}{t_{\\mathrm f}\\;\\;-\\; t_{\\mathrm i}}\\\\=\\;\\frac{0.546\\;\\mathrm M\\;-\\;0.619\\;\\mathrm M}{30.0\\;\\mathrm s\\;-\\;20.0\\;\\mathrm s}\\;=\\;-\\frac{0.073\\;\\mathrm M}{10.0\\;\\mathrm s}\\;= \\;-0.00073\\;\\frac{\\mathrm M}{\\mathrm s}\\end{array}",
