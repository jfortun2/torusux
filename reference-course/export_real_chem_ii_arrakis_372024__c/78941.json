                        "src": "\\mathrm{AgCl}(\\mathrm s)\\;\\rightleftharpoons\\;\\;\\mathrm{Ag}^+(\\mathrm{aq})\\;+\\;\\mathrm{Cl}^-(\\mathrm{aq})\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{sp}\\;=\\;1.77\\times10^{-10}\\\\Q_{sp}\\;=\\;\\lbrack\\mathrm{Ag}^+\\rbrack\\lbrack\\mathrm{Cl}^-\\rbrack\\\\Q_{sp}\\;=\\;(@@nacl@@\\;\\mathrm M)(@@agno3@@\\;\\mathrm M)\\;=\\;@@q@@\\;\\mathrm M\\\\Q\\;>\\;K\\;;\\;\\mathrm{therefore}\\;\\mathrm a\\;\\mathrm{precipitate}\\;\\mathrm{will}\\;\\mathrm{form}",
