              "children": [],
              "expression": "// Two variable definitions\nconst concIndex1 = OLI.random(1, 4);\nconst array1 = [0.10,0.15,0.20,0.25,0.30]\nconst concCS2 = array1[concIndex1] .toFixed(2);\nconst concIndex2 = OLI.random(1, 4);\nconst array2 = [0.35,0.40,0.45,0.50,0.55]\nconst concH2 = array2[concIndex2] .toFixed(2);\nconst H2to4 = (concH2*concH2*concH2*concH2);\nconst corSt1 = ((0.03*H2to4*concCS2)/0.0015);\nconst correct = Math.sqrt(corSt1) .toPrecision(2);\nconst corLow = correct*0.98;\nconst corHigh = correct*1.02;\n\n// Expose variables to OLI\nmodule.exports = {\n concIndex1,\n array1,\n concCS2,\n concH2,\n corSt1,\n correct,\n corLow,\n corHigh\n};\n",
