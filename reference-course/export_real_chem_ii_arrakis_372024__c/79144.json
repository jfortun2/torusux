          "children": [],
          "data": [
            {
              "children": [],
              "expression": "// Two variable definitions\nconst t = OLI.random(56, 95, 3);\nconst tempC = t .toPrecision(3);\nconst tempK = t + 273.25;\nconst temp = tempK .toPrecision(4);\nconst deltaG = 14.7 - tempK*0.0753;\nconst ans1 = deltaG .toPrecision(3);\nconst ans1low = 0.98*ans1;\nconst ans1high = 1.02*ans1;\nconst ratio = -deltaG/(0.008314*tempK);\nconst ans2 = Math.exp(ratio);\nconst ans2sf = ans2 .toPrecision(3);\nconst ans2low = 0.95*ans2;\nconst ans2high = 1.05*ans2;\n\n// Expose variables to OLI\nmodule.exports = {\n  t, tempC, tempK, temp, deltaG, ans1, ans1low, ans1high, ratio, ans2, ans2sf, ans2low, ans2high\n};\n",
