                "src": "x\\;=\\;\\sqrt[3]{\\frac{\\left(0.800\\right)^2\\left(5.73\\times10^{-8}\\right)}{\\left(0.400\\right)}}\\;=\\;0.00451\\;\\mathrm{atm}",
