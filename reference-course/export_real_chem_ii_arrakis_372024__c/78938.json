                        "src": "{\\mathrm{PbSO}}_4(\\mathrm s)\\;\\rightleftharpoons\\;\\;\\mathrm{Pb}^{2+}(\\mathrm{aq})\\;+\\;{\\mathrm{SO}}_4^{2-}(\\mathrm{aq})\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{sp}\\;=\\;6.30\\times10^{-7}\\\\Q_{sp}\\;=\\;\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\lbrack{\\mathrm{SO}}_4^{2-}\\rbrack\\\\Q_{sp}\\;=\\;(@@nacl@@\\;\\mathrm M)(@@agno3@@\\;\\mathrm M)\\;=\\;@@q@@\\;\\mathrm M\\\\Q\\;<\\;K\\;;\\;\\mathrm{therefore}\\;\\mathrm{no}\\;\\mathrm{precipitate}\\;\\mathrm{will}\\;\\mathrm{form}",
