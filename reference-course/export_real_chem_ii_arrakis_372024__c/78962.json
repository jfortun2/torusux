          "id": "yuuz5zvt2jnzn23",
          "legacyBlockRendered": "true",
          "src": "\\begin{array}{l}\\mathrm{Step}\\;1:\\;\\;\\;{\\mathrm{NO}}_2\\;+\\;{\\mathrm O}_3\\;\\;\\rightleftharpoons\\;\\;{\\mathrm{NO}}_3\\;+\\;{\\mathrm O}_2 \\;\\;\\;\\;(\\mathrm{fast},\\;\\mathrm{reversible})\\;\\\\\\mathrm{Step}\\;2:\\;\\;{\\mathrm{NO}}_3\\;+\\;{\\mathrm{NO}}_2\\;\\rightarrow\\;{\\mathrm N}_2 {\\mathrm O}_5\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;(\\mathrm{slow})\\end{array}",
