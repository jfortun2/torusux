                "id": "tld41u4h5dxo19z",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": " Step 2 is the rate-limiting step, with: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{rate}\\;=\\;k_2\\lbrack{\\mathrm{NO}}_3\\rbrack\\lbrack{\\mathrm{NO}}_2\\rbrack",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Since Step 1 is fast and reversible (i.e. equilibrium): "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "{\\mathrm{rate}}_{1\\rightarrow}\\;=\\;k_{1\\rightarrow}\\lbrack{\\mathrm{NO}}_2\\rbrack\\lbrack{\\mathrm O}_3\\rbrack\\;=\\;{\\mathrm{rate}}_{1\\leftarrow}\\;=\\;k_{1\\leftarrow}\\lbrack{\\mathrm{NO}}_3\\rbrack\\lbrack{\\mathrm O}_2\\rbrack\\;",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Solving this for the intermediate [NO"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "]: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\lbrack{\\mathrm{NO}}_3\\rbrack\\;=\\;\\frac{k_{1\\rightarrow}\\lbrack{\\mathrm{NO}}_2\\rbrack\\lbrack{\\mathrm O}_3\\rbrack}{k_{1\\leftarrow}\\lbrack{\\mathrm O}_2\\rbrack}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Substituting into the rate law for the rate-limiting step: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{rate}\\;=\\;k_2\\left(\\frac{k_{1\\rightarrow}\\lbrack{\\mathrm{NO}}_2\\rbrack\\lbrack{\\mathrm O}_3\\rbrack}{k_{1\\leftarrow}\\lbrack{\\mathrm O}_2\\rbrack}\\right)\\;\\lbrack{\\mathrm{NO}}_2\\rbrack\\;",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Combining "
                  },
                  {
                    "em": true,
                    "text": "k"
                  },
                  {
                    "text": " values and simplifying: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{rate}\\;=\\;k\\;\\frac{{\\lbrack{\\mathrm{NO}}_2\\rbrack}^2\\lbrack{\\mathrm O}_3\\rbrack}{\\lbrack{\\mathrm O}_2\\rbrack}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  }
