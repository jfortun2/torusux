          "data": [
            {
              "children": [],
              "expression": "// Two variable definitions\nconst T1 = OLI.random(285,295,0);\nconst T2 = OLI.random(315,335,0);\nconst k1 = OLI.random(0.035,0.085,3) .toFixed(3);\nconst k2 = OLI.random(0.125,0.185,3) .toFixed(3);\nconst top = (8.314*T1*T2) .toPrecision(3);\nconst bottom = (T1-T2) .toPrecision(3);\nconst calcTopBot = (top/bottom);\nconst kCalc = Math.log((k1/k2)) .toPrecision(3);\nconst corJoule = (calcTopBot*kCalc);\nconst correct = (corJoule/1000) .toPrecision(3);\nconst corLow = correct*0.98;\nconst corHigh = correct*1.02;\n\n\n// Expose variables to OLI\nmodule.exports = {\n T1,\n T2,\n k1,\n k2,\n top,\n bottom,\ncalcTopBot,\n kCalc,\n corJoule,\n correct,\n corLow,\n corHigh\n};\n",
              "id": "e4846c0604e548ca9a4fd7608aa8a013",
