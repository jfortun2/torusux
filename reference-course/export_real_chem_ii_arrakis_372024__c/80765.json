                ],
                "id": "971631532",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Tungsten is part of the third transition series and is a transition metal."
                  }
                ],
                "id": "1251931164",
                "type": "p"
              }
            ],
