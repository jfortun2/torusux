                "src": "2\\;{\\mathrm{SO}}_2(g)\\;+\\;{\\mathrm O}_2(g)\\;\\longrightarrow\\;2\\;{\\mathrm{SO}}_3(g)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "and the following information: "
                  }
