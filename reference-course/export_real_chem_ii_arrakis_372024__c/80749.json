                ],
                "id": "tjy7as1rr8e8crm",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta S^\\circ\\;=\\lbrack1\\cdot S^\\circ(\\mathrm C(s,\\mathrm{graphite}))\\;+\\;1\\cdot S^\\circ({\\mathrm{CO}}_2(g))\\rbrack\\;-\\;\\lbrack1\\cdot S^\\circ(\\mathrm{CO}(g))\\rbrack\\;\\\\\\;\\;\\;\\;\\;\\;\\;\\;=\\;\\lbrack1\\cdot(5.74\\;\\mathrm J/\\mathrm K)\\;+\\;1\\cdot(213.8\\;\\:\\mathrm J/\\mathrm K)\\rbrack\\;-\\;\\lbrack2\\cdot(197.7\\;\\mathrm J/\\mathrm K)\\rbrack\\;\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;-175.9\\;\\mathrm J/\\mathrm K\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Finally, we use Δ"
                  },
                  {
                    "em": true,
                    "text": "H"
                  },
                  {
                    "text": " and Δ"
                  },
                  {
                    "em": true,
                    "text": "S"
                  },
                  {
                    "text": " to solve for "
                  },
                  {
                    "em": true,
                    "text": "T"
                  },
                  {
                    "text": ":"
                  }
                ],
                "id": "r1ylizbfxdpwfkg",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "lyged80g2ky623m",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "z6nuj9rgrg9ouvb",
                "legacyBlockRendered": "true",
                "src": "T\\;=\\;\\frac{\\mathrm\\Delta H}{\\mathrm\\Delta S}\\;=\\;\\frac{-172.5\\;\\mathrm{kJ}}{-175.9\\;\\mathrm{kJ}/\\mathrm K}\\; =\\;981\\;\\mathrm K",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "This result indicates that the reaction is spontaneous at temperatures below 981 K. At temperatures above 981 K, the magnitude of the "
                  },
                  {
                    "em": true,
                    "text": "T"
                  },
                  {
                    "text": "Δ"
                  },
                  {
                    "em": true,
                    "text": "S"
                  },
                  {
                    "text": " will overcome the negative Δ"
                  },
                  {
                    "em": true,
                    "text": "H"
                  },
                  {
                    "text": " term, making Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": " positive and therefore the reaction nonspontaneous."
                  }
                ],
                "id": "x8tbm3fuaq4zbqi",
                "type": "p"
              }
