              "children": [],
              "expression": "// Two variable definitions\nconst pressno = [0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95];\nconst presso2 = [1.0, 1.1, 1.2, 1.3, 1.4, 1.5, 1.6, 1.7, 1.8, 1.9];\nconst pressno2 = [1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5, 6.0, 6.5, 7.0, 7.5, 8.0, 8.5, 9.0, 9.5];\n\nconst p1 = OLI.random(0,9);1\nconst p2 = OLI.random(0,9);\nconst p3 = OLI.random(0,16);\nconst pno = pressno[p1] .toPrecision(3); \nconst po2 = presso2[p2] .toPrecision(3); \nconst pno2 = pressno2[p3] .toPrecision(3);\n\n// Two variable definitions\nconst ratio = (pno2**2/((pno**2)*po2));\nconst ratiosf = ratio .toPrecision(3);\nconst term = (8.314*298/1000)*math.log(ratio);\nconst ans = -72.6 + term;\nconst anssf = ans .toPrecision(3);\nconst anslow = 0.99*ans;\nconst anshigh = 1.01*ans;\n\n// Expose variables to OLI\nmodule.exports = {\n  pno, po2, pno2, ratio, ratiosf, term, ans, anssf, anslow, anshigh\n};\n",
