                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm a}\\;=\\;\\frac{\\lbrack\\mathrm H^+\\rbrack\\lbrack{\\mathrm{NO}}_2^-\\rbrack}{\\lbrack{\\mathrm{HNO}}_2 \\rbrack}\\;=\\;\\frac{x\\cdot\\ x}{0.225-x}\\;=\\;4.00\\times10^{-4}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Assume "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " << initial [HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "]:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\frac{x^2}{0.225}\\;=4.00\\times10^{-4}\\;\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;x\\; =\\;\\sqrt{(0.225)(4.00\\times10^{-4})}\\;=\\;0.00949",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Because (0.00949/0.2255) × 100% = 4.22%, the assumption is valid."
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{pH}\\;=\\;-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;-\\log(x)\\;=\\;-\\log(0.00949)\\;=\\;2.023",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  }
                ],
