                        "legacyBlockRendered": true,
                        "src": "K_{\\mathrm b}\\;=\\frac{\\;\\lbrack\\mathrm{OH}^-\\rbrack\\lbrack\\mathrm{HClO}\\rbrack}{\\lbrack\\mathrm{ClO}^-\\rbrack}\\; =\\;\\frac{x^2}{0.111-x}\\;=\\;3.45\\times10^{-7}",
