                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm b(\\mathrm{ClO}^-)}\\;=\\;\\frac{K_{\\mathrm w}}{K_{\\mathrm a(\\mathrm{HClO})}}\\;=\\;\\frac{1.0\\times10^{-14}} {2.9\\times10^{-8}}\\;=\\;3.45\\times10^{-7}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm b}\\;=\\frac{\\;\\lbrack\\mathrm{OH}^-\\rbrack\\lbrack\\mathrm{HClO}\\rbrack}{\\lbrack\\mathrm{ClO}^-\\rbrack}\\; =\\;\\frac{x^2}{0.111-x}\\;=\\;3.45\\times10^{-7}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  }
                ],
                "id": "jazjw1nzbg3hd6v",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Assuming "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " is much less than 0.111:"
                  }
                ],
                "id": "s18hv6exfn2mgbb",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "x\\;=\\;\\sqrt{(0.111)(3.45\\times10^{-7})}\\;=\\;1.96\\times10^{-4}\\;\\mathrm M\\;=\\;\\lbrack\\mathrm{OH}^-\\rbrack",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{c}\\mathrm{pOH}\\:=\\;-\\log\\lbrack\\mathrm{OH}^-\\rbrack\\;=\\;-\\log(1.96\\times10^{-4})\\; =\\;3.707\\\\\\mathrm{pH}\\;=\\;14.00\\;-\\;\\mathrm{pOH}\\;=\\;14.00\\;-\\;3.707\\;=\\;10.29\\end{array}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  }
                ],
                "id": "5ybk6bazjjnivvw",
                "type": "p"
              }
