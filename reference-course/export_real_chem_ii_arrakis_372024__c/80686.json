  "title": "Occurrence, Preparation, and Properties of Transition Metals Module Checkpoint",
  "content": {
    "bibrefs": [],
    "model": [
      {
        "children": [
          {
            "children": [
              {
                "text": "For Questions 1 and 2, use the following method to enter electron configurations."
              }
            ],
            "id": "131899550",
            "type": "p"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Enter the noble gas core with brackets. For example, helium should be entered as: [He]"
                      }
                    ],
                    "id": "5238139",
                    "type": "p"
                  }
                ],
                "id": "2515385649",
                "type": "li"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "For superscripts, use the ^ symbol before the number. For example, 2"
                      },
                      {
                        "em": true,
                        "text": "s"
                      },
                      {
                        "sup": true,
                        "text": "2"
                      },
                      {
                        "text": " should be entered as: 2s^2"
                      }
                    ],
                    "id": "3791933732",
                    "type": "p"
                  }
                ],
                "id": "330338488",
                "type": "li"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Add a space between the noble gas core and between all sublevels. For example, [Ne]3"
                      },
                      {
                        "em": true,
                        "text": "s"
                      },
                      {
                        "sup": true,
                        "text": "2"
                      },
                      {
                        "text": "3"
                      },
                      {
                        "em": true,
                        "text": "p"
                      },
                      {
                        "sup": true,
                        "text": "4"
                      },
                      {
                        "text": " should be entered as: [Ne] 3s^2 3p^4"
                      }
                    ],
                    "id": "3886900701",
                    "type": "p"
                  }
                ],
                "id": "3042691416",
                "type": "li"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "Be sure to list the subshells in order of increasing energy (Aufbau order)."
                      }
                    ],
                    "id": "2234311724",
                    "type": "p"
                  }
                ],
                "id": "1114718400",
                "type": "li"
              }
            ],
            "id": "2013836850",
            "style": "disc",
            "type": "ul"
          },
