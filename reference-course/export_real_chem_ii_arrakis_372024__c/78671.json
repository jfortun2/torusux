                "id": "869298874",
                "src": "\\begin{array}{l}\\mathrm\\Delta S_{\\mathrm{rxn}}^o\\;=\\;\\left(1\\cdot S^{\\mathrm o}(\\mathrm{Zn}^{2+}(aq))\\;+\\;2\\cdot S^{\\mathrm o}(\\mathrm{Cl}^-(aq)\\right)\\;-\\;\\left(1\\cdot S^{\\mathrm o}({\\mathrm{ZnCl}}_2(s)\\right)\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;\\left(1(-112.1\\;\\mathrm J/\\mathrm K)\\;+\\;2(56.5\\;\\mathrm J/\\mathrm K)\\right)\\;-\\;\\left(1(111.5\\;\\mathrm J/\\mathrm K)\\right)\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;-110.6\\;\\mathrm J/\\mathrm K\\end{array}",
