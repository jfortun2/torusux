            }
          ],
          "id": "78rxfec093pi8z4",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "The pH at the equivalence point is 7. "
            }
          ],
          "id": "bt04qcyaekygty7",
          "type": "p"
        },
        {
          "children": [
            {
              "text": ""
            },
            {
              "children": [
