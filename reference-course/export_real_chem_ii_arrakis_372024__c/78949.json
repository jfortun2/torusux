    "stem": {
      "content": [
        {
          "children": [
            {
              "text": "Indicate whether each of the following statements is true of the titration curve for a strong acid–strong base titration, a weak acid–strong base titration, both types of titrations, or neither type of titration. "
            }
          ],
          "id": "2chvxf71oztg3d5",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "At the equivalence point, [H"
            },
            {
              "sub": true,
              "text": "3"
            },
            {
              "text": "O"
            },
            {
              "sup": true,
              "text": "+"
            },
            {
              "text": "] = [OH"
            },
            {
              "sup": true,
              "text": "−"
            },
            {
              "text": "]."
            }
          ],
          "id": "4tu7rzswhk9sw1e",
          "type": "p"
        },
        {
          "children": [
            {
              "text": ""
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "id": "first",
