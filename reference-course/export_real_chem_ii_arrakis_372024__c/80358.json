              "children": [],
              "expression": "// Two variable definitions\nconst initialAct = OLI.random(12.5,19.5,1) .toFixed(1);\nconst currentAct = OLI.random(1.50,3.89,2) .toFixed(2);\nconst ratioNtNo = currentAct/initialAct;\nconst logRatio = Math.log(ratioNtNo);\nconst age = -8264.5*logRatio;\nconst coeff = age/10000; \nconst coeffsf = coeff .toPrecision(3);\nconst corLow = age*0.97;\nconst corHigh = age*1.03\n\n// Expose variables to OLI\nmodule.exports = {\n  initialAct,\n  currentAct,\n  ratioNtNo,\n  logRatio,\n  age,\n  coeff,\n  coeffsf,\n  corLow,\n  corHigh\n};\n",
