              "expression": "// Two variable definitions\nconst D = OLI.random(1, 4.88, 2);\nconst E = OLI.random(-6, -2,0);\nconst DOH = (2*D) .toPrecision(3);\nconst OH = 2*D*10**E;\nconst pOH = (-Math.log10(OH)) .toFixed(3);\nconst pH = (14 - pOH) .toFixed(3);\nconst pHlow = 0.98*pH;\nconst pHhigh = 1.02*pH;\n\n// Expose variables to OLI\nmodule.exports = {\n  D,\n  E,\n  DOH,\n  OH,\n  pOH,\n  pH,\n  pHlow,\n  pHhigh\n};\n",
