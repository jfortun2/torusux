              "children": [],
              "expression": "// Two variable definitions\nconst D = OLI.random(2.2, 9.9,1);\nconst E = OLI.random(-13,-2,0);\nconst H = (D*10**E) .toPrecision(3);\nconst HansNum = ((1/D)*10) .toPrecision(2);\nconst HansExp = (-15-E) .toPrecision(1);\nconst pH = (-Math.log10(H)) .toFixed(2);\nconst pOH = (14-pH) .toFixed(2);\nconst OH = (10**-pOH) .toPrecision(3);\nconst pHlow = 0.98*pH;\nconst pHhigh = 1.02*pH;\nconst pOHlow = 0.98*pOH;\nconst pOHhigh = 1.02*pOH;\nconst OHlow = 0.95*OH;\nconst OHhigh = 1.05*OH;\n// Expose variables to OLI\nmodule.exports = {\n  D,\n  E,\n  H,\n  HansNum,\n  HansExp,\n  pH,\n  pOH,\n  OH,\n  pHlow,\n  pHhigh,\n  pOHlow,\n  pOHhigh,\n  OHlow,\n  OHhigh\n};\n",
