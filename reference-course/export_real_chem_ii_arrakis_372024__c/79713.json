              "expression": "const v = OLI.random(0.5,1.5,2) .toPrecision(2);\nconst ksp = 6.6e-9;\nconst c = OLI.random(0.4,0.8,3);\n\n// Equilibrium concentrations\nconst eq = (ksp/c) .toPrecision(3);\n\n// Calculate mass of solid that dissolves\nconst mol = (eq*v) .toPrecision(3);\nconst mass = (118.702*mol) .toPrecision(2);\nconst mass_low = 0.95*mass;\nconst mass_high = 1.05*mass;\n\n// Expose variables to OLI\nmodule.exports = {\n  v, c, eq, mol, mass, mass_low, mass_high\n};\n",
