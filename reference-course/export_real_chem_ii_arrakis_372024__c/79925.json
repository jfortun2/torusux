              "expression": "// Two variable definitions\n\nconst initial_conc = [0.100, 0.125, 0.150, 0.175, 0.2, 0.225, 0.250, 0.275, 0.3];\n\nconst count = OLI.random(0,8);\nconst conc = initial_conc[count] .toPrecision(3);\n\nconst d = OLI.random(1,9.99,2);\nconst dsf = d .toPrecision(3);\nconst e = OLI.random(-9, -5,0);\nconst kb = d*10**e;\nconst oh = Math.sqrt(conc*kb) .toPrecision(3);\nconst poh = -Math.log10(oh);\nconst pohsf = poh .toPrecision(3);\nconst ph = 14-poh;\nconst phsf = ph .toFixed(2);\nconst phlow = 0.98*ph;\nconst phhigh = 1.02*ph;\nconst check = oh*oh/(conc-oh);\nconst checksf = check .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\n  conc, d, dsf, e, kb, oh, poh, pohsf, ph, phsf, phlow, phhigh, checksf\n};\n",
