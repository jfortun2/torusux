    "stem": {
      "content": [
        {
          "children": [
            {
              "text": "The first reported nuclear fission occurred in 1939 from the bombardment of U-235 by three German scientists, Lise Meitner, Otto Hahn, and Fritz Strassman. Fill in the blanks below to describe this process."
            }
          ],
          "id": "2oahlupcfjlatej",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "U-235 was bombarded with "
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "id": "first",
              "input": "first",
              "type": "input_ref"
            },
            {
              "text": ". The potential final products of the fission reaction could be "
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "id": "second",
              "input": "second",
              "type": "input_ref"
            },
            {
              "text": ". The reaction also produces "
            },
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "id": "third",
              "input": "third",
              "type": "input_ref"
            },
            {
              "text": " energy compared to a chemical reaction. "
            }
          ],
          "id": "ahdlrto3bv501fg",
          "type": "p"
        }
