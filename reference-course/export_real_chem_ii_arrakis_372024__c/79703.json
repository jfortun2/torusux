                    ],
                    "legacyBlockRendered": true,
                    "src": "K_\\mathrm{b}\\;=\\;\\frac{\\lbrack{\\mathrm{CH}}_3\\mathrm{NH}_3^+\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack}{\\lbrack{\\mathrm{CH}}_3{\\mathrm{NH}}_2\\rbrack} \\;=\\;\\frac{\\;x(0.130\\;+\\;x)}{(0.125\\;-\\;x)}\\;=\\;4.4\\times10^{-4}",
