                    "text": " approximation:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\frac{x(0.130)}{(0.125)}\\;=\\;4.4\\times10^{-4}\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;x\\;=\\;\\frac{\\;(0.125)(4.4\\times10^{-4})}{(0.130)}\\; =\\;4.2\\times10^{-4}\\;\\mathrm M\\;=\\;\\lbrack\\mathrm{OH}^-\\rbrack",
