              "expression": "// Two variable definitions\nfunction numberOfZeros(n) {\n  var c = 0;\n  while (!~~n) {\n\tc++;\n\tn *= 10;\n  }\n  return c - 1;\n}\n\nconst conc = OLI.random(0.075, 0.425, 3) .toFixed(3);\nconst step1 = (conc*0.00000000022);\nconst calcX = Math.sqrt(step1);\nconst num = numberOfZeros(calcX);       \nconst exp = num +1; \nconst decX = calcX*10**(exp) .toPrecision(3);   \nconst decDisplay = decX .toPrecision(3);\nconst calcXLow = (calcX*0.98);\nconst calcXHigh = (calcX*1.02);\nconst validate = ((calcX/conc)*100) .toPrecision(3);\nconst validateLow = validate*0.98;\nconst validateHigh = validate*1.02;\n\n\n// Expose variables to OLI\nmodule.exports = {\n  conc,\n  step1,\n  calcX,\n  num,\n  decX,\n  decDisplay,\n  calcXLow,\n  calcXHigh,\n  validate,\n  validateLow,\n  validateHigh\n  \n  \n};\n",
