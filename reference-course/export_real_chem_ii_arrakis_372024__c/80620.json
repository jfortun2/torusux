  "id": "80620",
  "type": "Page",
  "tags": [],
  "title": "Unit Key Equations and Key Terms",
  "content": {
    "bibrefs": [],
    "model": [
      {
        "children": [
          {
            "children": [
              {
                "id": "zhcerygl5dimqrj",
                "text": "Key Equations"
              }
            ],
            "id": "1800461932",
            "type": "h1"
          },
          {
            "children": [
              {
                "text": "Coming Soon"
              }
            ],
            "id": "k69m3cw640zski6",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "bibm2tijb061bo9",
                "text": "Key Terms"
              }
            ],
            "id": "6tzz898hkueu3zh",
            "type": "h1"
          },
          {
            "children": [
              {
                "term": true,
                "text": "activated complex"
              },
              {
                "text": " A temporary unstable collection of atoms that exists briefly before products are formed during a chemical reaction."
              }
            ],
            "id": "688910542",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "activation barrier"
              },
              {
                "text": " The minimum amount of energy required for reactants to reach the transition state and proceed with the reaction."
              }
            ],
            "id": "4012379255",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "activation energy"
              },
              {
                "text": " The minimum energy molecules need to react; the height of the energy barrier to formation of products."
              }
            ],
            "id": "2735576513",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "adsorption"
              },
              {
                "text": " A process in which atoms, molecules, or ions of a liquid, gas, or dissolved solid adhere to a surface."
              }
            ],
            "id": "2160145868",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "bimolecular step"
              },
              {
                "text": " An elementary step involving two reactant species."
              }
            ],
            "id": "2491319893",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "bond energy"
              },
              {
                "text": " The energy required to break a specific covalent bond in one mole of gaseous molecules."
              }
            ],
            "id": "1496186089",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "catalysis"
              },
              {
                "text": " The increase in rate of a chemical reaction due to the addition of a catalyst."
              }
            ],
            "id": "1289074595",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "catalyst"
              },
              {
                "text": " A substance that increases the rate of a reaction without itself being consumed by the reaction."
              }
            ],
            "id": "3816351754",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "collision theory"
              },
              {
                "text": " A model describing how reactions take place at the molecular level that emphasizes the kinetic energy and orientation molecules have when they collide with each other and the rate at which the collisions take place."
              }
            ],
            "id": "2538950651",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "concentration"
              },
              {
                "text": " A quantitative measure of the relative amounts of solute and solvent present in a solution."
              }
            ],
            "id": "1957091315",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "diffusion"
              },
              {
                "text": " The movement of atoms or molecules from a region of relatively high concentration to one of relatively low concentration."
              }
            ],
            "id": "1152981659",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "dimerization reaction"
              },
              {
                "text": " The process of joining two identical or similar molecular entities by bonds."
              }
            ],
            "id": "3103053804",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "electron"
              },
              {
                "text": " A negatively charged subatomic particle."
              }
            ],
            "id": "4139612670",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "elementary step"
              },
              {
                "text": " One step in a series of simple reactions that show the progress of a reaction at the molecular level. Also called an "
              },
              {
                "em": true,
                "text": "elementary reaction"
              },
              {
                "text": "."
              }
            ],
            "id": "1288346504",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "frequency factor ("
              },
              {
                "em": true,
                "term": true,
                "text": "A"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " A proportionality constant in the Arrhenius equation related to the frequency of favorably oriented collisions."
              }
            ],
            "id": "1603880947",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "half-life of a reaction ("
              },
              {
                "em": true,
                "term": true,
                "text": "t"
              },
              {
                "sub": true,
                "term": true,
                "text": "1/2"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " Time required for the concentration or amount of a substance to reduce to half its initial value."
              }
            ],
            "id": "594399336",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "heterogeneous catalyst"
              },
              {
                "text": " A catalyst present in a different phase from the reactants, furnishing a surface at which a reaction can occur."
              }
            ],
            "id": "3993414916",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "homogeneous catalyst"
              },
              {
                "text": " A catalyst present in the same phase as the reactants."
              }
            ],
            "id": "193401057",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "initial rate"
              },
              {
                "text": " The instantaneous rate of a chemical reaction at "
              },
              {
                "em": true,
                "text": "t"
              },
              {
                "text": " = 0 s (immediately after the reaction has begun)."
              }
            ],
            "id": "2922837419",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "instantaneous rate"
              },
              {
                "text": " Rate of a chemical reaction at any instant in time, determined by the slope of the line tangential to a graph of concentration as a function of time."
              }
            ],
            "id": "2294768004",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "integrated rate law"
              },
              {
                "text": " Equation that relates the concentration of a reactant to the elapsed time of the reaction."
              }
            ],
            "id": "1338125794",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "intermediate"
              },
              {
                "text": " A species produced in one elementary step of a reaction and consumed in another step."
              }
            ],
            "id": "2061168676",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "inversely proportional"
              },
              {
                "text": " As one variable increases, another variable decreases at the same rate, and vice versa."
              }
            ],
            "id": "354357756",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "kinetic energy"
              },
              {
                "text": " Energy of a moving body, in joules, equal to 1/2 "
              },
              {
                "em": true,
                "text": "mv"
              },
              {
                "text": " (where "
              },
              {
                "em": true,
                "text": "m"
              },
              {
                "text": " = mass and "
              },
              {
                "em": true,
                "text": "v"
              },
              {
                "text": " = velocity)."
              }
            ],
            "id": "1049404938",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "method of initial rates"
              },
              {
                "text": " A common experimental approach to determine rate law expressions by measuring reaction rates when initial reactant concentrations are systematically varied."
              }
            ],
            "id": "1938402134",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "molecularity"
              },
              {
                "text": " The number of reactant species involved in an elementary step."
              }
            ],
            "id": "2607118064",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "phase"
              },
              {
                "text": " A distinct region of material with uniform chemical and physical properties."
              }
            ],
            "id": "1980690869",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "postulate"
              },
              {
                "text": " A hypothesis that is accepted as true for the purposes of following a particular line of reasoning."
              }
            ],
            "id": "2318104243",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "product"
              },
              {
                "text": " Substance formed by a chemical or physical change; shown on the right side of the arrow in a chemical equation."
              }
            ],
            "id": "3551103817",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "rate constant"
              },
              {
                "text": " A proportionality constant relating the rate of a chemical reaction at a given temperature to the concentration(s) of reactant(s)."
              }
            ],
            "id": "3244762987",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "rate law"
              },
              {
                "text": " A mathematical equation showing the dependence of reaction rate on the rate constant and the concentration of one or more reactants. Also called "
              },
              {
                "em": true,
                "text": "rate equation"
              },
              {
                "text": " or "
              },
              {
                "em": true,
                "text": "differential rate law"
              },
              {
                "text": "."
              }
            ],
            "id": "780627881",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "rate-determining step"
              },
              {
                "text": " The slowest elementary step in a reaction mechanism. Also "
              },
              {
                "em": true,
                "text": "called rate-limiting step"
              },
              {
                "text": "."
              }
            ],
            "id": "1518643316",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "reactant"
              },
              {
                "text": " Substance undergoing a chemical or physical change; shown on the left side of the arrow in a chemical equation."
              }
            ],
            "id": "3182660684",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "reaction mechanism"
              },
              {
                "text": " A sequence of elementary steps describing how a reaction occurs at a molecular level."
              }
            ],
            "id": "3259403691",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "reaction rate"
              },
              {
                "text": " Measure of the speed at which a chemical reaction takes place."
              }
            ],
            "id": "700330511",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "stoichiometry"
              },
              {
                "text": " Relationships between the amounts of reactants and products of a chemical reaction."
              }
            ],
            "id": "1219466506",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "system"
              },
              {
                "text": " The portion of matter undergoing a chemical or physical change being studied."
              }
            ],
            "id": "2154603644",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "termolecular step"
              },
              {
                "text": " An elementary step involving three reactant species."
              }
            ],
            "id": "2191367416",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "transition state"
              },
              {
                "text": " A specific, high-energy configuration of atoms at the peak of the energy barrier during a chemical reaction."
              }
            ],
            "id": "3114491126",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "unimolecular step"
              },
              {
                "text": " An elementary step involving a single reactant species."
              }
            ],
            "id": "1929145916",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "valence shell"
              },
              {
                "text": " The outermost shell of an atom."
              }
            ],
            "id": "749326467",
            "type": "p"
          },
          {
            "children": [
              {
                "text": ""
              }
            ],
            "id": "mxu7dtf5f8kafhx",
            "type": "p"
          }
