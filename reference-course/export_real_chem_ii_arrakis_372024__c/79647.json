              "expression": "// Two variable definitions\nconst concFe = OLI.random (2.2,8.9,1) .toFixed(2);\nconst concFeReal = (concFe/1000000) .toPrecision(3);\nconst concOHst1 = (0.0000000000000008/concFeReal) .toPrecision(3);\nconst concOH = (Math.sqrt(concOHst1)).toPrecision(3);\nconst concOHLow = concOH*0.95;\nconst concOHHigh = concOH*1.05;\n\n// Expose variables to OLI\nmodule.exports = {\n concFe,\n concFeReal,\n concOHst1,\n concOH,\n concOHLow,\n concOHHigh\n \n};\n",
