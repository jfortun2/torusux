                      }
                    ],
                    "id": "3960812272",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "For the reaction:"
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "3578834753",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "id": "2780804812",
                    "legacyBlockRendered": "true",
                    "src": "a\\mathrm A\\;+\\;b\\mathrm B\\;\\;\\longrightarrow\\;\\;c\\mathrm C\\;+\\:d\\mathrm D",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "994452646",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "the standard free energy change at 25 °C may be calculated as:"
                      }
                    ],
                    "id": "3679221525",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "1198713546",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "id": "2655260122",
                    "legacyBlockRendered": "true",
                    "src": "\\Delta G_{rxn}^{\\mathrm o}\\;=\\;\\sum n_{\\mathrm{products}}\\mathrm\\Delta G_f^{\\mathrm o}(\\mathrm{products})\\;-\\;\\sum n_{\\mathrm{reactants}}\\mathrm\\Delta G_f^{\\mathrm o}(\\mathrm{reactants})",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "891100002",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "In this equation, ∑ represents summation, "
                      },
                      {
                        "em": true,
                        "text": "n"
                      },
                      {
                        "text": " represents the stoichiometric coefficients in the balanced reaction equation, and Δ"
                      },
                      {
                        "em": true,
                        "text": "G"
                      },
                      {
                        "text": "°"
                      },
                      {
                        "sub": true,
                        "text": "f"
                      },
                      {
                        "text": " represents the standard free energies of formation."
                      }
                    ],
                    "id": "973760347",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "1926487605",
                    "type": "p"
                  }
                ],
                "type": "dd"
              }
            ],
            "title": [
              {
                "children": [
                  {
                    "text": " Calculating Free Energy "
                  }
                ],
                "id": "2094547083",
                "type": "p"
              }
            ],
            "type": "dl"
          },
          {
            "children": [
              {
                "id": "d74onicsbpa17h7",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "ykrmtu0ranmn11a",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/A3/A31F9808B584CB71B1FEA56DD0BCDE4E/green_line.png",
            "type": "img"
          },
          {
            "children": [
              {
                "text": ""
              }
            ],
            "id": "2003222749",
            "type": "p"
          }
        ],
        "id": "3663988253",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
