            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Ammonia and oxygen react according to:"
                  }
                ],
                "id": "vz91020pa3qxldk",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "ewaf8jsj6ealvfl",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "h2s6cbk9zm54uic",
                "legacyBlockRendered": "true",
                "src": "4\\;{\\mathrm{NH}}_3(g)\\;+\\;5\\;{\\mathrm O}_2(g)\\;\\;\\longrightarrow\\;\\;4\\;\\mathrm{NO}(g)\\;+\\;6\\;{\\mathrm H}_2\\mathrm O(g)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Calculate the standard free energy change, Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "sup": true,
                    "text": "o"
                  },
                  {
                    "text": ", for this reaction at 25 °C first using standard free energies of formation and then using standard enthalpies of formation and standard entropies. Is this reaction spontaneous or nonspontaneous under standard conditions? For what temperature conditions is this reaction spontaneous?"
                  }
                ],
                "id": "yrsamyifs7fuwqf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "The required data are available at "
                  },
                  {
                    "children": [
                      {
                        "text": "Standard Thermodynamic Properties for Selected Substances"
                      }
                    ],
                    "href": "https://cnx.org/contents/havxkyvS@9.525:2gdkQpYU@6/Standard-Thermodynamic-Propert",
                    "id": "845163383",
                    "linkType": "url",
                    "target": "self",
                    "type": "a"
                  },
                  {
                    "text": " and are shown below.  "
                  }
                ],
                "id": "4000794471",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Using standard free energies of formation: "
                  }
                ],
                "id": "6fuyqo5r3vgqal6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "dtxrao5zaz7jm6a",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "jftfl7qbwnu08ei",
                "legacyBlockRendered": "true",
                "src": "\\Delta G_{rxn}^{\\mathrm o}\\;=\\;\\sum n_{\\mathrm{products}}\\mathrm\\Delta G_f^{\\mathrm o}(\\mathrm{products})\\;-\\;\\sum n_{\\mathrm{reactants}}\\mathrm\\Delta G_f^{\\mathrm o}(\\mathrm{reactants})",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "4hs201g0yxyfx92",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "cvsitcqi65peau4",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta G^\\circ\\;=\\;\\lbrack4\\cdot\\mathrm\\Delta G_{\\mathrm f}^\\circ(\\mathrm{NO}(g))\\; +\\;{6\\cdot\\;}\\mathrm\\Delta G_{\\mathrm f}^\\circ(\\;{\\mathrm H}_2\\mathrm O(g))\\rbrack\\; -\\;\\lbrack4\\cdot\\mathrm\\Delta G_{\\mathrm f}^\\circ({\\mathrm{NH}}_3(g))\\; +\\;{5\\cdot\\;}\\mathrm\\Delta G_{\\mathrm f}^\\circ(\\;{\\mathrm O}_2(g)\\rbrack\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\; =\\;\\lbrack4\\cdot(87.6\\;\\mathrm{kJ})\\;+\\;6\\cdot(-228.6\\;\\mathrm{kJ})\\rbrack\\;-\\;\\lbrack4\\cdot(-16.5\\;\\mathrm{kJ})\\; +\\;5\\cdot(0\\;\\mathrm{kJ})\\rbrack\\;\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;(-1021.2\\;\\mathrm{kJ})\\;-\\;(-66.0\\;\\mathrm{kJ})\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\; =\\;-955.2\\;\\mathrm{kJ}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We use the standard enthalpies of formation to calculate the standard enthalpy change (Δ"
                  },
                  {
                    "em": true,
                    "text": "H"
                  },
                  {
                    "sup": true,
                    "text": "o"
                  },
                  {
                    "text": ") and the standard entropies to calculate the standard entropy change (Δ"
                  },
                  {
                    "em": true,
                    "text": "S"
                  },
                  {
                    "sup": true,
                    "text": "o"
                  },
                  {
                    "text": "):"
                  }
                ],
                "id": "fxwkb0vwyghgc0q",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "ost2ysj2l0a1pif",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "mqjzwije7z8bv58",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta H^\\circ\\;=\\;\\lbrack4\\cdot\\mathrm\\Delta H_{\\mathrm f}^\\circ(\\mathrm{NO}(g))\\; +\\;{6\\;\\cdot\\;}\\mathrm\\Delta H_{\\mathrm f}^\\circ(\\;{\\mathrm H}_2\\mathrm O(g))\\rbrack\\; -\\;\\lbrack4\\cdot\\mathrm\\Delta H_{\\mathrm f}^\\circ({\\mathrm{NH}}_3(g))\\;+\\;{5\\;\\cdot\\;}\\mathrm\\Delta H_{\\mathrm f}^\\circ(\\;{\\mathrm O}_2(g)\\rbrack\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\; =\\;\\lbrack4\\cdot(91.3\\;\\mathrm{kJ})\\;+\\;6\\cdot(-241.8\\;\\mathrm{kJ})\\rbrack\\;-\\;\\lbrack4\\cdot(-45.9\\;\\mathrm{kJ})\\; +\\;5\\cdot(0\\;\\mathrm{kJ})\\rbrack\\;\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;(-1085.6\\;\\mathrm{kJ})\\;-\\;(-183.6\\;\\mathrm{kJ})\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\; =\\;-902.6\\;\\mathrm{kJ}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "3l975szmv5bb8iy",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "6h0hhymnj1s7ege",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta S^\\circ\\;=\\;\\lbrack4\\cdot S^\\circ(\\mathrm{NO}(g))\\; +\\;{6\\;\\cdot\\;}S^\\circ(\\;{\\mathrm H}_2\\mathrm O(g))\\rbrack\\;-\\;\\lbrack4\\cdot S^\\circ({\\mathrm{NH}}_3(g))\\; +\\;{5\\;\\cdot\\;}S^\\circ(\\;{\\mathrm O}_2(g)\\rbrack\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;\\lbrack4\\cdot(210.8\\;\\mathrm J/\\mathrm K)\\; +\\;6\\cdot(188.8\\;\\mathrm J/\\mathrm K)\\rbrack\\;-\\;\\lbrack4\\cdot(192.8\\;\\mathrm J/\\mathrm K)\\; +\\;5\\cdot(205.2\\;\\mathrm J/\\mathrm K)\\rbrack\\;\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;(1976.0\\;\\mathrm J/\\mathrm K)\\; -\\;(1797.2\\;\\mathrm J/\\mathrm K)\\\\\\;\\;\\;\\;\\;\\;\\;\\;\\;=\\;178.8\\;\\mathrm J/\\mathrm K\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We then use the standard enthalpy and entropy changes to calculate the standard free energy change (Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "sup": true,
                    "text": "o"
                  },
                  {
                    "text": "):"
                  }
                ],
                "id": "n0qpwhmi8xn1ih4",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "asv12yfdn0lql1i",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "cvzpf8butp3qdgk",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta G^\\circ=\\mathrm\\Delta H^\\circ-T\\mathrm\\Delta S^\\circ\\end{array}=-902.6\\;\\mathrm{kJ}-(298.2\\;\\mathrm K)(0.1788\\;\\mathrm{kJ}/\\mathrm K)=-955.9\\;\\mathrm{kJ}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Note the close agreement in value between the two ways to calculate Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": "°."
                  }
                ],
                "id": "amfxucie7a6gg2p",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": "° is negative, so the reaction is spontaneous at 298 K. Because Δ"
                  },
                  {
                    "em": true,
                    "text": "H"
                  },
                  {
                    "text": "° is negative and Δ"
                  },
                  {
                    "em": true,
                    "text": "S"
                  },
                  {
                    "text": "° is positive, this reaction will be spontaneous at any temperature."
                  }
                ],
                "id": "jfqls5km2pn00qv",
                "type": "p"
              }
            ],
