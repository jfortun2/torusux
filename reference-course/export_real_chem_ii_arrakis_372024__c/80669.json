                ],
                "id": "bb068jgpgukr1u2",
                "rowstyle": "alternating",
                "type": "table"
              },
              {
                "children": [
                  {
                    "text": "We use the standard enthalpies of formation to calculate the standard enthalpy change:"
                  }
                ],
                "id": "o3g639xqz8rc5oj",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "i15qlwcgf370d8n",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "vvic3yphb52w3lx",
                "legacyBlockRendered": "true",
                "src": "\\Delta H_{rxn}^\\circ\\;=\\;\\sum n_{\\mathrm{products}}\\Delta H_f^\\circ(\\mathrm{products})\\;-\\;\\;\\sum n_{\\mathrm{reactants}}\\Delta H_f^\\circ(\\mathrm{reactants})",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "z4wfb5fwo9ligmp",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "egkivxfn892hdco",
                "legacyBlockRendered": "true",
                "src": "=\\;\\lbrack2\\left(0\\;\\mathrm{kJ}\\right)\\;+\\;3(-241.8\\;\\mathrm{kJ})\\rbrack\\;-\\;\\lbrack1(-824.2\\;\\mathrm{kJ})\\; +\\;3(0\\;\\mathrm{kJ})\\rbrack\\;=\\;98.8\\;\\mathrm{kJ}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We use the standard entropies to calculate the standard entropy change:"
                  }
                ],
                "id": "qpxl212ljq4cfwx",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "a0oq4sdgaacgej3",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "wipj6ixvas8mw1t",
                "legacyBlockRendered": "true",
                "src": "\\Delta S_{rxn}^\\circ\\;=\\;\\sum n_{\\mathrm{products}}S^\\circ(\\mathrm{products})\\;-\\;\\;\\sum n_{\\mathrm{reactants}}S^\\circ(\\mathrm{reactants})",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "qegklnxgwa2zdti",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "6ezoi5hqvzuor1p",
                "legacyBlockRendered": "true",
                "src": "=\\;\\lbrack2\\left(27.3\\;\\mathrm J/\\mathrm K\\right)\\;+\\;3(188.8\\;\\mathrm J/\\mathrm K)\\rbrack\\; -\\;\\lbrack1(87.4\\;\\mathrm J/\\mathrm K)\\;+\\;3(130.6\\;\\mathrm J/\\mathrm K)\\rbrack\\;=\\;141.8\\:\\mathrm J/\\mathrm K",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Finally, we use the standard enthalpy and entropy changes to calculate the standard free energy change:"
                  }
                ],
                "id": "0isr0gmtui0139u",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "twwuruui52avibk",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ow4blwlh1vl4720",
                "legacyBlockRendered": "true",
                "src": "\\mathrm\\Delta G_{rxn}^\\circ\\;=\\;\\mathrm\\Delta H_{rxn}^\\circ\\;-\\;T\\mathrm\\Delta S_{rxn}^\\circ",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "f335vx66hrlnqpy",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "f0h1cmhdnjqycr3",
                "legacyBlockRendered": "true",
                "src": "=\\;98.8\\;\\mathrm{kJ}\\;-\\;(298.2\\;\\mathrm K)\\left(141.8\\;\\frac{\\mathrm J}{\\mathrm K}\\right)\\left(\\frac{1\\; \\mathrm{kJ}}{1000\\;\\mathrm J}\\right)\\;=\\;56.5\\;\\mathrm{kJ}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": "° is positive, so the reaction is not spontaneous at this temperature."
                  }
                ],
                "id": "ffydstspw291eyx",
                "type": "p"
              }
            ],
