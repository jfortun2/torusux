              "children": [],
              "expression": "// Two variable definitions\nconst mass = OLI.random(0.03,0.08,5).toFixed(5);\nconst Index = OLI.random(0, 5);\nconst array = [115,125,145,155,175,185];\nconst time1 = array[Index];\nconst time = time1*1000;\nconst inverseTime = (-1/time);\nconst natLog = Math.log(mass);\nconst lambda = (inverseTime*natLog) .toPrecision(4);\nconst halfLife = (0.693/lambda) .toPrecision(3);\nconst corLow = halfLife*0.98;\nconst corHigh = halfLife*1.02;\n\n// Expose variables to OLI\nmodule.exports = {\n  mass,\n  Index,\n  array,\n  time1,\n  time,\n  inverseTime,\n  natLog,\n  lambda,\n  halfLife,\n  corLow,\n  corHigh\n  \n}\n",
