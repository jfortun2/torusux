                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm a}\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\lbrack\\mathrm{NO}_2^-\\rbrack}{\\lbrack{\\mathrm{HNO}}_2\\rbrack} \\;=\\;\\frac{x(0.030\\;+\\;x)}{(0.075\\;-\\;x)}\\;=\\;4.5\\times10^{-5}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Using the small "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " approximation:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "x\\;=\\;\\frac{(0.075)(4.5\\times10^{-5})}{(0.030)}\\;=\\;1.1\\times10^{-4}\\;\\mathrm M\\;=\\;\\lbrack{\\mathrm H}_3\\mathrm O^+ \\rbrack",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Then: pH = −log[H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "] = −log(1.1 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−4"
                  },
                  {
                    "text": ") = 3.96"
                  }
                ],
