              }
            ],
            "id": "2298026981",
            "type": "h1"
          },
          {
            "children": [
              {
                "text": "Coming soon"
              }
            ],
            "id": "9zteyvzrp3napjr",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "izax6nfro15lanh",
                "text": "Key Terms"
              }
            ],
            "id": "22yuoso2fqroy7b",
            "type": "h1"
          },
          {
            "children": [
              {
                "term": true,
                "text": "allotrope"
              },
              {
                "text": " Element that exists in the same physical state but in different forms because of differences in the way its atoms are bonded."
              }
            ],
            "id": "561866061",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "endergonic"
              },
              {
                "text": " A chemical process in which there is a net increase in free energy; Δ"
              },
              {
                "em": true,
                "text": "G"
              },
              {
                "text": " is positive and the process is nonspontaneous."
              }
            ],
            "id": "1571974292",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "enthalpy ("
              },
              {
                "em": true,
                "term": true,
                "text": "H"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " Thermodynamic quantity representing the total heat content of a system; the sum of the internal energy and the product of pressure and volume."
              }
            ],
            "id": "616516564",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "entropy ("
              },
              {
                "em": true,
                "term": true,
                "text": "S"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " A state function that describes the dispersal of matter and energy within a system, determined by the number of possible microstates; it quantifies the system's degree of randomness and distribution of energy."
              }
            ],
            "id": "1024434688",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "exergonic"
              },
              {
                "text": " A chemical process in which there is a net decrease in free energy; Δ"
              },
              {
                "em": true,
                "text": "G"
              },
              {
                "text": " is negative and the process is spontaneous."
              }
            ],
            "id": "4046869046",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "first law of thermodynamics"
              },
              {
                "text": " A formulation of the law of conservation of energy; the internal energy of a system changes due to heat flow in or out of the system and work done on or by the system."
              }
            ],
            "id": "1896107301",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "Gibbs free energy ("
              },
              {
                "em": true,
                "term": true,
                "text": "G"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " A thermodynamic property defined in terms of a system's enthalpy, entropy, and temperature; all spontaneous processes involve a decrease in "
              },
              {
                "em": true,
                "text": "G"
              },
              {
                "text": "."
              }
            ],
            "id": "3359147890",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "kinetic-molecular theory"
              },
              {
                "text": " A model that describes the macroscopic behavior of gasses in terms of the microscopic motions of the atoms and molecules that comprise the gas."
              }
            ],
            "id": "1763759235",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "microstate"
              },
              {
                "text": " A specific detailed configuration of a system's particles that corresponds to a particular distribution of energy, contributing to the system's overall entropy."
              }
            ],
            "id": "3945635234",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "nonspontaneous process"
              },
              {
                "text": " A process that does not occur naturally and requires a continuous input of energy from an external source to proceed."
              }
            ],
            "id": "3287764242",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "pressure-volume work"
              },
              {
                "text": " Work that occurs when a system pushes back the surroundings against a restraining pressure or when the surroundings compress the system."
              }
            ],
            "id": "966629160",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "second law of thermodynamics"
              },
              {
                "text": " All spontaneous processes result in an increase in the total entropy of the universe."
              }
            ],
            "id": "3179520791",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "spontaneous process"
              },
              {
                "text": " A process that occurs naturally without the need for continuous input of energy from an external source."
              }
            ],
            "id": "2597381691",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "standard free energy change (Δ"
              },
              {
                "em": true,
                "term": true,
                "text": "G"
              },
              {
                "term": true,
                "text": "°)"
              },
              {
                "text": " The change in free energy when one set of substances  is converted into another set of substances, with all substances in their standard states (1 bar pressure for gases, 1 M concentration for solutions)."
              }
            ],
            "id": "250096269",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "standard free energy of formation (Δ"
              },
              {
                "em": true,
                "term": true,
                "text": "G"
              },
              {
                "term": true,
                "text": "°"
              },
              {
                "sub": true,
                "term": true,
                "text": "f"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " Change in free energy accompanying the formation of one mole of substance from its elements in their standard states."
              }
            ],
            "id": "1836063102",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "surroundings"
              },
              {
                "text": " All matter other than the system being studied."
              }
            ],
            "id": "1975131842",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "thermochemistry"
              },
              {
                "text": " A branch of thermodynamics that studies the heat released or absorbed during chemical reactions."
              }
            ],
            "id": "2268111073",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "thermodynamics"
              },
              {
                "text": " The branch of science that deals with the relationships between heat, work, temperature, energy, and entropy."
              }
            ],
            "id": "535182507",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "third law of thermodynamics"
              },
              {
                "text": " The entropy of a perfect crystal at absolute zero (0 K) is zero."
              }
            ],
            "id": "mh3ms2fh6eyslmv",
            "type": "p"
          }
        ],
