      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Iron can form many coordination complexes and compounds, including [Fe(CN)"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "text": "]"
                  },
                  {
                    "sup": true,
                    "text": "3−"
                  },
                  {
                    "text": " and [Fe(H"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O)"
                  },
                  {
                    "sub": true,
                    "text": "6"
                  },
                  {
                    "text": "]SO"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "text": "."
                  }
                ],
                "id": "1090539567",
                "type": "p"
              }
            ],
            "editor": "slate",
            "id": "2604409724",
            "textDirection": "ltr",
            "type": "content"
          },
          {
            "activity_id": 80434,
            "children": [],
            "id": "3770868467",
            "type": "activity-reference"
          },
          {
            "activity_id": 79451,
            "children": [],
            "id": "925138488",
            "type": "activity-reference"
          }
        ],
        "id": "2512616946",
        "layout": "vertical",
        "purpose": "learnbydoing",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "[NiBr"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "text": "]"
                  },
                  {
                    "sup": true,
                    "text": "2−"
                  },
                  {
                    "text": " and [Ni(NH"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": ")"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "text": "(OH)"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "] are among the many coordination complexes involving the transition metal nickel."
                  }
                ],
                "id": "1992856031",
                "type": "p"
              }
            ],
            "editor": "slate",
            "id": "2232502987",
            "textDirection": "ltr",
            "type": "content"
          },
          {
            "activity_id": 80504,
