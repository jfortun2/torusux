          }
        ],
        "id": "2135061874",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "As mentioned previously, a system that is not at equilibrium will proceed in the direction that establishes equilibrium. Consider the following reaction as an example:"
                  }
                ],
                "id": "6209fd4x172kakr",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "fpr3p85y6vuo18k",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "19gwj9m8nouq47p",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{CO}(g)\\:+\\:{\\mathrm H}_2\\mathrm O(g)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm{CO}}_2(g)\\:+\\:{\\mathrm H}_2(g)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "When heated to a constant temperature, 800 °C, different starting mixtures of CO, H"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O, CO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ", and H"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " react to reach compositions corresponding to the same equilibrium (the value of "
                  },
                  {
                    "em": true,
                    "text": "Q"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " changes until it equals the value of "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": "). The following activity illustrates this concept."
                  }
                ],
                "id": "d8j9unodtxxk9vl",
                "type": "p"
              }
            ],
            "id": "94358695",
            "selection": {
