            "type": "activity-reference"
          },
          {
            "activity_id": 79559,
            "id": "2119378972",
            "type": "activity-reference"
          }
        ],
        "id": "697544838",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "id": "yyb9miuqmpc2i88",
                "text": "Evaluating "
              },
              {
                "em": true,
                "id": "v07gdmwvpsmk51u",
                "text": "K"
              },
              {
                "id": "7iy7hbeegh34xzb",
                "sub": true,
                "text": "c"
              },
              {
                "id": "ts893ko4k0aylnm",
                "text": " Given Concentration"
              }
            ],
            "id": "4zhv58l8m7cvqqu",
            "type": "h1"
          },
          {
            "children": [
              {
                "text": "Given reactant and product concentrations at equilibrium at a specific temperature, "
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "sub": true,
                "text": "c"
              },
              {
                "text": " can be calculated. Let's look at an example."
              }
            ],
            "id": "89pt5gd85dq4l8u",
            "type": "p"
          }
        ],
        "id": "389230720",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
              0
            ]
          },
          "focus": {
            "offset": 0,
            "path": [
              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Gaseous nitrogen dioxide forms dinitrogen tetroxide according to:"
                  }
                ],
                "id": "vwsno948kzd0h7q",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "6wf0pi8eq0ag0x7",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "0qov1vb9fem32b8",
                "legacyBlockRendered": "true",
                "src": "2\\;{\\mathrm{NO}}_2(g)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm N}_2{\\mathrm O}_4(g)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "When 0.10 mol NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " is added to an empty 1.0-L flask at 25 °C, the concentration changes so that at equilibrium [NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "] = 0.016 M and [N"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "text": "] = 0.042 M. What is the value of the equilibrium constant for the reaction?"
                  }
                ],
                "id": "i8b0d83tymzsk4m",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "At equilibrium:"
                  }
                ],
                "id": "r47kg0hzby6h1lh",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "5lz7awli0kp5a3b",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "m1jrml0bw5qq5tw",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{c}}=\\frac{\\left[{\\mathrm N}_2{\\mathrm O}_4\\right]}{\\left[{\\mathrm{NO}}_2\\right]^2}=\\frac{0.042}{{(0.016)}^2}=1.6\\times10^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The equilibrium constant "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " is 1.6 × 10"
                  },
                  {
                    "sup": true,
                    "text": "2"
                  },
                  {
                    "text": " at 25 °C."
                  }
                ],
                "id": "o7vyx0l1md5wnot",
                "type": "p"
              }
            ],
            "id": "1090755495",
            "selection": {
              "anchor": {
                "offset": 0,
                "path": [
                  0,
                  0
                ]
              },
              "focus": {
                "offset": 0,
                "path": [
                  1,
                  0
                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "2542583536",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "activity_id": 79343,
