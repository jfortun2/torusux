  "title": "Transition Metals and Coordination Chemistry Unit Checkpoint",
  "content": {
    "bibrefs": [],
    "model": [
      {
        "children": [
          {
            "children": [
              {
                "text": "For the first two questions:"
              }
            ],
            "id": "2008764934",
            "type": "p"
          },
          {
            "children": [
              {
                "text": "Use the following method to enter electron configurations in the Learning Activities below."
              }
            ],
            "id": "68ixb4nbyy7nwwx",
            "type": "p"
          },
          {
            "children": [
              {
                "text": "Enter the noble gas core with brackets. For example, helium should be entered as: [He]"
              }
            ],
            "id": "i3ppzttfyex8qfi",
            "type": "p"
          },
          {
            "children": [
              {
                "text": "For superscripts, use the ^ symbol before the number. For example, 2s2 should be entered as: 2s^2"
              }
            ],
            "id": "unykf7kp0xbhxdf",
            "type": "p"
          },
          {
            "children": [
              {
                "text": "Add a space between the noble gas core and between all sublevels. For example, [Ne]3s23p4 should be entered as: [Ne] 3s^2 3p^4"
              }
            ],
            "id": "93ie5u081lehdkr",
            "type": "p"
          },
          {
            "children": [
              {
                "text": "Be sure to list the subshells in order of increasing energy."
              }
            ],
            "id": "ubzv3fhjklbm7yf",
            "type": "p"
          }
        ],
        "editor": "slate",
