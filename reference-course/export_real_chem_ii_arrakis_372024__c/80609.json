              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Calculation of "
                  },
                  {
                    "em": true,
                    "strong": true,
                    "text": "K"
                  },
                  {
                    "strong": true,
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "strong": true,
                    "text": " from Equilibrium Concentrations"
                  }
                ],
                "id": "srequh0th3zxy0u",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "We began the unit with an informal discussion of how the mineral fluorite is formed. Fluorite, CaF"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ", is a slightly soluble solid that dissolves according to the equation:"
                  }
                ],
                "id": "n1t5jvoblny19pa",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "kc8z8zwib3d018f",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "nsezng9eqsreo8y",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{CaF}}_2(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Ca}^{2+}(aq)\\;+\\;2\\;\\mathrm F^-(aq)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The concentration of Ca"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": " in a saturated solution of CaF"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " is 2.15 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–4"
                  },
                  {
                    "text": " M. Therefore, that of F"
                  },
                  {
                    "sup": true,
                    "text": "–"
                  },
                  {
                    "text": " is 4.30 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–4"
                  },
                  {
                    "text": " M (that is, twice the concentration of Ca"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": "). What is the solubility product of fluorite?"
                  }
                ],
                "id": "2wcge9t6e5kgq30",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "First, we write the "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": " expression based on the dissolution equation:"
                  }
                ],
                "id": "vmkkqzbmywsfjci",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "xwaly75yxmh5uoq",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "prkmcnrdf4y5aat",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ca}^{2+}\\rbrack\\lbrack\\mathrm F^-\\rbrack^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Then, we substitute in concentrations and solve for "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": ":"
                  }
                ],
                "id": "xw2uf9f2ad99p4j",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "l4jzdrbo10stjnb",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "4tgeqv2xl5bnhy1",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{sp}}\\;=\\;(2.15\\times10^{-4})(4.30\\times10^{-4})^2\\;=\\;3.98\\times10^{-11}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "2416921159",
                "type": "p"
              }
            ],
            "id": "1090413388",
            "selection": {
              "anchor": {
                "offset": 0,
                "path": [
                  0,
                  0
                ]
              },
              "focus": {
                "offset": 0,
                "path": [
                  1,
                  0
                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "58610102",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "activity_id": 79313,
            "id": "1025119840",
            "type": "activity-reference"
          },
          {
            "activity_id": 79981,
            "id": "3891311147",
            "type": "activity-reference"
          }
        ],
        "id": "737559010",
        "layout": "vertical",
        "purpose": "learnbydoing",
        "type": "group"
      },
      {
        "children": [
          {
            "activity_id": 80181,
            "id": "2609214638",
            "type": "activity-reference"
          }
        ],
        "id": "3689676502",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "text": "Also, as with other equilibrium problems, we can calculate an unknown concentration of a species given the equilibrium constant and concentration(s) of other species at equilibrium."
              }
            ],
            "id": "8tmn7b8f8r8rn2y",
            "type": "p"
          }
        ],
        "id": "950050037",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
              0
            ]
          },
          "focus": {
            "offset": 0,
            "path": [
              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "A solution contains PbBr("
                  },
                  {
                    "em": true,
                    "text": "s"
                  },
                  {
                    "text": "), Pb"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": "("
                  },
                  {
                    "em": true,
                    "text": "aq"
                  },
                  {
                    "text": "), and Br"
                  },
                  {
                    "sup": true,
                    "text": "−"
                  },
                  {
                    "text": "("
                  },
                  {
                    "em": true,
                    "text": "aq"
                  },
                  {
                    "text": ") at equilibrium. If [Br"
                  },
                  {
                    "sup": true,
                    "text": "−"
                  },
                  {
                    "text": "] = 2.5 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−2"
                  },
                  {
                    "text": " M, what is [Pb"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": "]? "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": " PbBr = 4.6 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−6"
                  },
                  {
                    "text": "."
                  }
                ],
                "id": "zzgn5x755tx6yqr",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "The equation for the equilibrium between solid lead(II) bromide, lead(II) ion, and bromide ion is:"
                  }
                ],
                "id": "7l19s2v3i9so9tn",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "7pt0hleyuo4pxy6",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "68etalt56gw76af",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{PbBr}}_2(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Pb}^{2+}(aq)\\;+\\;2\\;\\mathrm{Br}^-(aq)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The result is an equilibrium expression of:"
                  }
                ],
                "id": "clqs7oacfwrounf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "n3ihznbg4jp3926",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "t0qu2psgnzr6qar",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\lbrack\\mathrm{Br}^-\\rbrack^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Given that "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": " = 4.6 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−6"
                  },
                  {
                    "text": " and [Br"
                  },
                  {
                    "sup": true,
                    "text": "−"
                  },
                  {
                    "text": "] = 2.5 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−2"
                  },
                  {
                    "text": " M, we can substitute these values into the equilibrium expression and solve for [Pb"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": "]:"
                  }
                ],
                "id": "2a2q6f0xs60b59t",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "xav6mb1ocvk1nas",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "uhvep06pthtzx52",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\lbrack\\mathrm{Br}^-\\rbrack^2\\\\4.6\\times10^{-6}\\; =\\;\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\;(2.5\\times10^{-2}\\;\\mathrm M)^2\\\\\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\; =\\;\\frac{4.6\\times10^{-6}}{6.25\\times10^{-4}}\\;=\\;7.4\\times10^{-3}\\;\\mathrm M\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "231909908",
                "type": "p"
              }
            ],
