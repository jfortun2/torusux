                  }
                ],
                "id": "gqm5vp0jx5xnujj",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{Ca}}_5({\\mathrm{PO}}_4)_3\\mathrm{OH}(s)\\;\\;\\rightleftharpoons\\;\\;5\\;\\mathrm{Ca}^{2+}(aq)\\;+\\;3\\;{\\mathrm{PO}}_4^{3-}(aq)\\;+\\;\\mathrm{OH}^-(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ca}^{2+}\\rbrack^5\\;\\lbrack{\\mathrm{PO}}_4^{3-}\\rbrack^3\\;\\lbrack\\mathrm{OH}^-\\rbrack",
