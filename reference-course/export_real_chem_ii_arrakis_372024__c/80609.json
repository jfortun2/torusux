                    "text": ")"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "OH, the mineral apatite, a source of phosphate for fertilizers: "
                  }
                ],
                "id": "gikaopsa4jlr0wq",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "1izcrpcvgat6nyo",
                    "text": " ",
