      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Write the ionic equation for the dissolution and the solubility product expression for each of the following slightly soluble ionic compounds:"
                  }
                ],
                "id": "dhzqfzrk2a24uto",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": " CaCO"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": ", calcium carbonate, the active ingredient in many over-the-counter chewable antacids:"
                  }
                ],
                "id": "ks89t6co89usmhm",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "yztke8g9cetqwsr",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "q4nce0ye0g3ytcv",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{CaCO}}_3(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Ca}^{2+}(aq)\\;+\\;{\\mathrm{CO}}_3^{2-}(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ca}^{2+}\\rbrack\\lbrack{\\mathrm{CO}}_3^{2-}\\rbrack",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": " Mg(OH)"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ", magnesium hydroxide, the active ingredient in milk of magnesia:"
                  }
                ],
                "id": "2q9k3qs330vnzoq",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "agap984nztl8bst",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "4ptnndzph6sqifv",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Mg}(\\mathrm{OH})_2(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Mg}^{2+}(aq)\\;+\\;2\\;\\mathrm{OH}^-(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Mg}^{2+}\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": " Ca"
                  },
                  {
                    "sub": true,
                    "text": "5"
                  },
