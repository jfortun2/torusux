                    "src": "\\begin{array}{c}\\mathrm{average}\\;\\mathrm{rate}\\;\\mathrm{of}\\;\\mathrm{change}\\;\\mathrm{of}\\;\\lbrack\\mathrm A\\rbrack\\;=\\;\\frac{\\triangle\\lbrack \\mathrm A\\rbrack}{\\triangle t}\\;=\\;\\frac{{\\lbrack\\mathrm A\\rbrack}_{\\mathrm f}\\;-\\;{\\lbrack\\mathrm A\\rbrack}_{\\mathrm i}\\;}{t_{\\mathrm f}\\;\\;-\\; t_{\\mathrm i}}\\\\=\\;\\frac{0.625\\;\\mathrm M\\;-\\;1.000\\;\\mathrm M}{10.0\\;\\mathrm s\\;-\\;0.0\\;\\mathrm s}\\;=\\;-\\frac{0.375\\;\\mathrm M}{10.0\\;\\mathrm s}\\; =\\;-0.0375\\;\\frac{\\mathrm M}{\\mathrm s}\\end{array}",
