          "hints": [
            {
              "content": [
                {
                  "children": [
                    {
                      "text": "HClO, a weak acid, dissociates to form H"
                    },
                    {
                      "sub": true,
                      "text": "3"
                    },
                    {
                      "text": "O"
                    },
                    {
                      "sup": true,
                      "text": "+"
                    },
                    {
                      "text": " and ClO"
                    },
                    {
                      "sup": true,
                      "text": "–"
                    },
                    {
                      "text": " according the reaction: "
                    },
                    {
                      "children": [
                        {
                          "text": " ",
                          "type": "text"
                        }
                      ],
                      "legacyBlockRendered": true,
                      "src": "\\mathrm{HClO}(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm H}_3\\mathrm O^+(aq)\\;+\\;\\mathrm{ClO}^-(aq)",
                      "subtype": "latex",
                      "type": "formula_inline"
                    },
                    {
                      "text": "Use an ICE table to determine relative equilibrium concentrations of the HClO, H"
                    },
                    {
                      "sub": true,
                      "text": "3"
                    },
                    {
                      "text": "O"
                    },
                    {
                      "sup": true,
                      "text": "+"
                    },
                    {
                      "text": " and ClO"
                    },
                    {
                      "sup": true,
                      "text": "–"
                    },
                    {
                      "text": ". Then use the "
                    },
                    {
                      "em": true,
                      "text": "K"
                    },
                    {
                      "sub": true,
                      "text": "a"
                    },
                    {
                      "text": " expression to determine [H"
                    },
                    {
                      "sub": true,
                      "text": "3"
                    },
                    {
                      "text": "O"
                    },
                    {
                      "sup": true,
                      "text": "+"
                    },
                    {
                      "text": "]"
                    },
                    {
                      "sub": true,
                      "text": "eq"
                    },
                    {
                      "text": ". "
                    }
                  ],
