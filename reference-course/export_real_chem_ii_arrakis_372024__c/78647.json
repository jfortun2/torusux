              {
                "children": [
                  {
                    "text": "Assuming "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " << 0.250."
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm a}\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\lbrack\\mathrm{ClO}^-\\rbrack}{\\lbrack\\mathrm{HClO} \\rbrack}\\;=\\;\\frac{x^2}{0.250-x}\\;\\cong\\;\\frac{x^2}{0.250}\\;=\\;2.9\\times10^{-8}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "x\\;=\\;\\sqrt{(0.250)(2.9\\times10^{-8})}\\;=\\;8.51\\times10^{-5}\\;\\mathrm M\\;=\\;\\lbrack{\\mathrm H}_3\\mathrm O^+",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{pH}\\;=\\;-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;-\\log(8.51\\times10^{-5})\\;=\\;4.070",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  }
                ],
