                  },
                  {
                    "children": [
                      {
                        "id": "9n8gb1f48plvm9b",
                        "text": "0.500"
                      }
                    ],
                    "id": "x40pqwnhs0lvina",
                    "type": "td"
                  }
                ],
                "id": "86815vo8posclle",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "bbec8t2i17fgibc",
                        "text": "12.00"
                      }
                    ],
                    "id": "awg2rmqen8yftmq",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "ja1hw9y2g8xa09v",
                        "text": "0.250"
                      }
                    ],
                    "id": "pnyrcc6cbdso54k",
                    "type": "td"
                  }
                ],
                "id": "8ax66xzlqrmmc9t",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "2mxx5vzyh0bruz2",
