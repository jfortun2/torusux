  "title": "The Half-Life",
  "content": {
    "bibrefs": [],
    "model": [
      {
        "children": [
          {
            "children": [
              {
                "id": "zgzt182w0lqm9en",
                "text": "Half-Life of First-Order Reactions"
              }
            ],
            "id": "nf6vh7he248nfhp",
            "type": "h1"
          },
          {
            "children": [
              {
                "text": "The "
              },
              {
                "children": [
                  {
                    "text": "half-life of a reaction ("
                  },
                  {
                    "em": true,
                    "text": "t"
                  },
                  {
                    "sub": true,
                    "text": "1/2"
                  },
                  {
                    "text": ")"
                  }
                ],
                "content": [
                  {
                    "children": [
                      {
                        "text": "Time required for the concentration or amount of a substance to reduce to half its initial value."
                      }
                    ],
                    "id": "3655028301",
                    "type": "p"
                  }
                ],
                "id": "2218981393",
                "trigger": "hover",
                "type": "popup"
              },
              {
                "text": " is the time required for one-half of a given amount of reactant to be consumed. In each succeeding half-life, half of the remaining concentration of the reactant is consumed. Let's use the decomposition of hydrogen peroxide (H"
              },
              {
                "sub": true,
                "text": "2"
              },
              {
                "text": "O"
              },
              {
                "sub": true,
                "text": "2"
              },
              {
                "text": ") as an example, as seen in the data table below."
              }
            ],
            "id": "jl77um3kkd048be",
            "type": "p"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "fh1h59r30xzzcpe",
                        "text": "Time (h)"
                      }
                    ],
                    "id": "az1p8i3o66njl54",
                    "type": "th"
                  },
                  {
                    "children": [
                      {
                        "id": "gcy3mkalmnv0fji",
                        "text": "[H"
                      },
                      {
                        "id": "yz2n20nyeqguzzh",
                        "sub": true,
                        "text": "2"
                      },
                      {
                        "id": "vcd0fza7dtpzvt2",
                        "text": "O"
                      },
                      {
                        "id": "e0dmtjx0cd692qp",
                        "sub": true,
                        "text": "2"
                      },
                      {
                        "id": "i71tsl5ank5gxcx",
                        "text": "] (M)"
                      }
                    ],
                    "id": "vfcfl4t3ma6bcle",
                    "type": "th"
                  }
                ],
                "id": "5ube8wx21ed411v",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "se244atj1g3max1",
                        "text": "0"
                      }
                    ],
                    "id": "k9x6obmfi4qf2y2",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "htdcsyzh4b9iuii",
                        "text": "1.000"
                      }
                    ],
                    "id": "zjcpljypvtjn8wf",
