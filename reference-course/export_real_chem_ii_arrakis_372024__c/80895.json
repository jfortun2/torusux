              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "0nt8wujm0yu1lyi",
                        "text": "24.00"
                      }
                    ],
                    "id": "inxjldslxcqeejy",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "uz3pneuff13rns0",
                        "text": "0.0625"
                      }
                    ],
                    "id": "ytf3m4k5rrii52a",
