          "explanation": {
            "content": [
              {
                "children": [
                  {
                    "text": "There are four Cl"
                  },
                  {
                    "sup": true,
                    "text": "−"
                  },
                  {
                    "text": " (chloro) ligands, which are named as "
                  },
                  {
