              },
              {
                "children": [
                  {
                    "text": "We then substitute the equilibrium concentrations into the solubility product expression and solve for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": ":"
                  }
                ],
                "id": "dwad2ueb3vl89hq",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "naff8pvcg7hvxun",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "mehpoqw6ry8r7uh",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ca}^{2+}\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack^2\\;=\\;(x)(2x)^2\\;=\\;1.3\\times10^{-6}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "356q3la3kasmkmo",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "i296qzna0d09ppd",
                "legacyBlockRendered": "true",
                "src": "(x)(4x^2)\\;=\\;4x^3\\;=\\;1.3\\times10^{-6}\\;\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;x\\; =\\;\\sqrt[3]{\\frac{1.3\\times10^{-6}}4}\\;=\\;6.9\\times10^{-3}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Since "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " represents the concentration of Ca(OH)"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " that dissolves, the molar solubility of Ca(OH)"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " is 6.9 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–3"
                  },
                  {
                    "text": " M."
                  }
                ],
                "id": "sbf92z5ahegz19r",
                "type": "p"
              }
