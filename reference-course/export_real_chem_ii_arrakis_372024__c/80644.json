                    "text": " "
                  }
                ],
                "id": "vuy5zjbs9ei7nhc",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "The "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": " for calcium hydroxide, Ca(OH)"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ", is 1.3 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–6"
                  },
                  {
                    "text": ". Calculate the molar solubility of calcium hydroxide."
                  }
                ],
                "id": "y6k6jymo0xnpa75",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "As before, we first determine the dissolution reaction and the solubility product expression:"
                  }
                ],
                "id": "9tguwu5tsknkrwf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "75ucqwa4ts14pwt",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "xro67l2s63rso48",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Ca}(\\mathrm{OH})_2(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Ca}^{2+}(aq)\\;+\\;2\\;\\mathrm{OH}^-(aq) \\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ca}^{2+}\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We next set up an ICE table to determine the relative concentrations of the species present at equilibrium. "
                  }
                ],
                "id": "lvj9l98i3kknqe1",
                "type": "p"
              },
              {
