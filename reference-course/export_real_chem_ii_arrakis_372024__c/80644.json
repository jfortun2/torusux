                            "text": "x"
                          }
                        ],
                        "id": "ia908oinfqv6eef",
                        "type": "td"
                      },
                      {
                        "align": "center",
                        "children": [
                          {
                            "id": "7u3irm2d0xigtnm",
                            "text": "+"
                          },
                          {
                            "em": true,
                            "id": "ygtaqdzmcv8y471",
                            "text": "x"
                          }
                        ],
                        "id": "btt9egqyugdopzw",
