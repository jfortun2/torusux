                      }
                    ],
                    "id": "7f30slptfwgqzxs",
                    "type": "tr"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "id": "322xjkdtsdsc7lq",
                            "text": "Equilibrium"
                          }
                        ],
                        "id": "fyfng51okug1mgh",
                        "type": "td"
                      },
                      {
                        "align": "center",
                        "children": [
                          {
                            "em": true,
                            "id": "w81txhtcrnsrs91",
                            "text": "excess"
                          }
                        ],
                        "id": "7605r27u63crx0u",
                        "type": "td"
                      },
                      {
                        "align": "center",
                        "children": [
                          {
                            "em": true,
                            "id": "3si4o7d9n5ijfiz",
                            "text": "x"
                          },
                          {
                            "id": "oqd59p6bp1zmcsy",
                            "text": " M"
                          }
                        ],
                        "id": "p626syu02rehcqz",
                        "type": "td"
                      },
                      {
                        "align": "center",
                        "children": [
                          {
                            "em": true,
                            "id": "rdc7fanmobziuv1",
                            "text": "x"
                          },
                          {
                            "id": "jtdjxxaj5x2biff",
                            "text": " M"
                          }
                        ],
                        "id": "68wmz0ys5041vf3",
                        "type": "td"
                      }
                    ],
                    "id": "2z3ptwgxdh8cn6c",
                    "type": "tr"
                  }
                ],
                "id": "2hqwf4rwky7wxpw",
                "rowstyle": "alternating",
                "type": "table"
              },
              {
                "children": [
                  {
                    "text": "We then substitute the equilibrium concentrations (in terms of "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": ") into the solubility product expression and solve for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": ": "
                  }
                ],
                "id": "1zsdllj67y5kcv9",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "est8ublehbur0tb",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "lchwzip3t30pw16",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Cu}^+\\rbrack\\lbrack\\mathrm{Br}^-\\rbrack\\;=\\;(x)(x)\\;=\\;x^2\\;=\\;6.3\\times10^{-9}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "dd1kobizpnlt281",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "vlicqvmekj3jm89",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{solving}\\;\\;\\Rightarrow\\;\\;\\;\\;x\\;=\\;\\sqrt{(6.3\\times10^{-9})}\\;\\;=\\;7.9\\times10^{-5}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Finally, we note that "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " represents the concentration of CuBr("
                  },
                  {
                    "em": true,
                    "text": "s"
                  },
                  {
                    "text": ") that dissolves, so the molar solubility of CuBr is 7.9 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–5"
                  },
                  {
                    "text": " M."
                  }
                ],
                "id": "zb9z6ztbh6w5oqo",
                "type": "p"
              }
