              "content": [
                {
                  "children": [
                    {
                      "text": "The basicity of the anions in a series of acids will be the opposite of the acidity in their oxyacids."
                    }
                  ],
                  "id": "1hloasx1nuc0qhu",
                  "type": "p"
                }
              ],
              "id": "2482150162"
            },
            {
              "content": [
                {
                  "children": [
                    {
                      "text": "Consider the electronegativities of Cl, Br, and I."
                    }
                  ],
                  "id": "7u3owm39dp9iyuh",
                  "type": "p"
                }
              ],
              "id": "4060970499"
