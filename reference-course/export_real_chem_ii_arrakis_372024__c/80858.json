            },
            "type": "content"
          }
        ],
        "id": "4062328706",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "For each of the following nuclear equations:"
                  }
                ],
                "id": "vasv1xc8wtgnla2",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Use the dropdown menu to identify the indicated (boxed) particle being emitted."
                          }
                        ],
                        "id": "4047212340",
                        "type": "p"
                      }
                    ],
                    "id": "04vz7o42i2e5caf",
                    "type": "li"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Enter the values of A and Z for the unknown nuclide ("
                          },
                          {
                            "children": [
                              {
                                "text": ""
                              }
                            ],
                            "legacyBlockRendered": false,
                            "src": "{}_{\\mathrm Z}^{\\mathrm A}\\mathrm X",
                            "subtype": "latex",
                            "type": "formula_inline"
                          },
                          {
                            "text": ")."
                          }
                        ],
                        "id": "3400750937",
                        "type": "p"
                      }
                    ],
                    "id": "w5n8agektx5gw9s",
                    "type": "li"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Identify the element symbol to replace the X for the unknown nuclide ("
                          },
                          {
                            "children": [
                              {
                                "text": ""
                              }
                            ],
                            "legacyBlockRendered": false,
                            "src": "{}_{\\mathrm Z}^{\\mathrm A}\\mathrm X",
                            "subtype": "latex",
                            "type": "formula_inline"
                          },
                          {
                            "text": ")."
                          }
                        ],
                        "id": "155078976",
                        "type": "p"
                      }
                    ],
                    "id": "7cwcee5sg8li1qz",
                    "type": "li"
                  }
                ],
                "id": "09qbinq329t1jp2",
                "type": "ol"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "551393682",
                "type": "p"
              }
