              {
                "children": [
                  {
                    "id": "c8nrnv9jtrlauxm",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "0jfs7qr7echlp98",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{reduction}:\\;\\;\\;2\\;\\mathrm{Cu}^+(aq)\\;+\\;2\\;\\mathrm e^-\\;\\rightarrow\\; 2\\;\\mathrm{Cu}(s)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\mathrm E^\\circ\\; =\\;+0.52\\;\\mathrm V\\\\\\underline{\\mathrm{oxidation}:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; \\mathrm{Ni}(s)\\;\\rightarrow\\;\\mathrm{Ni}^{2+}(aq)\\;+\\;2\\mathrm e^-\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\mathrm E^\\circ\\; =\\;+0.28\\;\\mathrm V}\\\\\\mathrm{overall}:\\;\\;\\;\\;\\;\\;\\;\\;2\\;\\mathrm{Cu}^+(\\mathrm{aq})\\; +\\;\\mathrm{Ni}(s)\\;\\rightarrow\\;2\\;\\mathrm{Cu}(\\mathrm s)\\;+\\;\\mathrm{Ni}^{2+}(aq\\mathit)\\;\\;\\;\\;\\;\\; \\mathrm E^\\circ\\;=\\;+0.80\\;\\mathrm V\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The same result is obtained using "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
