            {
              "text": "At a particular temperature, lead(II) fluoride, PbF"
            },
            {
              "sub": true,
              "text": "2"
            },
            {
              "text": ", has a "
            },
            {
              "em": true,
              "text": "K"
            },
            {
              "em": true,
              "sub": true,
              "text": "sp"
            },
            {
              "text": " = @@d@@×10"
            },
            {
              "sup": true,
              "text": "@@e@@"
