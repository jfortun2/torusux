              "children": [],
              "expression": "const d = OLI.random(1,9.99,2) .toPrecision(3);\nconst e = OLI.random(-10,-7);\nconst ksp = (d*10**e) .toPrecision(3);\nconst xStep1 = (ksp/4) .toPrecision(3);\nconst x = ((ksp/4)**(1/3)) .toPrecision(3);\nconst f = (2*x) .toPrecision(3);\nconst low = 0.95*f;\nconst high = 1.05*f;\n\n// Expose variables to OLI\nmodule.exports = {\n  d, e, ksp, xStep1, x, f, low, high\n};\n",
              "id": "a7cfdb16f2624da0b272e44a17d8ab21",
