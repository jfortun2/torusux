              "expression": "const vols = [750, 800, 850, 900, 950, 1000, 1050, 1100, 1150, 1200, 1250, 1300, 1350, 1400, 1450, 1500]\nconst v = OLI.randomArrayItem(vols);\n// const v1 = OLI.random(1,15,0);\n// const v = v1*100; // vl in mL\n// const c1 = OLI.random(10,90,1) .toPrecision(3);\n// const c = c1/100;\n\nconst conc = [.100, .150, .200, .250, .300, .350, .400, 0.450, 0.500, 0.550, 0.6, 0.65, 0.7, 0.75, 0.8, 0.95, 0.9, 0.95];\nconst c = OLI.randomArrayItem(conc) .toPrecision(3);\nconst ksp = 1.12e-12;\n\n// solubility in pure water\nconst sol_water = ((ksp/4)**(1/3)) .toPrecision(3);\nconst sol1_low = 0.99*sol_water;\nconst sol1_high = 1.01*sol_water;\n\n// solubility in chromate ion solution\nconst sol_chromate = ((ksp/4/c)**.5) .toPrecision(3);\nconst sol2_low = 0.99*sol_chromate;\nconst sol2_high = 1.01*sol_chromate;\n\n// Expose variables to OLI\nmodule.exports = {\n  v, c, sol_water, sol_chromate, sol1_low, sol1_high, sol2_low, sol2_high\n};\n",
