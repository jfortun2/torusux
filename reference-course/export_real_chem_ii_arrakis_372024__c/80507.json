                  }
                ],
                "id": "7hncelhj4ff57vy",
                "rowstyle": "alternating",
                "type": "table"
              },
              {
                "children": [
                  {
                    "text": "Determine in which direction the reaction proceeds to reach equilibrium in each of the two experiments."
                  }
                ],
                "id": "ba14715i2y8tnme",
                "type": "p"
              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Experiment 1"
                  }
                ],
                "id": "qpnnxoyi6lny1jn",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "j0zskxsygm5i80t",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "6o66yhme5k2n646",
                "legacyBlockRendered": "true",
                "src": "Q_\\mathrm{c}=\\frac{\\left[{\\mathrm{CO}}_2\\right]\\left[{\\mathrm H}_2\\right]}{\\left[\\mathrm{CO}\\right]\\left[{\\mathrm H}_2\\mathrm O \\right]}=\\frac{\\left(0.0040\\right)\\left(0.0040\\right)}{\\left(0.0203\\right)\\left(0.0203\\right)}=0.039",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "em": true,
                    "text": "Q"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " = 0.039, which is less than "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " (0.64). Because "
                  },
                  {
                    "em": true,
                    "text": "Q"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " < "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": ", the reaction will shift to the right."
                  }
                ],
                "id": "kjmrouec427qrfx",
                "type": "p"
              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Experiment 2"
                  }
                ],
                "id": "z969ol0kjlqzv2y",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "gjv8ww3kk55zz64",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "wcpiqm4l44z8t9l",
                "legacyBlockRendered": "true",
                "src": "Q_\\mathrm{c}=\\frac{\\left[{\\mathrm{CO}}_2\\right]\\left[{\\mathrm H}_2\\right]}{\\left[\\mathrm{CO}\\right]\\left[{\\mathrm H}_2\\mathrm O \\right]}=\\frac{\\left(0.037\\right)\\left(0.046\\right)}{\\left(0.011\\right)\\left(0.0011\\right)}=1.4\\times10^2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "em": true,
                    "text": "Q"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " = 140, which is greater than "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " (0.64). Because "
                  },
                  {
                    "em": true,
                    "text": "Q"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": " > "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "c"
                  },
                  {
                    "text": ", the reaction will shift to the left."
                  }
                ],
                "id": "asu3ik4gr473oqq",
                "type": "p"
              }
