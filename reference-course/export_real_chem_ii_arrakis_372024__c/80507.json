                "src": "\\mathrm{CO}(g)\\;+\\;{\\mathrm H}_2\\mathrm O(g)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm{CO}}_2(g)\\;+\\;\\;{\\mathrm H}_2(g) \\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_{\\mathrm c}=0.64",
