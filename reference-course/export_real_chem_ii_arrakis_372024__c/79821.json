              "children": [],
              "expression": "// Two variable definitions\nconst amps = OLI.random(3.5,15.5,1) .toFixed(1);\nconst time = OLI.random(1,5,0);\nconst timeSec = (time*3600);\nconst Q = (amps*timeSec);\nconst correct = (Q/96485) .toPrecision(3);\nconst corLow = (correct*0.98);\nconst corHigh = (correct*1.02)\n\n// Expose variables to OLI\nmodule.exports = {\n  amps,\n  time,\n  timeSec,\n  Q,\n  correct,\n  corLow,\n  corHigh\n};\n",
