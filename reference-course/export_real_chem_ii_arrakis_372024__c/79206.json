          "id": "fc3071104bda4043b6a0c92c83e37c42",
          "type": "p"
        },
        {
          "children": [
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "legacyBlockRendered": true,
              "src": "{\\mathrm H}_2(g)\\;+\\;{\\mathrm I}_2(g)\\;\\rightarrow\\;2\\;\\mathrm{HI}(g)",
              "subtype": "latex",
              "type": "formula_inline"
            }
          ],
          "id": "h6da3p1tskq28qi",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "The following mechanism has been proposed for this reaction. "
            }
          ],
          "id": "0xn4vic8u7b8qcw",
          "type": "p"
        },
        {
          "children": [
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "legacyBlockRendered": true,
              "src": "{\\mathrm I}_2(g)\\;\\rightleftharpoons\\;2\\;\\mathrm I(g)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;(\\mathrm{fast},\\;\\mathrm{reversible})\\;\\;\\\\{\\mathrm H}_2(\\mathrm g)\\;+\\;2\\;\\mathrm I(g)\\;\\rightarrow\\;2\\;\\mathrm{HI}(g)\\;\\;\\;(\\mathrm{slow})",
              "subtype": "latex",
              "type": "formula_inline"
            }
          ],
          "id": "jol28f183eyp3x8",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Determine the rate law for this proposed mechanism."
