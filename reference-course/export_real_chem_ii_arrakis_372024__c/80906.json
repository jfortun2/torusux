              }
            ],
            "id": "y48kj194tx0xstz",
            "rowstyle": "alternating",
            "type": "table"
          },
          {
            "children": [
              {
                "text": "We then substitute the equilibrium concentrations into the acid-ionization constant expression for HA:"
              }
            ],
            "id": "ivbgcb69zwnhmq9",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "sjr2wd9m2jzjsyx",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "8m8hgi9ylok4j4a",
            "legacyBlockRendered": "true",
            "src": " K_{\\mathrm a}\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\lbrack\\mathrm A^-\\rbrack}{\\lbrack\\mathrm{HA}\\rbrack}\\; =\\;\\frac{x\\left({\\lbrack\\mathrm{HA}\\rbrack}_i+x\\right)}{\\left({\\lbrack\\mathrm A^-\\rbrack}_i-x\\right)}",
            "subtype": "latex",
            "type": "formula"
          },
          {
            "children": [
              {
                "text": "If the small "
              },
              {
                "em": true,
                "text": "x"
              },
              {
                "text": " approximation is valid, this simplifies to:"
              }
            ],
            "id": "qgdexfz95bjct1u",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "zc8vdx81v2hyqrj",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "d01ywj7jxje43g2",
            "legacyBlockRendered": "true",
            "src": "K_{\\mathrm a}\\;=\\;\\frac{x\\left({\\lbrack\\mathrm A^-\\rbrack}_i\\right)}{\\left({\\lbrack\\mathrm{HA}\\rbrack}_i\\right)}",
            "subtype": "latex",
            "type": "formula"
          },
          {
            "children": [
              {
                "text": "Rearranging this to solve for [H"
              },
              {
                "sub": true,
                "text": "3"
              },
              {
                "text": "O"
              },
              {
                "sup": true,
                "text": "+"
              },
              {
                "text": "], we get:"
              }
            ],
            "id": "4uru9g0uvcbmv8j",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "f8880vtk3f8fg1f",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "lsxe7gwggph0sko",
            "legacyBlockRendered": "true",
            "src": "x\\;=\\;\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;K_{\\mathrm a}\\times\\frac{{\\lbrack\\mathrm{HA}\\rbrack}_{\\mathrm i}} {{\\lbrack\\mathrm A^-\\rbrack}_{\\mathrm i}}",
            "subtype": "latex",
            "type": "formula"
          },
          {
            "children": [
              {
                "text": "Taking the negative logarithm of both sides of this equation gives:"
              }
            ],
            "id": "8ays4a5nwo32a7a",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "rmsfm62bmotw9w5",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "x5fcuuxv3w4k94w",
            "legacyBlockRendered": "true",
            "src": "-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;-\\log K_{\\mathrm a}\\mathit\\;-\\;\\;\\log\\frac{{\\lbrack\\mathrm{HA}\\rbrack}_ {\\mathrm i}}{{\\lbrack\\mathrm A^-\\rbrack}_{\\mathrm i}}",
            "subtype": "latex",
            "type": "formula"
          },
          {
            "children": [
              {
                "text": "Recognizing that pH = −log[H"
              },
              {
                "sub": true,
                "text": "3"
              },
              {
                "sup": true,
                "text": "+"
              },
              {
                "text": "] and p"
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "sub": true,
                "text": "a"
              },
              {
                "text": " = −log"
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "sub": true,
                "text": "a"
              },
              {
                "text": ", and dropping the subscript indicating initial concentrations, we arrive at the Henderson-Hasselbalch equation:"
              }
            ],
            "id": "vsxz63qs9d7xcb1",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "0mk8per96qmw4os",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "zqkgg9g9upgdby9",
            "legacyBlockRendered": "true",
            "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathrm a}\\;+\\;\\log\\frac{\\lbrack\\mathrm A^-\\rbrack}{\\lbrack\\mathrm{HA}\\rbrack}",
            "subtype": "latex",
            "type": "formula"
          },
          {
            "children": [
              {
                "id": "00zcrrb1xeflerg",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "6n2qjk23mamfjbc",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/A3/A31F9808B584CB71B1FEA56DD0BCDE4E/green_line.png",
            "type": "img"
          },
          {
            "children": [
              {
                "id": "aaxxz2hosaidvcm",
                "text": ""
              }
            ],
            "id": "xzx8hjzfj05xu9t",
            "items": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "991828924",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "The approximate pH of a buffer solution is given by the equation:"
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "1500192377",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": "true",
                    "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathrm a}\\;+\\;\\log\\frac{\\lbrack\\mathrm A^-\\rbrack}{\\lbrack\\mathrm{HA}\\rbrack}",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "4016170209",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "This equation relates the pH, the ionization constant of a weak acid, and the concentrations of the weak acid and its conjugate base in a buffer solution."
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "4203351037",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": "It is important to emphasize that this equation applies only to buffers and is valid only when the small "
                      },
                      {
                        "em": true,
                        "text": "x"
                      },
                      {
                        "text": " approximation is valid. In general, the Henderson-Hasselbalch equation gives good results for weak acids when the concentrations of HA and A"
                      },
                      {
                        "sup": true,
                        "text": "−"
                      },
                      {
                        "text": " are at least 1000 times larger than the "
                      },
                      {
                        "em": true,
                        "text": "K"
                      },
                      {
                        "sub": true,
                        "text": "a"
                      },
                      {
                        "text": " value for HA."
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "3299142935",
                    "type": "p"
                  }
                ],
                "type": "dd"
              }
            ],
            "title": [
              {
                "children": [
                  {
                    "text": "The Henderson-Hasselbalch Equation "
                  }
                ],
                "id": "1199911540",
                "type": "p"
              }
            ],
            "type": "dl"
          },
          {
            "children": [
              {
                "id": "nqkkjowl6aqp9ns",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "dpjdwjn8lauf5gw",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/A3/A31F9808B584CB71B1FEA56DD0BCDE4E/green_line.png",
            "type": "img"
          },
          {
            "children": [
              {
                "text": "The following example is the same as on the previous page, but now we use the Henderson-Hasselbalch equation to solve it."
              }
            ],
            "id": "ivuslooee9031c4",
            "type": "p"
          }
        ],
        "id": "1189931630",
