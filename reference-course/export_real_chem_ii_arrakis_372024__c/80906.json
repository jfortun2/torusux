                      },
                      {
                        "id": "i9e88z6vrc4n7wl",
                        "sup": true,
                        "text": "−"
                      },
                      {
                        "id": "5mxz2shvyvb0eou",
                        "text": "]"
                      },
                      {
                        "em": true,
                        "id": "hmhgoyqobt5o663",
                        "sub": true,
                        "text": "i"
                      },
                      {
                        "id": "gv6vwwguavoesrb",
                        "text": " + "
                      },
                      {
                        "em": true,
                        "id": "pahtyzvg3cxqquo",
                        "text": "x"
                      }
                    ],
                    "id": "ybh0w75zndmoqt8",
                    "type": "td"
                  },
                  {
                    "align": "center",
                    "children": [
                      {
                        "em": true,
                        "id": "sr3kifplngr1uq9",
                        "text": "x"
                      }
                    ],
                    "id": "duoso9be0rb9fuh",
