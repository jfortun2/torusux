      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Calculate the pH of buffer comprised of 0.25 M acetic acid and 0.15 M sodium acetate."
                  }
                ],
                "id": "le21kzdytas6asp",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Acetic acid and acetate ion (from the sodium acetate) in the buffer are in equilibrium according to:"
                  }
                ],
                "id": "afng4q6p33elbtn",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "xbcne3cog9o4otk",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ruha4dvhr7y5tjy",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{HC}}_2{\\mathrm H}_3{\\mathrm O}_2(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm H}_3\\mathrm O^+(aq) \\;+\\;{\\mathrm C}_2{\\mathrm H}_3\\mathrm O_2^-(aq)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "7zi3o8sn5803i71",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "uvk4dy0dkko7cde",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm a}\\;=\\frac{\\;\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\lbrack{\\mathrm C}_2{\\mathrm H}_3\\mathrm O_2^-\\rbrack}{\\lbrack {\\mathrm{HC}}_2{\\mathrm H}_3{\\mathrm O}_2\\rbrack}\\;=\\;1.8\\times10^{-5}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We use the Henderson-Hasselbalch equation to determine the pH:"
                  }
                ],
                "id": "arzlub114a8uvpu",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "5h914wajg2o473a",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "3me2ikd4saxuces",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathrm a}\\;+\\;\\log\\frac{\\lbrack{\\mathrm C}_2{\\mathrm H}_3{\\mathrm O}_2^-\\rbrack}{\\lbrack{\\mathrm{HC} }_2{\\mathrm H}_3{\\mathrm O}_2\\rbrack}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Remember that p"
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "a"
                  },
                  {
                    "text": " = −log "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "a"
                  },
                  {
                    "text": ":"
                  }
                ],
                "id": "scb5moej0ee6821",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "tgavdvry2io7l4z",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "1n9sb6kfb46lxtf",
                "legacyBlockRendered": "true",
                "src": "\\mathrm pK_{\\mathrm a}\\;=\\;-\\log K_{\\mathrm a}\\;=\\;-\\log(1.8\\times10^{-5})\\;=\\;4.745",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Substitute the p"
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "a"
                  },
                  {
                    "text": " value and the given concentrations into the equation and calculate pH:"
                  }
                ],
                "id": "1x85khupxkhj7o2",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "m20o6ycbpj7yemv",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "koy5r9khk5h6rtr",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathrm a}\\;+\\;\\log\\frac{\\lbrack{\\mathrm C}_2{\\mathrm H}_3\\mathrm O_2^-\\rbrack}{\\lbrack{\\mathrm{HC}}_2 {\\mathrm H}_3{\\mathrm O}_2\\rbrack}\\;=\\;4.745\\;+\\;\\log\\frac{(0.15)}{(0.25)}\\;=\\;4.52",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "We see this is the same pH as calculated on the previous page."
                  }
                ],
                "id": "x5xnpx6795hgv0m",
                "type": "p"
              }
            ],
