              "expression": "// Two variable definitions\nconst weakest = [\"hypoiodous acid\", \"boric acid\", \"hydrocyanic acid\", \"hypobromous acid\", \"hypochlorous acid\"];\nconst d1 = [3.2, 5.4, 6.2, 2.8, 4.0];\nconst e1 = [-11, -10, -10, -9, -8];\nconst list2 = [\"propanoic acid\", \"butanoic acid\", \"pentanoic acid\", \"acetic acid\", \"hydrazoic acid\"];\nconst d2 = [1.3, 1.5, 1.5, 1.8, 2.5];\nconst e2 = [-5, -5, -5, -5, -5];\n\nconst list3 = [\"benzoic acid\", \"formic acid\", \"cyanic acid\", \"nitrous acid\", \"hydrofluoric acid\"];\nconst d3 = [6.3, 1.8, 3.5, 5.6, 6.3];\nconst e3 = [-5, -4, -4, -4, -4];\nconst strongest = [\"chloroacetic acid\", \"aresenic acid\", \"chlorous acid\", \"periodic acid\", \"iodic acid\", \"trichloroacetic acid\"]\nconst const1 = OLI.random(0,4);\nconst d4 = [1.4, 5.5, 1.1, 7.3, 1.7, 2.2];\nconst e4 = [-3, -3, -2, -2, -1];\nconst const2 = OLI.random(0,4);\nconst const3 = OLI.random(0,4);\nconst const4 = OLI.random(0,5);\nconst a = weakest[const1];\nconst deca = d1[const1];\nconst expa = e1[const1];\nconst b = list2[const2];\nconst decb = d2[const2];\nconst expb = e2[const2];\nconst c = list3[const3];\nconst decc = d3[const3];\nconst expc = e3[const3];\nconst d = strongest[const4];\nconst decd = d4[const4];\nconst expd = e4[const4];\n// Expose variables to OLI\nmodule.exports = {\n  const1,\n  const2,\n  const3,\n  const4,\n  a, deca, expa,\n  b, decb, expb,\n  c, decc, expc,\n  d, decd, expd\n};\n",
