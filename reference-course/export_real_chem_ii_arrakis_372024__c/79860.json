              "children": [],
              "expression": "// Two variable definitions\nconst halfLife = OLI.random(2.50, 9.99, 2) .toFixed(2);\nconst concIndex = OLI.random(0,5);\nconst array = [0.40, 0.45, 0.50, 0.55, 0.60, 0.65];\nconst finalConc = array[concIndex] .toFixed(2);\nconst k = (0.693/halfLife) .toPrecision(3);\nconst logConc = Math.log(0.750/finalConc);\nconst correct = (logConc/k) .toPrecision(2);\nconst corLow = correct*0.98;\nconst corHigh = correct*1.02;\n\n// Expose variables to OLI\nmodule.exports = {\n halfLife,\n concIndex,\n array,\n finalConc,\n k,\n logConc,\n correct,\n corLow,\n corHigh\n};\n",
