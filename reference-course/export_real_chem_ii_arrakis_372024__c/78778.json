                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "O]: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\lbrack{\\mathrm N}_2\\mathrm O\\rbrack\\;=\\;\\frac{k_{1\\rightarrow}\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\lbrack{\\mathrm H}_2\\rbrack}{k_{1\\leftarrow}\\lbrack{\\mathrm H}_2\\mathrm O\\rbrack}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Substituting into the rate law for the rate-limiting step: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{rate}\\;=\\;k_2\\left(\\frac{k_{1\\rightarrow}\\lbrack{\\mathrm N}_2{\\mathrm O}_2\\rbrack\\lbrack{\\mathrm H}_2\\rbrack}{k_{1\\leftarrow}\\lbrack{\\mathrm H}_2\\mathrm O\\rbrack}\\right)\\;\\lbrack{\\mathrm H}_2\\rbrack\\;;",
