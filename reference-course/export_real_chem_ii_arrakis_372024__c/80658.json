              }
            ],
            "id": "1128703766",
            "type": "h1"
          },
          {
            "children": [
              {
                "text": "Coming Soon"
              }
            ],
            "id": "qp1r1fwq3xtvytb",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "j747m30bbqbont8",
                "text": "Key Terms"
              }
            ],
            "id": "iccx35orpdo3qe8",
            "type": "h1"
          },
          {
            "children": [
              {
                "term": true,
                "text": "coupled equilibria"
              },
              {
                "text": " A system characterized by the simultaneous establishment of two or more equilibrium reactions with one or more shared substances."
              }
            ],
            "id": "3469141267",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "decomposition"
              },
              {
                "text": " A chemical reaction in which one reactant breaks apart down into two or more products."
              }
            ],
            "id": "3291396649",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "dilute"
              },
              {
                "text": " A qualitative term for a solution containing solute at a relatively low concentration."
              }
            ],
            "id": "2609392776",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "equilibrium"
              },
              {
                "text": " A dynamic process in which the concentrations of reactants and products remain constant and the forward and reverse reactions occur at equal rates."
              }
            ],
            "id": "2484058505",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "equilibrium constant ("
              },
              {
                "em": true,
                "term": true,
                "text": "K"
              },
              {
                "term": true,
                "text": ")"
              },
              {
                "text": " The value of the reaction quotient ("
              },
              {
                "em": true,
                "text": "Q"
              },
              {
                "text": ") when a system is at equilibrium, representing the ratio of the concentrations ("
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "sub": true,
                "text": "c"
              },
              {
                "text": ") or partial pressures ("
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "sub": true,
                "text": "p"
              },
              {
                "text": ") of the products to reactants, each raised to the power of their respective stoichiometric coefficients."
              }
            ],
            "id": "2140993574",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "heterogeneous equilibria"
              },
              {
                "text": " Equilibria established between substances in two or more phases, such as a gas and a liquid."
              }
            ],
            "id": "3479749236",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "homogeneous equilibria"
              },
              {
                "text": " Equilibria established between substances that are all in the same phase."
              }
            ],
            "id": "2580998424",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "ICE table"
              },
              {
                "text": " A useful way to organize initial, change, and equilibrium (ICE) data when solving equilibrium problems. Also called an "
              },
              {
                "em": true,
                "text": "ICE chart"
              },
              {
                "text": "."
              }
            ],
            "id": "3010263030",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "ideal gas law"
              },
              {
                "text": " A relation between the pressure, volume, amount, and temperature of a gas under conditions derived by combining the simple gas laws: Boyle's, Gay-Lussac's, Charles's, and Avogadro's laws."
              }
            ],
            "id": "1167438431",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "law of mass action"
              },
              {
                "text": " A law stating that, at equilibrium, the ratio of the concentrations or partial pressures of the products to the reactants, each raised to the power of their respective stoichiometric coefficients, is constant and equal to the equilibrium constant ("
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "text": ") for a given reaction at a particular temperature."
              }
            ],
            "id": "3732465628",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "Le Châteliers' principle"
              },
              {
                "text": " An empirical framework stating that when a system at equilibrium is subjected to a stress (such as a change in concentration, pressure, or temperature), the system will adjust in a way that counteracts the stress and reestablishes equilibrium."
              }
            ],
            "id": "4076272170",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "reaction quotient"
              },
              {
                "text": " A mathematical function that compares the concentrations or partial pressures of products to reactants at any point during a reaction, calculated using the same expression as the equilibrium constant ("
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "text": ") but for conditions that are not necessarily at equilibrium."
              }
            ],
            "id": "1746684076",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "reversible reaction"
              },
              {
                "text": " A chemical reaction in which the reactants can convert to products, and the products convert back to reactants, occurring simultaneously in both directions until dynamic equilibrium is reached."
              }
            ],
            "id": "2228112170",
            "type": "p"
          },
          {
            "children": [
              {
                "term": true,
                "text": "stoichiometry"
              },
              {
                "text": " Relationships between the amounts of reactants and products of a chemical reaction."
              }
            ],
            "id": "4188217337",
            "type": "p"
          }
        ],
