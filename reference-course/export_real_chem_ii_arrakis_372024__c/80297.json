              "children": [],
              "expression": "// Two variable definitions\nconst vol_cono3Index = OLI.random(0,3);\nconst vol_cono3Array = [100.0, 150.0, 200.0];\nconst vol_mL_cono3 = vol_cono3Array[vol_cono3Index] .toPrecision(4);\nconst vol_nh3Index = OLI.random(0,5);\nconst vol_nh3Array = [200.0, 250.0, 300.0, 350.0, 400.0];\nconst vol_mL_nh3 = vol_nh3Array[vol_nh3Index] .toPrecision(4);\n\nconst conc_cono3 = OLI.randomArrayItem([0.3, 0.4, 0.5]) .toPrecision(3);\nconst conc_nh3 = OLI.randomArrayItem([4.0, 5.0, 6.0]) .toPrecision(3);\n\n//moles of Co and NH3\nconst in_mol_co = conc_cono3*(vol_mL_cono3/1000) .toPrecision(3);\nconst in_mol_nh3 = conc_nh3*(vol_mL_nh3/1000) .toPrecision(3);\n\n//values for ICE table\nconst change_nh3 = (6*in_mol_co) .toPrecision(3);\nconst eq_mol_nh3 = (in_mol_nh3 - change_nh3) .toPrecision(3);\nconst eq_mol_conh3 = (in_mol_co) .toPrecision(3);\n\n//new total volume of solution\nconst tot_vol_mL = parseFloat(vol_mL_cono3) + parseFloat(vol_mL_nh3);\nconst tot_vol = (tot_vol_mL/1000) .toPrecision(4);\n\n//equilibrium concs of nh3 and conc_nh3\nconst eq_conc_nh3 = (eq_mol_nh3/tot_vol) .toPrecision(3);\nconst eq_conc_conh3 = (eq_mol_conh3/tot_vol) .toPrecision(3);\n\n// values for kf expression\n\nconst kf = 4.5e33;\nconst kd=1/kf; //don't think I need this for anything\nconst conc_nh3_to_6 = (eq_conc_nh3*eq_conc_nh3*eq_conc_nh3*eq_conc_nh3*eq_conc_nh3*eq_conc_nh3) .toPrecision(3);\n\n\nconst correct = (eq_conc_conh3/(conc_nh3_to_6*kf)) .toPrecision(2);\nconst corLow = 0.95*correct;\nconst corHigh = 1.05*correct;\n// Expose variables to OLI\nmodule.exports = {vol_cono3Index, vol_cono3Array, vol_mL_cono3, vol_mL_nh3, conc_cono3, conc_nh3, in_mol_co, in_mol_nh3, change_nh3, eq_mol_nh3, eq_mol_conh3, tot_vol_mL, tot_vol, eq_conc_nh3, eq_conc_conh3, kf, conc_nh3_to_6, correct, corLow, corHigh\n};\n",
              "id": "aaef5dfbca454797965e1b230ade3bcf",
