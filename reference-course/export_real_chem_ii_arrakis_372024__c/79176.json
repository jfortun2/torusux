                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K\\;=\\;\\frac{\\left[\\mathrm{ClO}^-\\right]\\cdot\\left[\\mathrm{HF}\\right]}{\\left[\\mathrm{HClO}\\right]\\cdot\\left[\\mathrm F^-\\right]}\\;=\\;\\frac{\\left[\\mathrm{ClO}^-\\right]\\cdot\\left[\\mathrm H^+\\right]}{\\left[\\mathrm{HClO}\\right]}\\cdot\\frac{\\left[\\mathrm{HF}\\right]}{\\left[\\mathrm H^+\\right]\\cdot\\left[\\mathrm F^-\\right]}\\;=\\;K_{HClO}\\cdot\\frac1{K_{HF}}\\\\\\\\",
                    "subtype": "latex",
                    "type": "formula_inline"
