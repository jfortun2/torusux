          "data": [
            {
              "children": [],
              "expression": "// Two variable definitions\n\nconst conc = [0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8]\nconst c = OLI.random(0,14,0);\nconst cc = OLI.random(0,14,0);\n\nconst acidconc = conc[c] .toPrecision(3);\nconst baseconc = conc[cc] .toPrecision(3);\n\nconst d = OLI.random(1,9.99,2);\nconst exp = OLI.random(-9, -4,0);\nconst ka = d*10**exp;\nconst pka = -Math.log10(ka);\nconst pkaRnd = (pka).toPrecision(4);\nconst ratio = baseconc/acidconc;\nconst temp =  Math.log10(ratio) ;\nconst ph = pka + temp; \nconst phRnd = (ph).toPrecision(4);\nconst phlow = 0.98*ph;\nconst phhigh=1.02*ph;\n// Expose variables to OLI\nmodule.exports = {\n  acidconc, baseconc, d, exp, ka, pka, temp, ph, phlow, phhigh, phRnd, pkaRnd\n};\n",
