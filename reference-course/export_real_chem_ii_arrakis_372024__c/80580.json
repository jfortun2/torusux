                      }
                    ],
                    "href": "/course/link/iz1ln_kb_values_of_common_weak_bases_n0mww",
                    "idref": "80791",
                    "target": "new",
                    "type": "a"
                  },
                  {
                    "text": " as needed."
                  }
                ],
                "id": "10gxw76kj0kexj6",
                "type": "p"
              }
            ],
