              "expression": "// Two variable definitions\nconst initial_conc = [0.100, 0.125, 0.150, 0.175, 0.2, 0.225, 0.250, 0.275, 0.3];\n\nconst count = OLI.random(0,8);\nconst conc = initial_conc[count] .toPrecision(3);\n\nconst ohconc = OLI.random(0.0001, 0.005, 5);\nconst ohconcsf = ohconc .toPrecision(3);\nconst kb = ohconc**2/(conc-ohconc);\nconst kbsf = kb .toPrecision(3);\nconst kblow = 0.98*kb;\nconst kbhigh = 1.02*kb;\n\nfunction numberOfZeros(n) {\n  var c = 0;\n  while (!~~n) {\n    c++;\n    n *= 10;\n  }\n  return c - 1;\n}\n\nconst num = numberOfZeros(kb);\n\nconst exp = num +1;\nconst dec = kb*10**(exp) .toPrecision(3);\nconst d = dec .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\ncount, conc, ohconc, ohconcsf, kb, kbsf, kblow, kbhigh, num, exp, dec, d\n};\n",
