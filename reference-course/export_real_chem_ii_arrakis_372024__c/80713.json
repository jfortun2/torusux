                    "id": "793582400",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "strong": true,
                        "text": "Follow the steps for balancing the reaction in acidic, aqueous solution."
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "2454799940",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Separate the reaction into an oxidation half-reaction and a reduction half-reaction."
                              }
                            ],
                            "id": "3534084353",
                            "type": "p"
                          }
                        ],
                        "type": "li"
                      },
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Balance each half reaction.  "
                              }
                            ],
                            "id": "1690584410",
                            "type": "p"
                          }
                        ],
                        "type": "li"
                      },
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Make the numbers of electrons gained and lost equal by multiplying the half-reactions by the appropriate factors."
                              }
                            ],
                            "id": "1506247719",
                            "type": "p"
                          }
                        ],
                        "type": "li"
                      },
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Add the balanced half-reactions together."
                              }
                            ],
                            "id": "3524027739",
                            "type": "p"
                          }
                        ],
                        "type": "li"
                      },
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Cancel like terms and simplify."
                              }
                            ],
                            "id": "2545410685",
                            "type": "p"
                          }
                        ],
                        "type": "li"
                      }
                    ],
                    "type": "ul"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "429252851",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "strong": true,
                        "text": "Additional Step for Balancing in Basic Solution"
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "text": " "
                      }
                    ],
                    "id": "2791105402",
                    "type": "p"
                  },
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "children": [
                              {
                                "text": "Eliminate the H"
                              },
                              {
                                "sup": true,
                                "text": "+"
                              },
                              {
                                "text": " ions by adding an equal number of OH"
                              },
                              {
                                "sup": true,
                                "text": "−"
                              },
                              {
                                "text": " ions and forming water. You must add the same number of OH"
                              },
                              {
                                "sup": true,
                                "text": "−"
                              },
                              {
                                "text": " ions to each side of the equation."
                              }
                            ],
                            "id": "3400284916",
