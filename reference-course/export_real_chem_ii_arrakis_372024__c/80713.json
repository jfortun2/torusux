      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Balance the following reaction in basic, aqueous solution:"
                  }
                ],
                "id": "z2z0k27j7ldadt6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "8pc93hmivteg65p",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "zs5pef3dmyhhj9c",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{Cl}^-(aq)\\;+\\;\\mathrm{MnO}_4^-(aq)\\;\\;\\longrightarrow\\;\\;\\mathrm{ClO}_3^-(aq)\\;+\\;{\\mathrm{MnO}}_2(s)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "First, balance the reaction in acidic, aqueous solution."
                  }
                ],
                "id": "8e0zu4iqb3il4f5",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Separate the reaction into an oxidation half-reaction and a reduction half-reaction:"
                          }
                        ],
                        "id": "1927011776",
                        "type": "p"
                      }
                    ],
                    "id": "dy6d9iux1dgxsl6",
                    "type": "li"
                  }
                ],
                "id": "pr8y6vro2uqnutj",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "ur77x80bshokoj9",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "4g6wmaccn54digo",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{Oxidation}:\\;\\;\\mathrm{Cl}^-(aq)\\;\\;\\rightarrow\\;\\;{\\mathrm{ClO}}_3^-(aq)\\\\\\mathrm{Reduction}: \\;{\\mathrm{MnO}}_4^-(aq)\\;\\;\\rightarrow\\;\\;{\\mathrm{MnO}}_2(s)\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Balance the elements in each half-reaction:"
                          }
                        ],
                        "id": "1765712950",
                        "type": "p"
                      }
                    ],
                    "id": "hcgmzmaipxna5ts",
                    "type": "li"
                  }
                ],
                "id": "0xv7qd1agd89nxn",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "1wszykbv2l3m50w",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "qyi3ou8iqi7jvxb",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{Oxidation}:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;3\\;{\\mathrm H}_2\\mathrm O(l)\\; +\\;\\mathrm{Cl}^-(aq)\\;\\;\\rightarrow\\;\\;\\mathrm{ClO}_3^-(aq)\\;+\\;6\\;\\mathrm H^+(aq)\\;+\\;6\\;\\mathrm e^-\\\\\\mathrm{Reduction}: \\;\\;\\;3\\;\\mathrm e^-\\;+\\;4\\;\\mathrm H^+(aq)\\;+\\;\\mathrm{MnO}_4^-(aq)\\;\\;\\rightarrow\\;\\;{\\mathrm{MnO}}_2(s)\\; +\\;2\\;{\\mathrm H}_2\\mathrm O(l)\\;\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Make the numbers of electrons gained and lost equal by multiplying the half-reactions by the appropriate factors."
                          }
                        ],
                        "id": "3639543019",
                        "type": "p"
                      }
                    ],
                    "id": "rt86au0gr9l5p6h",
                    "type": "li"
                  }
                ],
                "id": "lrsts0urs6mvwrt",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Add the balanced half-reactions together. Cancel like terms and simplify:"
                          }
                        ],
                        "id": "1829140417",
                        "type": "p"
                      }
                    ],
                    "id": "xbrvmtbcv0mm2ny",
                    "type": "li"
                  }
                ],
                "id": "ax3ha0zk4rjd02m",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "el9sodxlydvtef1",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "g1umtv569dvn2yh",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;3\\;{\\mathrm H}_2\\mathrm O(l)\\;+\\;\\mathrm{Cl}^-(aq) \\;\\;\\rightarrow\\;\\;\\mathrm{ClO}_3^-(aq)\\;+\\;6\\;\\mathrm H^+(aq)\\;+\\;6\\;\\mathrm e^-\\\\\\underline{\\;\\;6\\;\\mathrm e^-\\; +\\;8\\;\\mathrm H^+(aq)\\;+\\;2\\;\\mathrm{MnO}_4^-(aq)\\;\\;\\rightarrow\\;2\\;{\\mathrm{MnO}}_2(s)\\;+\\;4\\;{\\mathrm H}_2\\mathrm O(l) \\;\\;\\;(\\mathrm{multiplied}\\;\\mathrm{by}\\;2)}\\\\\\mathrm{Cl}^-(aq)\\;+\\;2\\;\\mathrm{MnO}_4^-(aq)\\;+\\;2\\;\\mathrm H^+(aq)\\; \\rightarrow\\;\\mathrm{ClO}_3^-(aq)\\;+\\;2\\;{\\mathrm{MnO}}_2(s)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Additional Step for Balancing in Basic Solution"
                  }
                ],
                "id": "bktm7v87s82zzbf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Eliminate H"
                          },
                          {
                            "sup": true,
                            "text": "+"
                          },
                          {
                            "text": " by adding OH"
                          },
                          {
                            "sup": true,
                            "text": "−"
                          },
                          {
                            "text": " and forming water. Add the same number of OH"
                          },
                          {
                            "sup": true,
                            "text": "−"
                          },
                          {
                            "text": " ions to each side of the equation:"
                          }
                        ],
                        "id": "425252149",
                        "type": "p"
                      }
                    ],
                    "id": "x8l016pevfslh9y",
                    "type": "li"
                  }
                ],
                "id": "7qptpad4fns97rs",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "8ffcjafkldkc2po",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "36epyldpgfj0pq9",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{Add}\\;\\mathrm{two}\\;\\mathrm{OH}^-\\;\\mathrm{ions}\\;\\mathrm{to}\\;\\mathrm{each}\\;\\mathrm{side}: \\\\\\mathrm{Cl}^-(aq)\\;+\\;2\\;\\mathrm{MnO}_4^-(aq)\\;+\\;2\\;\\mathrm H^+(aq)\\;+\\;\\boxed{2\\;\\mathrm{OH}^-(aq)}\\; \\rightarrow\\;\\mathrm{ClO}_3^-(aq)\\;+\\;2\\;{\\mathrm{MnO}}_2(s)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\; +\\;\\boxed{2\\;\\mathrm{OH}^-(aq)}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "0ok7gh9b9zs7aqy",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "911i9az2i72eghl",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}2\\;\\mathrm H^+\\;\\mathrm{and}\\;2\\;\\mathrm{OH}^-\\;\\mathrm{forms}\\;2\\;{\\mathrm H}_2\\mathrm O: \\;\\\\\\mathrm{Cl}^-(aq)\\;+\\;2\\;\\mathrm{MnO}_4^-(aq)\\;+\\;\\boxed{2\\;{\\mathrm H}_2\\mathrm O(l)\\;} \\rightarrow\\;\\mathrm{ClO}_3^-(aq)\\;+\\;2\\;{\\mathrm{MnO}}_2(s)\\;+\\;\\boxed{{\\mathrm H}_2\\mathrm O(l)}\\; +\\;2\\;\\mathrm{OH}^-(aq)\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Cancel like terms and simplify:"
                          }
                        ],
                        "id": "378487200",
                        "type": "p"
                      }
                    ],
                    "id": "nyllqvekyol0wcm",
                    "type": "li"
                  }
                ],
                "id": "k2vk1u4o9c2cnwz",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "nkpuglyiwymatos",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "wdkfm5fq2o9itrw",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{One}\\;\\mathrm{water}\\;\\mathrm{molecule}\\;\\mathrm{cancels}\\;\\mathrm{to}\\;\\mathrm{yield}: \\\\\\mathrm{Cl}^-(aq)\\;+\\;2\\;\\mathrm{MnO}_4^-(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightarrow\\;\\;\\mathrm{ClO}_3^-(aq)\\; +\\;2\\;{\\mathrm{MnO}}_2(s)\\;+\\;2\\;\\mathrm{OH}^-(aq)\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
                          {
                            "text": "Check the overall reaction to make sure the mass and charge are balanced:"
                          }
                        ],
                        "id": "586048157",
                        "type": "p"
                      }
                    ],
                    "id": "3gjy7fk9ui08ri8",
                    "type": "li"
                  }
                ],
                "id": "0q962lm8wwvscqf",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "3v9rb3bl6x0i9yl",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "pb1hll0fe6yeevv",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{Cl}:\\;\\;(1\\times1\\;)\\;=\\;(1\\times1)\\;\\;\\Rightarrow\\;\\mathrm{balanced}\\\\\\mathrm{Mn}: \\;\\;(2\\times1)\\;=\\;(2\\times1)\\;\\;\\Rightarrow\\;\\mathrm{balanced}\\\\\\mathrm H:\\;\\;(1\\times2)\\;=\\;(2\\times1)\\;\\; \\Rightarrow\\;\\mathrm{balanced}\\\\\\mathrm O:\\;\\;(2\\times4\\;+\\;1\\times1)\\;=\\;(3\\times1\\;+\\;2\\times2\\; +\\;2\\times1)\\;\\;\\Rightarrow\\;\\mathrm{balanced}\\\\\\mathrm{Charge}:\\;\\;\\lbrack1\\times(-1)+2\\times(-1)\\rbrack\\; =\\;\\lbrack1\\times(-1)+2\\times(-1)\\rbrack\\;\\;\\Rightarrow\\;\\mathrm{balanced}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
