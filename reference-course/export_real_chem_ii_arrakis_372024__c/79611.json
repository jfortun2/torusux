              {
                "children": [
                  {
                    "text": "Total volume after reaction = 0.0250 L + 0.0250 L = 0.0500 L."
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\lbrack\\mathrm{HClO}\\rbrack=\\frac{0.00125\\;\\mathrm{mol}}{0.0500\\;\\mathrm L}=0.0250\\;\\mathrm M\\;\\mathrm{and}\\;\\lbrack\\mathrm{ClO}^-\\rbrack=\\frac{0.00500\\;\\mathrm{mol}}{0.0500\\;\\mathrm L}=0.100\\;\\mathrm M",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "This solution is a buffer, so its pH is:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathrm a}\\;+\\:\\log\\frac{\\lbrack\\mathrm{ClO}^-\\rbrack}{\\lbrack\\mathrm{HClO}\\rbrack}\\; =\\;-\\log(2.9\\times10^{-8})\\;+\\:\\log\\left(\\frac{0.100}{0.0250}\\right)\\;=\\;8.14",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  }
                ],
                "id": "y82hvsso6o9qguc",
                "type": "p"
              }
