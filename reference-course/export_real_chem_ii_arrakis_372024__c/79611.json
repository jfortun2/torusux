          "hints": [
            {
              "content": [
                {
                  "children": [
                    {
                      "text": "The OH"
                    },
                    {
                      "sup": true,
                      "text": "–"
                    },
                    {
                      "text": " from the NaOH reacts with HClO to produce ClO"
                    },
                    {
                      "sup": true,
                      "text": "–"
                    },
                    {
                      "text": ", thereby decreasing the amount of HClO and increasing the amount of ClO"
                    },
                    {
                      "sup": true,
                      "text": "–"
                    },
                    {
                      "text": ". The reaction is: "
                    },
                    {
                      "children": [
                        {
                          "text": " ",
                          "type": "text"
                        }
                      ],
                      "legacyBlockRendered": true,
                      "src": "\\mathrm{HClO}(aq)\\;+\\;\\mathrm{OH}^-(aq)\\;\\;\\rightarrow\\;\\;\\mathrm{ClO}^-(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)",
                      "subtype": "latex",
                      "type": "formula_inline"
                    },
                    {
                      "text": ""
                    }
                  ],
