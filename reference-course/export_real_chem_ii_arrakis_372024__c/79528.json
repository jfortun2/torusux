              "children": [],
              "expression": "// Two variable definitions\nconst P = OLI.random(1, 5, 2);\nconst Psf = P .toPrecision(3);\nconst deltaG = OLI.random(-10, 10, 3);\nconst deltaGsf = deltaG .toPrecision(3);\nconst ratio = -deltaGsf/(0.008314*298.2);\nconst K = Math.exp(ratio);\nconst Ksf = K .toPrecision(3);\nconst num = Ksf*Psf;\nconst den = K + 1;\nconst ans = num/den;\nconst anssf = ans .toPrecision(3);\nconst low = ans*0.97;\nconst high = ans*1.03;\nconst check = ans/(P - ans);\nconst checksf = check .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\n  P, Psf, deltaG, deltaGsf, ratio, K, Ksf, num, den, ans, anssf, low, high, checksf \n};\n",
