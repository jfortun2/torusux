                ]
              }
            },
            "type": "content"
          },
          {
            "children": [
              {
                "activity_id": 80502,
                "id": "2077090316",
                "type": "activity-reference"
              },
              {
                "activity_id": 80078,
                "id": "3222931369",
                "type": "activity-reference"
              },
              {
                "activity_id": 79020,
                "id": "2592614466",
                "type": "activity-reference"
              },
              {
