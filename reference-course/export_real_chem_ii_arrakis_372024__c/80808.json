                "type": "activity-reference"
              }
            ],
            "id": "3662988642",
            "layout": "vertical",
            "purpose": "none",
            "type": "group"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "text": "At equilibrium, the forward and reverse reactions continue and have equal rates. Though the concentrations of products and reactants are not changing at equilibrium, they are not necessarily equal. "
                  }
                ],
                "id": "tu082d55wmdaal0",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "The test tubes in the following activity show six solutions at different equilibrium states."
                  }
                ],
                "id": "7md5bx9py91t8xf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Drag the test tubes of cobalt(II) solutions to the workbench to show the order of the equilibrium states from mostly reactants to mostly products."
                  }
                ],
                "id": "nfbf2sk6qphxzpu",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "kyj238mlcuqn1zl",
                    "text": " ",
                    "type": "text"
                  }
                ],
