              "children": [],
              "expression": "const d = OLI.random(1,9.99,2) .toPrecision(3);\nconst e = OLI.random(-34,-20,0);\nconst ksp = d*10**e .toPrecision(3);\nconst xStep1 = (ksp/27) .toPrecision(3);\nconst x = ((ksp/27)**.25) .toPrecision(3);\nconst oh = (3*x) .toPrecision(3);\nconst low = 0.95*oh;\nconst high = 1.05*oh;\n// Expose variables to OLI\nmodule.exports = {\n  d, e, ksp, xStep1, x, oh, low, high\n};\n",
