          {
            "children": [
              {
                "children": [
                  {
                    "text": "These next questions ask about your personal background and demographic information. This information is only used to understand you as a learner and understand the range of students participating in the course. "
                  }
                ],
                "id": "4053074462",
                "type": "p"
              }
