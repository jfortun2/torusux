                    {
                      "sup": true,
                      "text": "−"
                    },
                    {
                      "text": " using an ICE table. Because the solution is 0.015 M Al(NO"
                    },
                    {
                      "sub": true,
                      "text": "3"
                    },
                    {
                      "text": ")"
                    },
                    {
                      "sub": true,
                      "text": "3"
                    },
                    {
                      "text": ", the initial concentration of Al"
                    },
                    {
                      "sup": true,
                      "text": "3+"
                    },
                    {
                      "text": " is 0.015 M."
                    }
