                      ],
                      "legacyBlockRendered": true,
                      "src": "\\mathrm{Al}(\\mathrm{OH})_3(\\mathrm s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Al}^{3+}(\\mathrm{aq})\\;+\\;3\\;\\mathrm{OH}^-(\\mathrm{aq})",
