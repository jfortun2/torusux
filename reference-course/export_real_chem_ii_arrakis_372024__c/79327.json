                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Al}^{3+}\\rbrack\\lbrack\\mathrm{OH}^-{\\rbrack^3\\; =\\;(0.015+x)(3x)}^3\\;=\\;2\\times10^{-32}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "sp"
                  },
                  {
                    "text": " is very small, so "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " is also very small (negligible compared to 0.015). Therefore:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "{(0.015)(3x)}^3\\;=\\;2\\times10^{-32}\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;x\\;=\\;\\sqrt[3]{\\frac{2\\times10^{-32}} {(27)(0.015)}}\\;=\\underset{1\\;\\mathrm{significant\\;figure}}{\\;4\\times10^{-11}}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "The molar solubility of Al(OH)"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": " = "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " = 4 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–11"
                  },
                  {
                    "text": " M."
                  }
                ],
                "id": "d9tl1qn0g4tsndd",
                "type": "p"
              }
