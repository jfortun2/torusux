              },
              {
                "children": [
                  {
                    "text": "Use the K"
                  },
                  {
                    "sub": true,
                    "text": "b"
                  },
                  {
                    "text": " for NH"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": " to determine the K"
                  },
                  {
                    "sub": true,
                    "text": "a"
                  },
                  {
                    "text": " for NH"
                  },
                  {
                    "sub": true,
                    "text": "4"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": " and set up the acid dissociation constant expression. Then solve for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " = [H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "], and finally calculate pH:"
                  }
                ],
                "id": "jb7m6awzqt68p23",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{c}K_a\\;=\\;\\frac{1.0\\times10^{-14}}{1.8\\times10^{-5}}\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\cdot\\lbrack{\\mathrm{NH}}_3\\rbrack}{\\lbrack{\\mathrm{NH}}_4^+\\rbrack} =\\;\\frac{x\\cdot x}{@@conc@@\\;-\\;x}\\;=\\;5.6\\times10^{-10}\\\\\\mathrm{Since}\\;\\;x\\;\\ll\\;@@conc@@\\;\\;\\;\\Rightarrow\\;\\;\\frac{x^2}{@@conc@@}\\;\\cong\\;5.6\\times10^{-10}\\;\\;\\;\\;\\\\\\mathrm{Then}\\;\\;x\\; =\\sqrt{\\;@@conc@@\\cdot5.6\\times10^{-10}}\\;=\\;@@hsf@@\\;\\mathrm M\\;=\\;\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\\\\\mathrm{And}\\;\\;\\mathrm{pH}\\;=\\;-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\; =\\;-\\log\\left(@@hsf@@\\right)\\;=\\;@@phsf@@\\;\\end{array}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  }
                ],
                "id": "ni0ybg2q3xsu5h8",
                "type": "p"
              }
