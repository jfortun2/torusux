        ],
        "id": "3023002703",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "id": "oyvdxmafblvbbbr",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ou44vdo0qhqq776",
                "legacyBlockRendered": "true",
                "src": "K_a\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\lbrack\\mathrm A^-\\rbrack}{\\lbrack\\mathrm{HA}\\rbrack}\\;\\;\\;\\;and\\;\\;\\;\\;\\;\\;K_b\\;=\\;\\frac{\\lbrack\\mathrm{BH}^+\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack}{\\lbrack\\mathrm B\\rbrack}",
                "subtype": "latex",
                "type": "formula"
              }
            ],
