    "stem": {
      "content": [
        {
          "children": [
            {
              "text": "Consider the reaction: "
            }
          ],
          "id": "ad802a2ec1c4469e9f5af8ae559b3270",
          "type": "p"
        },
        {
          "children": [
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "legacyBlockRendered": true,
              "src": "\\mathrm{OCl}^-(aq)\\;+\\;\\mathrm I^-(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\rightarrow\\;\\mathrm{HOI}(aq)\\;+\\;\\mathrm{OH}^-(aq)\\;+\\;\\mathrm{Cl}^-(aq)",
              "subtype": "latex",
              "type": "formula_inline"
            }
          ],
          "id": "v91ycd7s0gcah90",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "The following mechanism has been proposed for this reaction. "
            }
          ],
          "id": "c65ac7ca8f1c49c68dab481e6f506a29",
          "type": "p"
        },
        {
          "children": [
            {
              "children": [
                {
                  "text": ""
                }
              ],
              "legacyBlockRendered": true,
              "src": "\\mathrm{OCl}^-(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\rightleftharpoons\\;\\mathrm{HOCl}(aq)\\;+\\;\\mathrm{OH}^-(aq)\\;\\;\\;\\;\\;\\;(\\mathrm{fast},\\;\\mathrm{reversible})\\;\\\\\\mathrm I^-(aq)\\;+\\;\\mathrm{HOCl}(aq)\\;\\rightarrow\\;\\mathrm{HOI}(aq)\\;+\\;\\mathrm{Cl}^-(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;(\\mathrm{slow})",
              "subtype": "latex",
              "type": "formula_inline"
            }
          ],
          "id": "0sg8u10ssn072rt",
          "type": "p"
        },
        {
          "children": [
            {
              "text": "Determine the rate law for this proposed mechanism."
