      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "The two elementary steps that represent the mechanism of a reaction at temperatures below 500 K are:"
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{l}\\mathrm{Step}\\;1:\\;\\;\\;\\;\\;{\\mathrm{NO}}_2(g)\\;+\\;{\\mathrm{NO}}_2(g)\\;\\longrightarrow\\;{\\mathrm{NO}}_3(g)\\; +\\;\\mathrm{NO}(g)\\;\\;\\;\\;\\\\\\mathrm{Step}\\;2:\\;\\;\\;\\;\\;\\;{\\mathrm{NO}}_3(g)\\;+\\;\\mathrm{CO}(g)\\;\\longrightarrow\\;{\\mathrm{NO}}_2(g)\\; +\\;{\\mathrm{CO}}_2(g)\\end{array}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Answer the following questions related to this mechanism."
                  }
                ],
                "id": "ti2swjq2uakh4ph",
                "type": "p"
              }
            ],
