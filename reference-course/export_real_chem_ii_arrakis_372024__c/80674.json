      },
      {
        "children": [
          {
            "activity_id": 80096,
            "id": "1754473202",
            "type": "activity-reference"
          },
          {
            "id": "2612972305",
            "type": "break"
          },
          {
            "activity_id": 79087,
            "id": "849779728",
