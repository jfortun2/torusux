                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{c}K_b\\;=\\;\\frac{1.0\\times10^{-14}}{4.9\\times10^{-10}}\\;=\\;\\frac{\\lbrack\\mathrm{HCN}\\rbrack\\cdot\\lbrack\\mathrm{OH}^-\\rbrack}{\\lbrack\\mathrm{CN}^-\\rbrack} =\\;\\frac{x\\cdot x}{@@conc@@\\;-\\;x}\\;=\\;2.0\\times10^{-5}\\\\\\mathrm{since}\\;\\;x\\;\\ll\\;@@conc@@\\;\\;\\;\\Rightarrow\\;\\;\\frac{x^2}{@@conc@@}\\;\\cong\\;2.0\\times10^{-5}\\;\\;\\;\\;\\\\\\mathrm{solving}\\;\\;\\Rightarrow\\;\\;x\\; =\\sqrt{\\;@@conc@@\\cdot2.0\\times10^{-5}}\\;=\\;@@ohsf@@\\;\\mathrm M\\;=\\;\\lbrack\\mathrm{OH}^-\\rbrack\\\\\\mathrm{then}\\;\\;\\;\\mathrm{pOH}\\;=\\;-\\log\\lbrack\\mathrm{OH}^-\\rbrack\\; =\\;-\\log\\left(@@ohsf@@\\right)=\\;@@poh@@\\;\\\\\\mathrm{and}\\;\\;\\;\\mathrm{pH}\\;=\\;14.00\\;-\\;@@poh@@\\;=\\;@@ph@@\\end{array}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  }
                ],
                "id": "c86zstlelqyggk7",
                "type": "p"
