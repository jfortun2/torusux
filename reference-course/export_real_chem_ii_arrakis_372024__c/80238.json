              "expression": "// Two variable definitions\nconst initial_conc = [0.100, 0.150, 0.20, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5];\n\nconst count = OLI.random(0,8);\nconst conc = initial_conc[count] .toPrecision(3);\n\nconst kb = 1e-14/4.9e-10;\nconst kbsf = kb .toPrecision(2);\n\nconst oh = Math.sqrt(kb*conc);\nconst ohsf = oh .toPrecision(2);\nconst poh = -Math.log10(oh) .toPrecision(3);\n\nconst ph = 14-poh .toPrecision(3);\nconst phlow = 0.98*ph;\nconst phhigh = 1.02*ph;\n\n// Expose variables to OLI\nmodule.exports = {\ncount, conc, kbsf, oh, ohsf, poh, ph, phlow, phhigh\n};\n",
