                    "children": [
                      {
                        "id": "owjpa5tq81a8nan",
                        "text": ""
                      }
                    ],
                    "id": "2917518604",
                    "src": "\\mathrm{Rate}\\;=\\;k{\\lbrack\\;\\;\\rbrack}^0\\;=\\;k\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;k\\;=\\;\\mathrm{Rate}",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "children": [
                      {
                        "id": "4f21syedahc21uw",
                        "text": ""
                      }
                    ],
                    "id": "4150064611",
                    "src": "\\mathrm{units}\\;\\mathrm{of}\\;k\\;=\\;\\frac{\\;\\mathrm{units}\\;\\mathrm{of}\\;\\mathrm{rate}}{\\mathrm{units}\\;\\mathrm{of}\\;\\mathrm{concentration}}\\;=\\;\\frac{\\mathrm M}{\\mathrm s}",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "children": [
                      {
                        "text": "Therefore, the units for "
                      },
                      {
                        "em": true,
                        "text": "k"
                      },
                      {
                        "text": " are the same as the units for rate (M/s or M s"
                      },
                      {
                        "sup": true,
                        "text": "−1"
                      },
                      {
                        "text": ")."
                      }
                    ],
                    "id": "mgs7u2vdmqcklq0",
                    "type": "p"
                  }
                ],
