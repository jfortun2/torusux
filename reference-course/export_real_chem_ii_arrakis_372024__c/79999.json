              "children": [],
              "expression": "// Two variable definitions\nconst D = OLI.random(1, 9.9,1);\nconst E = OLI.random(-13,-2,0);\nconst H = (D*10**E) .toPrecision(3);\nconst pH = (-Math.log10(H)) .toFixed(2);\nconst pOH = (14-pH) .toPrecision(3);\nconst OH = (10**-pOH) .toPrecision(3);\nconst pHlow = 0.98*pH;\nconst pHhigh = 1.02*pH;\nconst pOHlow = 0.99*pOH;\nconst pOHhigh = 1.02*pOH;\nconst OHlow = 0.98*OH;\nconst OHhigh = 1.02*OH;\nconst Hlow = 0.98*H;\nconst Hhigh = 1.02*H;\n// Expose variables to OLI\nmodule.exports = {\n  D,\n  E,\n  H,\n  pH,\n  pOH,\n  OH,\n  pHlow,\n  pHhigh,\n  pOHlow,\n  pOHhigh,\n  OHlow,\n  OHhigh,\n  Hlow,\n  Hhigh\n};\n",
