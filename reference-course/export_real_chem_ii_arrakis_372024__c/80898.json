                            "text": "aq"
                          },
                          {
                            "id": "5q830ipqi8u725j",
                            "strong": true,
                            "text": ") + S"
                          },
                          {
                            "id": "z1r0wk5l8u9mkh3",
                            "strong": true,
                            "sup": true,
                            "text": "2−"
                          },
                          {
                            "id": "n7v2n4bod6ogr0y",
                            "strong": true,
                            "text": "("
                          },
                          {
                            "em": true,
