              "children": [],
              "expression": "// Two variable definitions\nconst k = OLI.random(3.53,9.75,2) .toFixed(2);\nconst initialRateIndex = OLI.random(0 , 4);\nconst array = [0.600, 0.700, 0.800, 0.900]\nconst initialRate = array[initialRateIndex] .toFixed(3); \nconst finalRate = OLI.random(0.115,0.455,3) .toFixed(3);\nconst correct = ((initialRate - finalRate)/k) .toPrecision(3);\nconst corLow = correct*0.99;\nconst corHigh = correct*1.01;\nconst k2 = OLI.random (0.20,0.60,3) .toFixed(3);\nconst time = OLI.random (0.20,0.60,3) .toFixed(3);\nconst correct2 = ((0.500)-(k2*time));\nconst corRound = (correct2*1).toPrecision(3);\nconst cor2Low = correct2*0.98;\nconst cor2High = correct2*1.02;\n// Expose variables to OLI\nmodule.exports = {\n  k,\n  initialRateIndex,\n  initialRate,\n  finalRate,\n  correct,\n  corLow,\n  corHigh,\n  k2,\n  time,\n  correct2,\n  corRound,\n  cor2Low,\n  cor2High\n  \n};\n",
