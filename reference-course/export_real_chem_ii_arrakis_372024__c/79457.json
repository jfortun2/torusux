          "explanation": {
            "content": [
              {
                "children": [
                  {
                    "text": "Incorrect. "
                  }
                ],
                "id": "u5c7h781m33u5jk",
                "type": "p"
              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Solution"
                  }
                ],
                "id": "ywdlukamh07ywsv",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": " Use the Arrhenius equation: "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "k\\;=\\;Ae^\\frac{-E_a}{RT}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Rearranging to solve for A at "
                  },
                  {
                    "em": true,
                    "text": "T"
                  },
                  {
                    "sub": true,
                    "text": "1"
                  },
                  {
                    "text": ": "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "A\\;=\\;\\frac k{e^{-{\\displaystyle\\frac{E_a}{RT}}}}\\;\\;=\\;\\;\\;k\\cdot e^\\frac{E_a}{RT}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Substitute values to determine A. "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "A\\;=\\;\\;\\;(1.76\\;\\mathrm M^{-1}\\mathrm s^{-1})\\cdot\\;e^\\frac{15000\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}}}}{(8.314\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}\\cdot\\mathrm K}})(273\\;\\mathrm K)}\\;\\;\\;=\\;\\;1305\\;\\mathrm M^{-1}\\mathrm s^{-1}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Then use this value of A to determine "
                  },
                  {
                    "em": true,
                    "text": "k"
                  },
                  {
                    "text": " at "
                  },
                  {
                    "em": true,
                    "text": "T"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ". "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K\\;=\\;Ae^{-\\frac{E_a}{RT_2}}\\;\\;=\\;(1305\\;\\mathrm M^{-1}\\mathrm s^{-1})\\;\\mathrm e^{\\frac{(-15,000\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}}})}{(8.314\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}\\;\\cdot\\mathrm K}})(298\\;\\mathrm K)}\\;\\;}\\;=\\;\\;3.06\\;\\mathrm M^{-1}\\mathrm s^{-1}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  }
                ],
                "id": "6seybmgknd1c0g6",
