                            "strong": true,
                            "text": "Substitute the equilibrium concentrations determined in the ICE table into the equilibrium expression. Assume "
                          },
                          {
                            "em": true,
                            "strong": true,
                            "text": "x"
                          },
                          {
                            "strong": true,
                            "text": " << [HA] and solve for "
