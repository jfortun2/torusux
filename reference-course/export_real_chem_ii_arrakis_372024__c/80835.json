              {
                "children": [
                  {
                    "id": "pbeqh5xl0ybn02c",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "hubpbzw7rzovc73",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm a}\\;=\\;\\frac{\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;\\lbrack\\mathrm{Al}({\\mathrm H}_2\\mathrm O)_5 (\\mathrm{OH})^{2+}\\rbrack}{\\lbrack\\mathrm{Al}({\\mathrm H}_2\\mathrm O)_6^{3+}\\rbrack}\\;=\\;\\frac{(x)(x)}{0.10-x}\\;\\cong\\; \\frac{x^2}{0.10}\\;=\\;1.4\\times10^{-5}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "fo5dj51ltievfab",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "vp9y8uod7oexrqy",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{c}x\\;=\\;\\sqrt{(0.10)(1.4\\times10^{-5})}\\;=\\;1.2\\times10^{-3}\\;\\mathrm M\\;\\\\(1.2\\times10^{-3}/0.10) \\times100\\%\\;=\\;1.2\\%\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\mathrm{assumption}\\;\\mathrm{is}\\;\\mathrm{justified}\\\\x\\; =\\;\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;1.2\\times10^{-3}\\;\\mathrm M\\;\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "children": [
