                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{c}K_{a1}\\;=\\;\\frac{\\lbrack{{\\mathrm H}_3\\mathrm O}^+\\rbrack\\cdot\\lbrack{\\mathrm{HCO}}_3{}^-\\rbrack}{\\lbrack{\\mathrm H}_2{\\mathrm{CO}}_3\\rbrack}\\; =\\;\\frac{x^2}{@@concsf@@\\;-\\;x}\\;=\\;4.4\\times10^{-7}\\\\\\mathrm{solving}\\;\\;\\;\\Rightarrow\\;\\;x\\;=\\;\\lbrack{{\\mathrm H}_3\\mathrm O}^+\\rbrack\\; =\\;@@h@@\\;\\mathrm M\\;\\\\\\mathrm{then}\\;\\;\\mathrm{pH}\\;=\\;-\\log\\lbrack{{\\mathrm H}_3\\mathrm O}^+\\rbrack\\;=\\;-\\log\\left(@@h@@\\right)\\;=\\;@@phsf@@\\end{array}",
