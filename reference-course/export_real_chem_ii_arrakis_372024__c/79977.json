                    "type": "text"
                  }
                ],
                "id": "zmm3as3vj1y4sd2",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{oxidation}:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\mathrm{Ni}(s)\\; \\rightarrow\\;\\mathrm{Ni}^{2+}(aq)\\;+\\;2\\;\\mathrm e^-\\;\\;\\;\\;\\;\\;\\;\\;\\;E^\\circ\\; =\\;+0.257\\;\\mathrm V\\\\\\underline{\\mathrm{reduction}:\\;\\;\\;\\;2\\;\\mathrm{Ag}^+(aq)\\; +\\;2\\;\\mathrm e^-\\;\\rightarrow\\;2\\;\\mathrm{Ag}(\\mathrm s)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; E^\\circ\\;=\\;+0.800\\;\\mathrm V}\\\\\\mathrm{overall}:\\;\\;\\;\\;\\;\\;\\;\\;\\mathrm{Ni}(s)\\; +\\;2\\;\\mathrm{Ag}^+(aq)\\;\\rightarrow\\;\\mathrm{Ni}^{2+}(aq)\\;+\\;2\\;\\mathrm{Ag}(s)\\;\\;\\;\\;\\; E^\\circ\\;=\\;+1.057\\;\\mathrm V\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Then calculate Δ"
                  },
                  {
                    "em": true,
