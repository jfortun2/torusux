                        "src": "\\require{color}\\underset{\\color[rgb]{0.0, 0.0, 1.0}\\textbf{base}}{\\;\\;\\mathrm F^-\\;}\\;+\\;\\;\\underset{\\mathbf{proton}}{\\;\\;\\mathrm H^+\\;}\\;\\;\\rightleftharpoons\\;\\;\\underset{\\color[rgb]{1.0, 0.0, 0.0}\\textbf{conjugate acid}}{\\;\\mathrm{HF}}",
