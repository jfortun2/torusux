            "id": "pxh112gs01dbzlj",
            "legacyBlockRendered": "true",
            "src": "\\underset{\\color[rgb]{1.0, 0.0, 0.0}\\textbf{acid}}{{\\mathrm H}_2\\mathrm O}\\;+\\;\\underset{\\color[rgb]{0.0, 0.0, 1.0}\\textbf{base}}{{\\mathrm C}_5{\\mathrm{NH}}_5}\\;\\;\\;\\rightleftharpoons\\;\\;\\underset{\\color[rgb]{1.0, 0.0, 0.0}\\textbf{acid}}{{\\mathrm C}_5\\mathrm{NH}_6^+}\\;+\\underset{\\color[rgb]{0.0, 0.0, 1.0}\\textbf{base}}{\\;\\mathrm{OH}^-}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K\\;=\\;\\frac{\\lbrack{\\mathrm C}_5\\mathrm{NH}_6^+\\rbrack\\lbrack\\mathrm{OH}^-\\rbrack}{\\lbrack{\\mathrm C}_5{\\mathrm{NH}}_5\\rbrack}",
            "subtype": "latex",
