              "children": [],
              "expression": "// Two variable definitions\nconst amtU = OLI.random(1.18,7.99,2) .toFixed(2);\nconst amtPb = OLI.random(1.25,3.32,2) .toFixed(2);\nconst amtUGram = amtU/1000;\nconst amtPbGram = amtPb/1000;\nconst amtUMol = amtUGram/238;\nconst molUsf = amtUMol .toPrecision(3); \nconst amtPbMol = amtPbGram/206;\nconst molPbsf = amtPbMol .toPrecision(3);\nconst amtUInitial = amtUMol+amtPbMol;\nconst initialUsf = amtUInitial .toPrecision(3);\nconst URatio = amtUMol/amtUInitial;\nconst logRatio = Math.log(URatio);\nconst correct = -6493506493*logRatio;\nconst ansCoeff = correct/1000000000 \nconst ansCoeffsf = ansCoeff .toPrecision(3);\nconst corLow = correct*0.98;\nconst corHigh = correct*1.02;\n\n// Expose variables to OLI\nmodule.exports = {\n  amtU,\n  amtPb,\n  amtUGram,\n  amtPbGram,\n  amtUMol,\n  molUsf,\n  amtPbMol,\n  molPbsf,\n  amtUInitial,\n  initialUsf,\n  URatio,\n  logRatio,\n  correct,\n  ansCoeff,\n  ansCoeffsf,\n  corLow,\n  corHigh\n};\n",
