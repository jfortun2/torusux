                    "text": "1"
                  },
                  {
                    "text": ": "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "A\\;=\\;\\frac k{e^{-{\\displaystyle\\frac{E_a}{RT}}}}\\;\\;=\\;\\;\\;k\\cdot e^\\frac{E_a}{RT}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Substitute values to determine A. "
                  },
                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "A\\;=\\;\\;\\;(2.54\\;\\mathrm M^{-1}\\mathrm s^{-1})\\cdot\\;e^\\frac{15000\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}}}}{(8.314\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}\\cdot\\mathrm K}})(273\\;\\mathrm K)}\\;\\;\\;=\\;\\;1884\\;\\mathrm M^{-1}\\mathrm s^{-1}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": " Then use this value of A to determine "
                  },
                  {
                    "em": true,
                    "text": "k"
                  },
                  {
                    "text": " at "
                  },
                  {
                    "em": true,
                    "text": "T"
