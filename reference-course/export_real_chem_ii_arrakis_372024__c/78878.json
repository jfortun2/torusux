                  {
                    "children": [
                      {
                        "text": ""
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K\\;=\\;Ae^{-\\frac{E_a}{RT_2}}\\;\\;=\\;(1884\\;\\mathrm M^{-1}\\mathrm s^{-1})\\;\\mathrm e^{\\frac{(-15,000\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}}})}{(8.314\\;{\\displaystyle\\frac{\\mathrm J}{\\mathrm{mol}\\;\\cdot\\mathrm K}})(298\\;\\mathrm K)}\\;\\;}\\;=\\;\\;4.42\\;\\mathrm M^{-1}\\mathrm s^{-1}",
