              },
              {
                "children": [
                  {
                    "text": "After reaction, total solution volume = 0.0250 L + 0.0350 L = 0.0600 L and:"
                  }
                ],
                "id": "t0p5qwhr1ilr1pk",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "bfn7vxavgyu8sg6",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "kcmi125hqrbpck7",
                "legacyBlockRendered": "true",
                "src": "\\lbrack\\mathrm{OH}^-\\rbrack=\\frac{0.00075\\;\\mathrm{mol}}{0.0600\\;\\mathrm L}=0.0125\\;\\mathrm M\\;\\;\\mathrm{and}\\;\\;\\lbrack\\mathrm{ClO}^-\\rbrack=\\frac{0.00625\\;\\mathrm{mol}}{0.0600\\;\\mathrm L}=0.104\\;\\mathrm M",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "OCl"
                  },
                  {
                    "sup": true,
                    "text": "–"
                  },
                  {
                    "text": " undergoes a base-dissociation reaction, but the OH"
                  },
                  {
                    "sup": true,
                    "text": "–"
                  },
                  {
                    "text": " produced from this reaction is negligible compared to the amount of hydroxide added after the equivalence point. The pH of the solution depends only on the concentration of hydroxide added after the equivalence point:"
                  }
                ],
                "id": "xadcndxkihqux16",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "qg5sgcz463lbf7j",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ey6vyqhv53hpxrm",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{c}\\mathrm{pOH}\\;=\\;-\\log\\lbrack\\mathrm{OH}^-\\rbrack\\;=\\;-\\log(0.0125)\\; =\\;1.903\\;\\\\\\mathrm{pH}\\;=\\;14.00\\;-\\;\\mathrm{pOH}\\;=\\;14.00\\;-\\;1.903\\;=\\;12.10\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "4132314066",
                "type": "p"
