              "children": [],
              "expression": "// Two variable definitions\nconst timeIndex = OLI.random(0 ,4);\nconst array = [150, 250, 350, 450, 550] ;\nconst time = array[timeIndex] .toFixed(0); \nconst initialConc = OLI.random(1.15,6.55,2);\nconst logInitialConc = Math.log(initialConc);\nconst kt = ((-0.00342*time)+logInitialConc);\nconst ktRnd = (kt) .toPrecision(3);\nconst correct = Math.exp(kt);\nconst corLow = correct*0.97;\nconst corHigh = correct*1.03;\nconst corRound = correct .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\n \n  timeIndex,\n  array,\n  time,\n  initialConc,\n  logInitialConc,\n  kt,\n  ktRnd,\n  correct,\n  corLow,\n  corHigh,\n  corRound\n  \n  \n};\n",
