              "expression": "// Two variable definitions\nconst initial_conc = [0.100, 0.125, 0.150, 0.175, 0.2, 0.225, 0.250, 0.275, 0.3];\n\nconst count = OLI.random(0,8);\nconst conc = initial_conc[count] .toPrecision(3);\n\nconst hconc = OLI.random(0.0001, 0.005, 5);\nconst hconcsf = hconc .toPrecision(3);\nconst ka = hconc**2/(conc-hconc);\nconst kasf = ka .toPrecision(3);\nconst kalow = 0.98*ka;\nconst kahigh = 1.02*ka;\n\nfunction numberOfZeros(n) {\n  var c = 0;\n  while (!~~n) {\n    c++;\n    n *= 10;\n  }\n  return c - 1;\n}\n\nconst num = numberOfZeros(ka);\n\nconst exp = num +1;\nconst dec = ka*10**(exp) .toPrecision(3);\nconst d = dec .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\ncount, conc, hconc, hconcsf, ka, kasf, kalow, kahigh, num, exp, dec, d\n};\n",
