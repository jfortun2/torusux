                    ],
                    "legacyBlockRendered": true,
                    "src": "\\begin{array}{l}\\begin{array}{l}\\Delta m\\;=\\;235.8765\\;\\mathrm{amu}\\;-\\;236.0526\\;\\mathrm{amu}\\;=\\;-\\;0.1761\\;\\mathrm{amu}\\\\\\mathrm{Then}:\\;\\;\\;\\Delta E\\; =\\;m\\cdot c^2\\;\\\\=\\;(-\\;0.1761\\;\\mathrm{amu})\\cdot(\\frac{1.6606\\times10^{-27}\\;\\mathrm{kg}}{1\\;\\mathrm{amu}})\\cdot{(2.9979\\times10^8\\;\\frac{\\mathrm m}{\\mathrm s})}^2 \\cdot\\left(\\frac{1\\;\\mathrm J}{\\displaystyle\\frac{\\mathrm{kg}\\cdot\\mathrm m^2}{\\mathrm s^2}}\\right)\\\\=-\\;2.628\\;\\mathrm x10^{-11}\\;\\mathrm J\\;\\;\\;\\mathrm{for}\\;\\mathrm{one}\\; {}^{235}\\mathrm U\\\\\\mathrm{Finally}:\\;\\;\\left(-\\;2.628\\times10^{-11}\\;\\frac{\\mathrm J}{1\\;{}^{235}\\mathrm U}\\right)\\cdot\\left(\\frac{1\\;\\mathrm{kJ}}{1000\\;\\mathrm J} \\right)\\cdot\\left(\\frac{6.022\\times10^{23}\\;}{\\mathrm{mol}}\\right)\\end{array}\\\\=\\;-\\;1.583\\times10^{10}\\;\\frac{\\mathrm{kJ}}{\\mathrm{mol}\\;{}^{235}\\mathrm U\\;}\\\\\\;\\end{array}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  }
                ],
                "id": "p5q3vwwrdt1jud6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Note: The negative sign indicates that this nuclear fission reaction is exothermic."
