                    "strong": true,
                    "text": "Solution"
                  }
                ],
                "id": "wrxhfvdti4wup19",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "In the reaction as written, Pb is oxidized and Ni"
                  },
                  {
                    "sup": true,
                    "text": "2+"
                  },
                  {
                    "text": " is reduced. First use the standard reduction potentials for the half-reactions to determine the standard cell potential:"
                  }
                ],
                "id": "76i466hcr26bgwr",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "7dqk8jlnhiw8tv2",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "v2dk3tej7khjpk9",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{oxidation}:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\mathrm{Pb}(s)\\;\\rightarrow\\; \\mathrm{Pb}^{2+}(aq)\\;+\\;2\\;\\mathrm e^-\\;\\;\\;\\;\\;\\;E^\\circ\\;=\\;+0.126\\;\\mathrm V\\\\\\underline{\\mathrm{reduction}: \\;\\;\\;\\;\\mathrm{Ni}^{2+}(aq)\\;+\\;2\\;\\mathrm e^-\\;\\rightarrow\\;\\mathrm{Ni}(\\mathrm s)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; \\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;E^\\circ\\;=\\;-0.257\\;\\mathrm V}\\\\\\mathrm{overall}:\\;\\;\\;\\;\\;\\;\\;\\mathrm{Pb}(s)\\;+\\;\\mathrm{Ni}^{2+}(aq) \\;\\rightarrow\\;\\mathrm{Pb}^{2+}(aq)\\;+\\;\\mathrm{Ni}(s)\\;\\;\\;\\;\\;E^\\circ\\;=\\;-0.131\\;\\mathrm V\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Then calculate Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": "°:"
                  }
                ],
                "id": "wkss8k4knm05kvm",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "xpnbz60oz85lf2a",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "5ja4ydkw7uzxwmf",
                "legacyBlockRendered": "true",
                "src": "\\triangle G^\\circ\\;=\\;-nFE^\\circ\\;=\\;-(2\\;\\mathrm{mol})\\left(96,485\\;{\\textstyle\\textstyle\\dfrac{\\mathrm J} {\\mathrm V\\cdot\\mathrm{mol}}}\\right)\\left(\\frac{1\\;\\mathrm{kJ}}{1000\\;\\mathrm J}\\right)(-0.131\\;\\mathrm V)\\; =\\;25.3\\;\\mathrm{kJ}",
                "subtype": "latex",
