              "children": [],
              "expression": "// Two variable definitions\nconst m = OLI.random(0.1,5,2) .toFixed(3);\nconst mass2Mol = (m/40) .toPrecision(4);\nconst array = [100.0, 150.0, 200.0, 250.0, 300.0, 250.0, 400.0, 450.0, 500.0];\nconst rand = OLI.random(0,8);\nconst vol = array[rand] .toPrecision(4);\nconst volInLiter = (vol/1000) .toPrecision(3);\nconst conc = (m/40/vol*1000) .toPrecision(3);\nconst pOH = -Math.log10(conc) .toPrecision(4);\nconst pH = 14 - pOH .toPrecision(3);\nconst pHlow = 0.98*pH;\nconst pHhigh = 1.02*pH;\n// Expose variables to OLI\nmodule.exports = {\n  m,\n  mass2Mol,\n  volInLiter,\n  array,\n  rand,\n  vol,\n  conc,\n  pOH,\n  pH,\n  pHlow,\n  pHhigh\n};\n",
