                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Ag}^+\\rbrack^2\\lbrack\\mathrm{CO}_3^{2-}\\rbrack\\;=\\;(2x)^2(x)\\; =\\;8.1\\times10^{-12}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "(2x)^2(x)\\;=\\;4x^3\\;=\\;8.1\\times10^{-12}\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\; x\\;=\\;\\sqrt[3]{\\frac{8.1\\times10^{-12}}4}\\;\\;=\\;1.3\\times10^{-4}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "The molar solubility of Ag"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "CO"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": " is 1.3 × 10"
                  },
                  {
                    "sup": true,
                    "text": "–4"
                  },
                  {
                    "text": " M."
                  }
                ],
