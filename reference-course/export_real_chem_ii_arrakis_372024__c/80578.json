            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "A solid piece of KOH containing 0.020 mol is added to 1.0 liter of a buffer solution that is 0.25 M acetic acid and 0.15 M sodium acetate. Calculate the pH of the resulting solution."
                  }
                ],
                "id": "rygpl974gfgw2bq",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Note that this is the same buffer solution has been used in the previous example. We calculated the pH to be 4.52."
                  }
                ],
                "id": "yonmrnp6webl1q9",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "sie7rev92ws46a6",
                        "strong": true,
                        "text": "Use stoichiometry to determine the changes resulting from the addition of the strong base."
                      }
                    ],
                    "id": "o7ikcc17g2q21zm",
                    "type": "li"
                  }
                ],
                "id": "aszivxqbydj7h8p",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "id": "gixh5gjn549gls0",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "l5gg2g3icv9imzj",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{OH}^-\\;+\\:{\\mathrm{HC}}_2{\\mathrm H}_3{\\mathrm O}_2\\;\\;\\rightarrow\\;\\;{\\mathrm H}_2\\mathrm O\\;+\\;{\\mathrm C}_2{\\mathrm H}_3{\\mathrm O}_2^-",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Recognizing that there is a 1:1 molar ratio between all species in the reaction, the addition of 0.020 mol of OH"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " will consume 0.020 mol of HC"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " and produce 0.020 mol of C"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": ". Resulting in the following concentrations:"
                  }
                ],
                "id": "5lyw1t42n57xm43",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "6ir5tjez2p037vc",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "l2m4l4qm7pmcdig",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\lbrack{\\mathrm{HC}}_2{\\mathrm H}_3{\\mathrm O}_2\\rbrack\\;=\\;0.25\\;\\mathrm{mol}\\;-\\;0.020\\;\\mathrm{mol}\\;=\\;0.23\\;\\mathrm{mol}\\\\\\lbrack{\\mathrm C}_2{\\mathrm H}_3{\\mathrm O}_2^-\\rbrack\\;=\\;0.15\\;\\mathrm{mol}\\;+\\;0.020\\;\\mathrm{mol}\\;=\\;0.17\\;\\mathrm{mol}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "dcg62mr0635r33g",
                        "strong": true,
                        "text": "Solve the equilibrium problem with the adjusted initial concentrations."
                      }
                    ],
                    "id": "gzriihmcggapw85",
                    "type": "li"
                  }
                ],
                "id": "b0tsqi39i76a0pl",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "text": "Using the Henderson-Hasselbalch Equation:"
                  }
                ],
                "id": "2j13d8kssjz8q03",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "32z420gukyx3tx0",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ovifxzoxaibg1n3",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm pK_{\\mathit a}\\mathit\\;\\mathit=\\;-\\log K_{\\mathit a}\\\\\\mathrm pK_{\\mathit a}\\mathit\\;\\mathit=\\mathit\\;\\mathit-\\log\\mathit\\;(1.8\\times10^{-5})\\;=\\;4.745\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "8ufitu7iellm82j",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "bafjt86hg3lfylq",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{pH}\\;=\\;4.745\\;+\\;\\log\\;\\frac{\\lbrack\\mathrm{base}\\rbrack}{\\lbrack\\mathrm{acid}\\rbrack}\\\\\\mathrm{pH}\\;=\\;4.745\\;+\\;\\log\\;\\frac{(0.17)}{(0.23)}\\\\\\mathrm{pH}\\;=\\;4.61\\end{array}",
                "subtype": "latex",
                "type": "formula"
              }
            ],
            "id": "3804778309",
            "selection": {
              "anchor": {
                "offset": 0,
                "path": [
                  0,
                  0
                ]
              },
              "focus": {
                "offset": 0,
                "path": [
                  1,
                  0
                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "3813208719",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Calculate the pH after 5.0 mL of 0.10 M NaOH is added to 100 mL of a buffer solution of 0.60 M nitrous acid (HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ") and 0.40 M sodium nitrite (NaNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": "). Note the final volume of the solution will be 105 mL."
                  }
                ],
                "id": "scf8lasc7xu0ct1",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "We will use the same two steps to solve this problem. The only difference here is that the stoichiometry is a bit more complex."
                  }
                ],
                "id": "yrlqp70klrakc62",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "The major species in the buffer solution are:"
                  }
                ],
                "id": "ec7x2yxuekvqppf",
                "type": "p"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "text": "HNO"
                      },
                      {
                        "sub": true,
                        "text": "2"
                      },
                      {
                        "text": ",    NO"
                      },
                      {
                        "sub": true,
                        "text": "2"
                      },
                      {
                        "sup": true,
                        "text": "-"
                      },
                      {
                        "text": ",    Na"
                      },
                      {
                        "sup": true,
                        "text": "+"
                      },
                      {
                        "text": ",    and H"
                      },
                      {
                        "sub": true,
                        "text": "2"
                      },
                      {
                        "text": "O"
                      }
                    ],
                    "id": "ezku6g1k7z51ye9",
                    "type": "p"
                  }
                ],
                "id": "sqtecvabc8p7dnt",
                "type": "callout"
              },
              {
                "children": [
                  {
                    "text": "When the NaOH is added OH"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " will react with the weak acid, HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ", according to the following equation:"
                  }
                ],
                "id": "nw1ymaj0pipud9f",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "shgomk9h5x80hun",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "vrz3nq3sgvu7wfp",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{OH}^-\\;+\\;{\\mathrm{HNO}}_2\\;\\;\\rightarrow\\;\\;{\\mathrm H}_2\\mathrm O\\;+\\;{\\mathrm{NO}}_2^-",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "6gtlk89m8lopw20",
                        "strong": true,
                        "text": "Use stoichiometry to determine the changes resulting from the addition of the strong base."
                      }
                    ],
                    "id": "etg1dbwe7l3zh6a",
                    "type": "li"
                  }
                ],
                "id": "41x3j7ckr7a580q",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "text": "Convert amount of base added to moles."
                  }
                ],
                "id": "wxapaim1kcj6tld",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "iz93rjx8ph6aoz6",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "86kntt55wkyg0s4",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}0.0050\\;\\mathrm L\\;\\times\\;\\frac{0.10\\mathrm{mol}\\;\\mathrm{OH}^-}{1\\mathrm L}\\;=\\;5.0\\times10^{-4}\\;\\mathrm{mol}\\;\\mathrm{OH}^-\\;\\\\\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Recognizing that there is a 1:1 molar ratio between all species in the reaction, the addition of 0.00050 mol of OH"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " will consume 0.00050 mol of HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " and produce 0.00050 mol of NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": "."
                  }
                ],
                "id": "kbl5wxa3397rbor",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "To determine the change in the amounts of HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " and NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": ", these amounts must also be converted to moles."
                  }
                ],
                "id": "0l8zeavjmhdzodi",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "l6n0zinnytnkhle",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "qje181ne3sq8spq",
                "legacyBlockRendered": "true",
                "src": "0.60\\;{\\textstyle\\frac{\\mathrm{mol}}{\\mathrm L}}\\;\\times\\;0.100\\;\\mathrm L\\;=\\;0.060\\;\\mathrm{mol}\\;{\\mathrm{HNO}}_2",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "ikhaqm3sndtucvq",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "4mt68purvpvluts",
                "legacyBlockRendered": "true",
                "src": "0.40\\;{\\textstyle\\frac{\\mathrm{mol}}{\\mathrm L}}\\;\\times\\;0.100\\;\\mathrm L\\;=\\;0.04\\;\\mathrm{mol}\\;{\\mathrm{NO}}_2^-",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Calculate the amounts of HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " and NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " after the OH"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " has completely reacted."
                  }
                ],
                "id": "swstn8nib1eduk6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "6kxhdd3evggd4yu",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "omz2ys1o1onbrk6",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}{\\mathrm{HNO}}_2\\;=\\;0.060\\;\\mathrm{mol}\\;-\\;0.005\\;\\mathrm{mol}\\;=\\;0.055\\;\\mathrm{mol}\\\\{\\mathrm{NO}}_2^-\\;=\\;0.040\\;\\mathrm{mol}\\;+\\;0.005\\;\\mathrm{mol}\\;=\\;0.045\\;\\mathrm{mol}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "bar0ag3qf6wnojn",
                        "strong": true,
                        "text": "Solve the equilibrium problem with the adjusted initial concentrations."
                      }
                    ],
                    "id": "ypsqmqchr9klhdr",
                    "type": "li"
                  }
                ],
                "id": "awj6o61wds22x5w",
                "type": "ul"
              },
              {
                "children": [
                  {
                    "text": "Using the Henderson-Hasselbalch Equation:"
                  }
                ],
                "id": "iitv7tqhrclsn4j",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "nwohr07et0cwnoz",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "klxml52phpmge24",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{pH}\\;=\\;\\mathrm pK_{\\mathit a}\\;+\\;\\log\\;\\frac{\\mathrm{base}}{\\mathrm{acid}}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Note that you may use either concentration of HNO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " and NO"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "sup": true,
                    "text": "-"
                  },
                  {
                    "text": " (in which case you would need to calculate the concentrations using the new mole values and the new volume, 101 mL) or number of moles for either method of calculating pH."
                  }
                ],
                "id": "njhrefu4bji3f5w",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "p6hvctbmho0rj5b",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "zkvssuxhdvd6d65",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}K_a\\;({\\mathrm{HNO}}_2)\\;=\\;4.6\\times10^{-4}\\\\\\mathrm pK_a\\;=\\;-\\log\\;K_a\\\\\\mathrm pK_a\\;=\\;-\\log(4.6\\times10^{-4})\\;=\\;3.337\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "shtr9vy0trz9tfm",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "jc6t4xhnhbrrwxi",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{pH}\\;=\\;3.337\\;+\\;\\log\\frac{0.045}{0.055}\\;=\\;3.25",
                "subtype": "latex",
                "type": "formula"
              }
            ],
            "id": "1942193380",
