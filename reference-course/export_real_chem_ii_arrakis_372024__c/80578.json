        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "A buffer solution is prepared from equal volumes of 0.200 M acetic acid and 0.600 M sodium acetate. Use 1.80 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−5"
                  },
                  {
                    "text": " as "
                  },
