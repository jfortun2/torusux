              "children": [],
              "expression": "// Two variable definitions\nconst k = OLI.random(0.0155,0.0955,4) .toFixed(4);\nconst initialRateIndex = OLI.random(0 ,3);\nconst array = [0.600, 0.700, 0.800, 0.900] ;\nconst initialRate = array[initialRateIndex] .toFixed(3); \nconst finalRate = OLI.random(0.115,0.455,3);\nconst corSt1 = Math.log(initialRate/finalRate);\nconst correct = (corSt1/k) .toPrecision(3);\nconst corLow = correct*0.99;\nconst corHigh = correct*1.01;\n// Expose variables to OLI\nmodule.exports = {\n  k,\n  initialRateIndex,\n  initialRate,\n  finalRate,\n  corSt1,\n  correct,\n  corLow,\n  corHigh\n  \n};\n",
