  "content": {
    "authoring": {
      "parts": [
        {
          "explanation": {
            "content": [
              {
                "children": [
                  {
                    "text": "Incorrect."
                  }
                ],
                "id": "a25zlwacmx65j6r",
                "type": "p"
              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Solution"
                  }
                ],
                "id": "v755dnghdllygf6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Use the ideal gas law to calculate the initial pressures, then set up an ICE table. Since "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "p"
                  },
                  {
                    "text": " is very small, the reaction will go almost completely to the left, with Y"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " as the limiting reactant."
                  }
                ],
                "id": "9ya9ykfiopp2jl6",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "2dolpeor7co37lk",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "rwv7mu557psb2jr",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;2\\;{\\mathrm{XY}}_3\\;\\;\\;\\;\\;\\;\\rightleftharpoons\\;\\;\\;\\;\\;\\;\\;\\;\\; {\\mathrm X}_2\\;\\;\\;\\;\\;\\;\\;\\;\\;+\\;\\;\\;\\;\\;\\;\\;3\\;{\\mathrm Y}_2\\;\\;\\;\\;\\;\\;\\;\\\\\\mathrm I:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; 0\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;1.00\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;1.50\\;\\mathrm{atm}\\\\\\mathrm C: \\;\\;\\;\\;+1.00\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;-0.500\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;-1.50\\;\\;\\\\\\mathrm E:\\;\\;\\;\\; 1.00\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;0.50\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\sim0\\;\\rightarrow\\;x\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Set up the equilibrium constant expression and solve for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": "."
                  }
                ],
                "id": "29u1dseapw10g5t",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "h8cpwkaeintq9jg",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "p738rzmdxxvlzoo",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm p}\\;=\\;\\frac{\\left(P_{{\\mathrm X}_2}\\right)\\left(P_{{\\mathrm Y}_2}\\right)^3}{\\left(P_{{\\mathrm{XY}}_3} \\right)^2}\\;=\\;\\frac{\\left(0.50\\right)\\left(x\\right)^3}{\\left(1.00\\right)^2}\\;=\\;1.89\\times10^{-9}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "a7w5r653898ccam",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "jtby5ka4ury9tao",
                "legacyBlockRendered": "true",
                "src": "x\\;=\\;\\sqrt[3]{\\frac{\\left(1.00\\right)^2\\left(1.89\\times10^{-9}\\right)}{\\left(0.50\\right)}}\\;=\\;0.0016\\;\\mathrm{atm}",
                "subtype": "latex",
