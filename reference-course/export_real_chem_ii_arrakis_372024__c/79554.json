              "children": [],
              "expression": "// Two variable definitions\nconst c = [3e-3, 3e-2, 4e-2, 4e-3,  1e-3, 5e-3, 1e-2];\nconst conc = OLI.randomArrayItem(c) .toPrecision(3);\nconst conc_br = ((6.6e-6/conc)**0.5) .toPrecision(3);\n\nconst conc_ag = (5.35e-13/conc_br) .toPrecision(3);\nconst low = 0.95*conc_ag;\nconst high=1.05*conc_ag;\n// Expose variables to OLI\nmodule.exports = {\n  c, conc, conc_br, conc_ag, low, high\n};\n",
              "id": "e12f7a54570c4423ac36ec67c9a0fc31",
