                    "id": "easm7juvq8bvvjt",
                    "legacyBlockRendered": "true",
                    "src": "\\lbrack\\mathrm{Ag}^+\\rbrack\\;=\\;\\frac{{\\mathrm K}_{\\mathrm{sp}}}{\\;\\lbrack\\mathrm{Br}^-\\rbrack}\\; =\\;\\frac{5.35\\times10^{-13}}{@@conc_br@@\\;\\mathrm M}\\;=\\;@@conc_ag@@\\;\\mathrm M",
