                "src": "{\\mathrm{PbBr}}_2(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Pb}^{2+}(aq)\\;+\\;2\\;\\mathrm{Br}^-(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; K_{\\mathrm{sp}}\\;=\\;\\lbrack\\mathrm{Pb}^{2+}\\rbrack\\lbrack\\mathrm{Br}^-\\rbrack\\;=\\;6.60\\times10^{-6}",
