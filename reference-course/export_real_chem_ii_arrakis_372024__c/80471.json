          "data": [
            {
              "expression": "// Two variable definitions\nconst amps1 = OLI.random(2.80, 6.50,2) .toFixed(2);\nconst time = OLI.random(65,95,1);\nconst timeS = (time*60);\nconst amps1TimesTime = (amps1*timeS);\nconst moleE = (amps1TimesTime/96485);\nconst massCr = ((moleE/3)*51.996) .toPrecision(3);\nconst massCrLow = massCr*0.98;\nconst massCrHigh = massCr*1.02;\n\nconst amps2 = OLI.random(12.0,18.0,1) .toFixed(1);\nconst mass = OLI.random(18, 55, 1);\nconst molCr = (mass/51.996);\nconst Q = (molCr*3*96485);\nconst correct = ((Q/amps2)/3600) .toPrecision(3);\nconst correctLow = (correct*0.98);\nconst correctHigh = (correct*1.02)\n\n\n// Expose variables to OLI\nmodule.exports = {\n  amps1,\n  time,\n  timeS,\n  amps1TimesTime,\n  moleE,\n  massCr,\n  massCrLow,\n  massCrHigh,\n\n  amps2,\n  mass,\n  molCr,\n  Q,\n  correct,\n  correctLow,\n  correctHigh\n};\n",
