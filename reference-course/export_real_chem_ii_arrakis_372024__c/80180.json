              "expression": "const v = [500, 750, 1000, 1250, 1500];\nconst vol = OLI.randomArrayItem(v);\n\nconst c = [0.1, .15, .2, .25, .3, .35, .4, .45, .5];\nconst conc = OLI.randomArrayItem(c) .toPrecision(3);\n\nconst ksp_1 = 8.5e-11; // barium chromate\nconst ksp_2 = 2.3e-8; // barium sulfate\nconst ba_1 = (ksp_1/conc) .toPrecision(2);\nconst ba_2 = ksp_2/conc;\n\nconst low = 0.95*ba_1;\nconst high = 1.05*ba_1;\n\n// Expose variables to OLI\nmodule.exports = {\n  vol, conc, ba_1, ba_2, low, high\n};\n",
