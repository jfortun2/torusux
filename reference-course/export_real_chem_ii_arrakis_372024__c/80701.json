      },
      {
        "children": [
          {
            "children": [
              {
                "id": "ukd9rze1ofiq1w2",
                "text": "Calculation of Hydronium Ion Concentration from pH"
              }
            ],
            "id": "9p8y2azvogpeb11",
            "type": "h2"
          }
        ],
        "id": "2205809330",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
              0
            ]
          },
          "focus": {
            "offset": 0,
            "path": [
              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Calculate the hydronium ion concentration in blood, which has a pH of 7.3 (slightly alkaline)."
                  }
                ],
                "id": "pthlzxw9pcjvqx9",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "When pH is given and we need to determine [H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "], we also apply the equation defining pH:"
                  }
                ],
                "id": "9qkyrs75s6gl3a7",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "1i0mke3cdoxyxtc",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "ndnx08vfcedkvpp",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{c}\\mathrm{pH}\\;=-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;7.3\\\\\\Rightarrow\\;\\;\\;\\; \\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;-7.3\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "To calculate [H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "], we need to take the "
                  },
                  {
                    "em": true,
                    "text": "antilogarithm"
                  },
                  {
                    "text": ", or inverse logarithm, of  −7.3:"
                  }
                ],
                "id": "wm6u3tt4m7jwv5h",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "edjo5y6ucbnryug",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "945c4ifsuuxn0qh",
                "legacyBlockRendered": "true",
                "src": "\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;\\mathrm{antilog}(-7.3)\\;=\\;10^{-7.3}\\; =\\;5\\times10^{-8}\\;\\mathrm M",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "(On your calculator, the antilog or inverse log may show as 10"
                  },
                  {
                    "em": true,
                    "sup": true,
                    "text": "x"
                  },
                  {
                    "text": " or INV log.)"
                  }
                ],
                "id": "goc6vob2ocb142s",
                "type": "p"
              }
            ],
            "id": "3608107322",
            "selection": {
              "anchor": {
                "offset": 0,
                "path": [
                  0,
                  0
                ]
              },
              "focus": {
                "offset": 0,
                "path": [
                  1,
                  0
                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "746647211",
        "layout": "vertical",
