      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "What is the pH of stomach acid, a solution of HCl with a hydronium ion concentration of 1.2 × 10"
                  },
                  {
                    "sup": true,
                    "text": "−3"
                  },
                  {
                    "text": " M?"
                  }
                ],
                "id": "9srsna5oaj7ap96",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "When [H"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "O"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "] is given, pH can be calculated directly from the equation defining pH. In this case, we have:"
                  }
                ],
                "id": "6w2ckenjme2c45t",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "5swzrmu533i23uv",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "878eekpg5bozzt8",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{pH}=-\\log\\lbrack{\\mathrm H}_3\\mathrm O^+\\rbrack\\;=\\;-\\log(1.2\\times10^{-3})\\;=-(-2.92)\\; =\\;2.92",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": ""
                  }
                ],
                "id": "2611487780",
                "type": "p"
              }
            ],
            "id": "3373029647",
