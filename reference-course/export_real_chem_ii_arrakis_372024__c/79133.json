              "expression": "// Two variable definitions\n\nconst initial_conc = [0.100, 0.125, 0.150, 0.175, 0.2, 0.225, 0.250, 0.275, 0.3];\n\nconst count = OLI.random(0,8);\nconst conc = initial_conc[count] .toPrecision(3);\n\nconst d = OLI.random(1,9.99,2);\nconst dsf = d .toPrecision(3);\nconst e = OLI.random(-9,-5,0);\nconst ka = d*10**e;\nconst h = Math.sqrt(conc*ka) .toPrecision(3);\nconst ph = -Math.log10(h);\nconst phsf = ph .toPrecision(4);\n\nconst phlow = 0.98*ph;\nconst phhigh = 1.02*ph;\nconst check = h*h/(conc-h);\nconst checksf = check .toPrecision(3);\n\n// Expose variables to OLI\nmodule.exports = {\n  conc, d, dsf, e, ka, h, ph, phsf, phlow, phhigh, checksf\n};\n",
