        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Dinitrogen pentoxide decomposes according to:"
                  }
                ],
                "id": "97zdiar6y1v094h",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "1xe4k2koyy3dii0",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "m3smrkaj2n53shk",
                "legacyBlockRendered": "true",
                "src": "2\\;{\\mathrm N}_2{\\mathrm O}_5\\;\\;\\longrightarrow\\;\\;4\\;{\\mathrm{NO}}_2\\;+\\;{\\mathrm O}_2",
                "subtype": "latex",
                "type": "formula"
              },
              {
