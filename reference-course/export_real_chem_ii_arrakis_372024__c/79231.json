                "legacyBlockRendered": "true",
                "src": "\\triangle G^\\circ\\;=\\;-nFE^\\circ\\;=\\;-(2\\;\\mathrm{mol})\\left(96,485\\;{\\textstyle\\dfrac{\\mathrm J} {\\mathrm V\\cdot\\mathrm{mol}}}\\right)\\left(\\frac{1\\;\\mathrm{kJ}}{1000\\;\\mathrm J}\\right)(-1.24\\;\\mathrm V)\\; =\\;241\\;\\mathrm{kJ}",
