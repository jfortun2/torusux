                "id": "4tl9msvuefww9io",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "l9gw11wt58y8zqg",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "gesstgbgh7hilil",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm{oxidation}:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;2\\;\\mathrm{Ag}(s)\\;\\rightarrow\\; 2\\;\\mathrm{Ag}^+(aq)\\;+\\;2\\;\\mathrm e^-\\;\\;\\;\\;\\;\\;E^\\circ\\;=\\;-0.800\\;\\mathrm V\\\\\\underline{\\mathrm{reduction}: \\;\\;\\;\\;\\;\\mathrm{Fe}^{2+}(aq)\\;+\\;2\\;\\mathrm e^-\\;\\rightarrow\\;\\mathrm{Fe}(\\mathrm s)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; \\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;E^\\circ\\;=\\;-0.447\\;\\mathrm V}\\\\\\mathrm{overall}:\\;\\;\\;\\;\\;2\\;\\mathrm{Ag}(s)\\; +\\;\\mathrm{Fe}^{2+}(aq)\\;\\rightarrow\\;2\\:\\mathrm{Ag}^+(aq)\\;+\\;\\mathrm{Fe}(s)\\;\\;\\;\\;\\;E^\\circ\\; =\\;-1.247\\;\\mathrm V\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Then calculate Δ"
                  },
                  {
                    "em": true,
                    "text": "G"
                  },
                  {
                    "text": "°:"
                  }
                ],
                "id": "unod0tx2ddexnbk",
