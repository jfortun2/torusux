            "id": "dg2tn0fmjmbpln8",
            "legacyBlockRendered": "true",
            "src": "\\begin{array}{l}\\mathrm{Fe}({\\mathrm H}_2\\mathrm O)_6^{3+}(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm H}_3\\mathrm O^+(aq)\\;+\\;\\mathrm{Fe}({\\mathrm H}_2\\mathrm O)_5(\\mathrm{OH})^{2+}(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_a\\;=\\;1.8\\times10^{-3}\\;\\;\\;\\\\\\mathrm{Cu}({\\mathrm H}_2\\mathrm O)_6^{2+}(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm H}_3\\mathrm O^+(aq)\\;+\\;\\mathrm{Cu}({\\mathrm H}_2\\mathrm O)_5(\\mathrm{OH})^+(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_a\\mathit\\;=\\;5.0\\times10^{-7}\\;\\\\\\mathrm{Zn}({\\mathrm H}_2\\mathrm O)_4^{2+}(aq)\\;+\\;{\\mathrm H}_2\\mathrm O(l)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm H}_3\\mathrm O^+(aq)\\;+\\;\\mathrm{Zn}({\\mathrm H}_2\\mathrm O)_3(\\mathrm{OH})^+(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K_a\\;=\\;2.5\\times10^{-10}\\end{array}",
            "subtype": "latex",
