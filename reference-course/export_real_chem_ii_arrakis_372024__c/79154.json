              },
              {
                "children": [
                  {
                    "strong": true,
                    "text": "Solution"
                  }
                ],
                "id": "po2aijku3df8xnq",
                "type": "p"
              },
              {
                "children": [
                  {
                    "text": "Use the ideal gas law to calculate the initial pressures, then set up an ICE table. Since "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "sub": true,
                    "text": "p"
                  },
                  {
                    "text": " is very small, the reaction will go almost completely to the left, with Y"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": " as the limiting reactant."
                  }
                ],
                "id": "brbrtkgjnv7pn92",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "k531hx5o7ee1qvf",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "kxwjh33b344whgd",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;2\\;{\\mathrm{XY}}_3\\;\\;\\;\\;\\;\\;\\rightleftharpoons\\;\\;\\;\\;\\;\\;\\;\\;\\; {\\mathrm X}_2\\;\\;\\;\\;\\;\\;\\;\\;\\;+\\;\\;\\;\\;\\;\\;\\;3\\;{\\mathrm Y}_2\\;\\;\\;\\;\\;\\;\\;\\\\\\mathrm I:\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\; 0\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;1.20\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;1.80\\;\\mathrm{atm}\\\\\\mathrm C: \\;\\;\\;\\;+1.20\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;-0.600\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;-1.80\\;\\;\\\\\\mathrm E:\\;\\;\\;\\; 1.20\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;0.60\\;\\mathrm{atm}\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;\\sim0\\;\\rightarrow\\;x\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "Set up the equilibrium constant expression and solve for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": "."
                  }
                ],
                "id": "fcuvjdidj786tbk",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "zv6c1q4gb1jcw84",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "i3ek4tulndfzzqb",
                "legacyBlockRendered": "true",
                "src": "K_{\\mathrm p}\\;=\\;\\frac{\\left(P_{{\\mathrm X}_2}\\right)\\left(P_{{\\mathrm Y}_2}\\right)^3}{\\left(P_{{\\mathrm{XY}}_3}\\right)^2}\\;=\\;\\frac{\\left(0.60\\right)\\left(x\\right)^3}{\\left(1.20\\right)^2}\\;=\\;8.19\\times10^{-8}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "id": "qz2bq1fyzr1k4mp",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "vlki9tz4z8elycw",
                "legacyBlockRendered": "true",
                "src": "x\\;=\\;\\sqrt[3]{\\frac{\\left(1.20\\right)^2\\left(8.19\\times10^{-8}\\right)}{\\left(0.60\\right)}}\\;=\\;0.0058\\;\\mathrm{atm}",
