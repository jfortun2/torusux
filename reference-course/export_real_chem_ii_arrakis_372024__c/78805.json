                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "K_{\\mathrm b}\\;=\\;\\frac{\\lbrack\\mathrm{OH}^-\\rbrack\\lbrack{\\mathrm{NH}}_4^+\\rbrack}{\\lbrack{\\mathrm{NH}}_3\\rbrack}\\; =\\;\\frac{x\\;(0.55\\;-\\;x)}{(0.55\\;+\\;x)}\\;=\\;1.8\\times10^{-5}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": "Assuming "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " << [NH"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": "] and solving for "
                  },
                  {
                    "em": true,
                    "text": "x"
                  },
                  {
                    "text": " gives:"
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\frac{x(0.55)}{(0.55)}\\;=\\;1.8\\times10^{-5}\\;\\;\\;\\;\\;\\Rightarrow\\;\\;\\;\\;\\;x\\;=\\;\\lbrack\\mathrm{OH}^-\\rbrack\\; =\\;1.8\\times10^{-5}\\;\\mathrm M",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\frac{1.8\\times10^{-5}}{0.55}\\times100\\%\\;=\\;0.0033\\%,\\;\\mathrm{so}\\;\\mathrm{the}\\;\\mathrm{assumption} \\;\\mathrm{is}\\;\\mathrm{verified}",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
                  {
                    "text": ""
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": true,
                    "src": "\\mathrm{pH}\\;=\\;14.00\\;-\\;\\mathrm{pOH}\\;=\\;14.00\\;-\\;(-\\log(1.8\\times10^{-5}))\\;=\\;14.00\\;-\\;4.74\\;=\\;9.26",
                    "subtype": "latex",
                    "type": "formula_inline"
                  },
