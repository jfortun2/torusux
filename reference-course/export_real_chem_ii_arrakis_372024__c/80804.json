                  },
                  {
                    "text": ", 9.14 g of SbCl"
                  },
                  {
                    "sub": true,
                    "text": "3"
                  },
                  {
                    "text": ", and 2.84 g of Cl"
                  },
                  {
                    "sub": true,
                    "text": "2"
                  },
                  {
                    "text": ". Determine Δ"
                  },
