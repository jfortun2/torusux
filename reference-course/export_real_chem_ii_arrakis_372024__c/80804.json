                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "922132310",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "activity_id": 80221,
            "id": "507756789",
            "type": "activity-reference"
          }
        ],
        "id": "3594295813",
        "layout": "vertical",
        "purpose": "didigetthis",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "id": "a4i1mkyzg1zrbeb",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "1m849xb95fvlq0s",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/bf/bff5de076a20e3effebd4adc25b1b667/green_line.png",
            "type": "img"
          },
          {
            "children": [],
            "id": "brx7fghazyncyb6",
            "items": [
              {
                "children": [
                  {
                    "text": "Relationship Between ΔG"
                  },
                  {
                    "sup": true,
                    "text": "∘"
                  },
                  {
                    "text": " and "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "text": " at Equilibrium"
                  }
                ],
                "type": "dt"
              },
              {
                "children": [
                  {
                    "text": " "
                  },
                  {
                    "children": [
                      {
                        "text": "For a system at equilibrium, "
                      },
                      {
                        "em": true,
                        "text": "Q"
                      },
                      {
                        "text": " = "
                      },
                      {
                        "em": true,
                        "text": "K"
                      },
                      {
                        "text": " and Δ"
                      },
                      {
                        "em": true,
                        "text": "G"
                      },
                      {
                        "text": " = 0, and the previous equation may be written as"
                      }
                    ],
                    "type": "p"
                  },
                  {
                    "text": " "
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": "true",
                    "src": "0\\;=\\;\\mathrm\\Delta G^\\circ\\;+\\;RT\\;\\ln K\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;(at\\;equilibrium)",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "text": " "
                  },
                  {
                    "children": [
                      {
                        "text": " ",
                        "type": "text"
                      }
                    ],
                    "legacyBlockRendered": "true",
                    "src": "\\Delta G^\\circ\\;=\\;-RT\\;\\ln K\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;or\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K\\;=\\;e^{-\\frac{\\Delta G^\\circ}{RT}}",
                    "subtype": "latex",
                    "type": "formula"
                  },
                  {
                    "text": " "
                  }
                ],
                "type": "dd"
              }
            ],
            "type": "dl"
          },
          {
            "children": [
              {
                "id": "dom047dlswfggg0",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "fnoilcosdjpac3p",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/bf/bff5de076a20e3effebd4adc25b1b667/green_line.png",
            "type": "img"
          },
          {
            "children": [
              {
                "text": "This form of the equation provides a useful link between these two essential thermodynamic properties, and it can be used to derive equilibrium constants from standard free energy changes and vice versa. The relations between standard free energy changes and equilibrium constants are summarized in the table below."
              }
            ],
            "id": "piatour50wca9ra",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "n13rzeuomv4cg0k",
                "text": "Relations between Standard Free Energy Changes and Equilibrium Constants"
              }
            ],
            "id": "lmofag8pfqui8b1",
            "type": "h5"
          },
          {
            "children": [
              {
                "children": [
                  {
                    "children": [
                      {
                        "em": true,
                        "id": "rpx62o1zhim66fa",
                        "text": "K"
                      }
                    ],
                    "id": "i6iljh6jub7o628",
                    "type": "th"
                  },
                  {
                    "children": [
                      {
                        "id": "5dehf31lqix4eo3",
                        "text": "Δ"
                      },
                      {
                        "em": true,
                        "id": "t6uvmrrxsrn4eap",
                        "text": "G"
                      },
                      {
                        "id": "4vbbptdvikyu628",
                        "text": "°"
                      }
                    ],
                    "id": "8b9pzagqy3l7l70",
                    "type": "th"
                  },
                  {
                    "children": [
                      {
                        "id": "bfs0vu7e4iclszv",
                        "text": "Comments"
                      }
                    ],
                    "id": "dwtakpf8t7yqjz8",
                    "type": "th"
                  }
                ],
                "id": "790q48og323o411",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "zcda2o1163iux61",
                        "text": " > 1"
                      }
                    ],
                    "id": "07g3dnhcsiknp3x",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "9jrhok0z6673gtf",
                        "text": "< 0"
                      }
                    ],
                    "id": "mer0abw882v8ao5",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "4mai3g1f5h6fade",
                        "text": "Products are more abundant at equilibrium."
                      }
                    ],
                    "id": "4vkj8yizlapwnny",
                    "type": "td"
                  }
                ],
                "id": "nhohxyn2ciurv5d",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "5oe98m52wqq033j",
                        "text": "< 1"
                      }
                    ],
                    "id": "d4ffsmt3crnz1nx",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "lhqql0hsfvq5vtx",
                        "text": "> 0"
                      }
                    ],
                    "id": "diz8p6q26wv0xdm",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "8hjvyjqt9vgvql7",
                        "text": "Reactants are more abundant at equilibrium."
                      }
                    ],
                    "id": "ev3d76r9m4w970o",
                    "type": "td"
                  }
                ],
                "id": "bmph18ttczekey9",
                "type": "tr"
              },
              {
                "children": [
                  {
                    "children": [
                      {
                        "id": "e1ta74i8pv2szhl",
                        "text": " = 1"
                      }
                    ],
                    "id": "yw3mwzl9vnz0wvc",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "gylgzgsvqfn1u7n",
                        "text": "= 0"
                      }
                    ],
                    "id": "9jdt7dlxsz7m54i",
                    "type": "td"
                  },
                  {
                    "children": [
                      {
                        "id": "opa1gtz41efihr3",
                        "text": "Reactants and products are equally abundant at equilibrium."
                      }
                    ],
                    "id": "ns0n9952imfpkk3",
                    "type": "td"
                  }
                ],
                "id": "zfe9t6a93q84qww",
                "type": "tr"
              }
            ],
            "id": "sj90qq9eqw7bubs",
            "type": "table"
          },
          {
            "children": [
              {
                "text": "In the example below, we see how we can use standard free energies, Δ"
              },
              {
                "em": true,
                "text": "G"
              },
              {
                "text": "°, to calculate "
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "text": " at a given temperature."
              }
            ],
            "id": "tbukf9pyhkvja0o",
            "type": "p"
          }
        ],
        "id": "2416080625",
        "selection": {
          "anchor": {
            "offset": 0,
            "path": [
              0,
              0
            ]
          },
          "focus": {
            "offset": 0,
            "path": [
              1,
              0
            ]
          }
        },
        "type": "content"
      },
      {
        "children": [
          {
            "children": [
              {
                "children": [
                  {
                    "text": "Given that the standard free energies of formation of Ag"
                  },
                  {
                    "sup": true,
                    "text": "+"
                  },
                  {
                    "text": "(aq), Cl"
                  },
                  {
                    "sup": true,
                    "text": "−"
                  },
                  {
                    "text": "(aq), and AgCl(s) are 77.1 kJ/mol, −131.2 kJ/mol, and −109.8 kJ/mol, respectively, calculate the solubility product, "
                  },
                  {
                    "em": true,
                    "text": "K"
                  },
                  {
                    "text": ", for the reaction below."
                  }
                ],
                "id": "7q43k8qtnvasm6j",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "1hml6v7y7s90too",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "rr9of9dn52xzf7z",
                "legacyBlockRendered": "true",
                "src": "\\mathrm{AgCl}(s)\\;\\;\\rightleftharpoons\\;\\;\\mathrm{Ag}^+(aq)\\;+\\;\\mathrm{Cl}^-(aq)\\;\\;\\;\\;\\;\\;\\;\\;\\;\\;K=\\lbrack\\mathrm{Ag}^+\\rbrack\\lbrack\\mathrm{Cl}^-\\rbrack",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The standard free energy change for this reaction is first computed using standard free energies of formation for its reactants and products:"
                  }
                ],
                "id": "lx7waapqynw20kl",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "zf318npmrk71nub",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "wwactf4qcii6bs9",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}\\mathrm\\Delta G^\\circ=\\mathrm\\Delta G_{298}^o\\;=\\;\\lbrack\\mathrm\\Delta G_f^o(Ag^+(aq))\\;+\\;\\mathrm\\Delta G_f^o(Cl^-(aq))\\rbrack-\\lbrack\\mathrm\\Delta G_f^o(AgCl(s))\\rbrack\\\\=\\lbrack77.1\\;\\mathrm{kJ}/\\mathrm{mol}-131.2\\;\\mathrm{kJ}/\\mathrm{mol}\\rbrack-\\lbrack-109.8\\;kJ\\mathit/mol\\rbrack\\;=\\;55.7\\;\\mathrm{kJ}/\\mathrm{mol}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
                  {
                    "text": "The equilibrium constant for the reaction may then be derived from its standard free energy change: "
                  }
                ],
                "id": "im55c00pnbhk7kz",
                "type": "p"
              },
              {
                "children": [
                  {
                    "id": "m8j50togzs05eiz",
                    "text": " ",
                    "type": "text"
                  }
                ],
                "id": "rm4ca7f6gtygj7i",
                "legacyBlockRendered": "true",
                "src": "\\begin{array}{l}K\\;=\\;e^\\frac{-\\Delta G^\\circ}{RT}\\\\\\\\\\frac{-\\Delta G^\\circ}{RT}\\;=\\;-\\frac{55.7\\times10^3\\;\\mathrm J/\\mathrm{mol}}{8.314\\;\\mathrm J/\\mathrm{mol}⋅\\mathrm K\\;\\times\\;298.15\\;\\mathrm K}\\;=\\;-22.470\\\\\\\\\\mathrm K\\;=\\;e^{-22.470}\\;=\\;1.74\\times10^{-10}\\end{array}",
                "subtype": "latex",
                "type": "formula"
              }
            ],
            "id": "279229926",
            "selection": {
              "anchor": {
                "offset": 0,
                "path": [
                  0,
                  0
                ]
              },
              "focus": {
                "offset": 0,
                "path": [
                  1,
                  0
                ]
              }
            },
            "type": "content"
          }
        ],
        "id": "1309919953",
        "layout": "vertical",
        "purpose": "example",
        "type": "group"
      },
      {
        "children": [
          {
            "children": [
              {
                "text": "To further illustrate the relation between these two essential thermodynamic concepts, consider the observation that reactions spontaneously proceed in a direction that ultimately establishes equilibrium. As may be shown by plotting the free energy change versus the extent of the reaction (for example, as reflected in the value of "
              },
              {
                "em": true,
                "text": "Q"
              },
              {
                "text": "), equilibrium is established when the system’s free energy is minimized. If a system is present with reactants and products present in nonequilibrium amounts ("
              },
              {
                "em": true,
                "text": "Q"
              },
              {
                "text": " ≠ "
              },
              {
                "em": true,
                "text": "K"
              },
              {
                "text": "), the reaction will proceed spontaneously in the direction necessary to establish equilibrium."
              }
            ],
            "id": "2b821nfibe2oimo",
            "type": "p"
          },
          {
            "children": [
              {
                "id": "1sfg5o8flp4h1hd",
                "text": " ",
                "type": "text"
              }
            ],
            "id": "9qafv3jyomk53yx",
            "src": "https://d2xvti2irp4c7t.cloudfront.net/media/a2/a2b56c331ca2bd06e31adfff6ff238cf/equil_free_energy.jpg",
            "type": "img",
            "width": "700"
          }
        ],
