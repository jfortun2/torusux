                    "type": "text"
                  }
                ],
                "id": "71n7xd30qjyxqxr",
                "legacyBlockRendered": "true",
                "src": "{\\mathrm{SbCl}}_5(g)\\;\\;\\rightleftharpoons\\;\\;{\\mathrm{SbCl}}_3(g)\\;+\\;{\\mathrm{Cl}}_2(g)",
                "subtype": "latex",
                "type": "formula"
              },
              {
                "children": [
